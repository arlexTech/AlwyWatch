    callback admin-open();
    callback admin-invite();
    in property <[StatusRow]> admin-status;
    in property <bool> admin-dry-run;
    in property <string> admin-status-message;
    in property <string> invite-made-code;
    in property <string> invite-made-link;
    in property <string> invite-made-message;
    in property <string> invite-made-hint;
