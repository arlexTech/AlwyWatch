    callback account-login(string, string, string); // AlwyWatch server address, username, password
    callback send-start();
    callback send-lookup(string);
    callback send-confirm();
    callback send-cancel();
    callback keep-connect(string);
    /// "Sign out of AlwyWatch": the account and the server, for this profile (its logins stay).
    callback alwywatch-sign-out();
    /// "Connect to AlwyWatch" (a profile without it): sign in (false) or create an account.
    callback alwy-connect(bool);
    /// Settings → Account: the AlwyWatch server's address and "" | ok | offline | expired.
    in property <string> alwy-address;
    in property <string> alwy-state;
