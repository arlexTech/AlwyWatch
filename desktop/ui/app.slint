// SPDX-License-Identifier: AGPL-3.0-or-later
// AlwyWatch desktop UI. Same design language as the Android app: Manrope, near-black with
// translucent surfaces, artwork-led pages, white pill for the main action.
import { ListView, ScrollView } from "std-widgets.slint";
import "fonts/Manrope.ttf";

export struct Card {
    id: string,
    title: string,
    subtitle: string,
    image: image,
    progress: float,
    played: bool,
    server: string, // "plex" | "jellyfin" where a screen mixes servers, else empty
}

export struct Rail {
    title: string,
    items: [Card],
    landscape: bool,
}

export struct ServerChoice {
    id: string,
    title: string,
    subtitle: string,
    plex: bool,
}

export struct NamedId {
    id: string,
    title: string,
    selected: bool,
}

export struct Detail {
    id: string,
    title: string,
    meta: string,
    overview: string,
    genres: string,
    backdrop: image,
    poster: image,
    logo: image,
    playable: bool,
    resumable: bool,
    /// Where Resume starts, e.g. "9:12".
    resume-at: string,
    played: bool,
    is-series: bool,
    /// Movies and shows can go on "My list" (Plex watchlist, Jellyfin favorites).
    can-watchlist: bool,
    watchlisted: bool,
    has-trailer: bool,
    /// "Directed by …".
    crew: string,
}

export struct AccountRow {
    id: string,
    label: string,
    detail: string,
    current: bool,
}

export struct DownloadRow {
    id: int,
    account: string,
    item: string,
    title: string,
    status: string,
    progress: float,
    completed: bool,
    active: bool,
}

export struct SeerrPanel {
    open: bool,
    key: string,
    title: string,
    overview: string,
    status: string,
    is-tv: bool,
    can-request: bool,
}

// A Seerr title page (or a saga's header).
export struct SeerrPage {
    key: string,
    title: string,
    meta: string,
    tagline: string,
    overview: string,
    genres: string,
    status: string,
    available: bool,
    saga-id: string,
    saga-name: string,
    backdrop: image,
    poster: image,
}

export struct LeavingRow {
    key: string,
    title: string,
    when: string,
    vote: string,
    others: string,
    poster: image,
    urgent: bool,
    voted: bool,
}

export struct TogetherRow {
    code: string,
    title: string,
    people: string,
    status: string,
    poster: image,
    mine: bool,
}

export struct ForeverRow {
    title: string,
    detail: string,
    // Share of this person's titles that someone else keeps too (0..1); -1 for titles.
    shared: float,
}

export struct AdminRow {
    key: string,
    name: string,
    detail: string,
    forever: string,
    max-forever: string,
    max-days: string,
}

export enum Page { add, home, library, detail, search, mylist, settings, downloads, requests, seerrtitle, seerrsaga, leaving, triage, keepadmin, together }

export global Palette {
    out property <color> bg: #09090c;
    out property <color> surface: #ffffff14;
    out property <color> surface-high: #ffffff24;
    out property <color> outline: #ffffff1f;
    out property <color> accent: #ffb224;
    out property <color> text: #f4f4f6;
    out property <color> muted: #f4f4f699;
    out property <color> subtle: #f4f4f666;
    out property <color> danger: #ff5a5f;
    out property <color> success: #3ddc97;
}

component Icon inherits Image {
    in property <color> tint: Palette.text;
    width: 22px;
    height: 22px;
    colorize: root.tint;
    image-fit: contain;
}

// A focusable, clickable surface: Enter/Space activate; focus and hover are always visible.
component Focusable inherits Rectangle {
    in property <bool> primary: false;
    out property <bool> active: fs.has-focus || ta.has-hover;
    callback clicked();
    callback focused();
    border-radius: 14px;
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-changed-event => { if (self.has-focus) { root.focused(); } }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            fs.focus();
            root.clicked();
        }
        changed has-hover => { if (self.has-hover) { root.focused(); } }
    }
    @children
}

// Pill button: primary = white with black text; secondary = glass. Focus/hover turn it white.
component Button inherits Focusable {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon: false;
    property <bool> light: root.primary || root.active;
    height: 40px;
    min-width: row.preferred-width + 36px;
    border-radius: 20px;
    background: root.light ? (root.primary && root.active ? #e6e6e6 : #ffffff) : Palette.surface-high;
    animate background { duration: 120ms; }
    row := HorizontalLayout {
        alignment: center;
        spacing: 8px;
        if root.has-icon : Icon { source: root.icon; tint: root.light ? #000 : Palette.text; width: 20px; height: 20px; y: (parent.height - self.height) / 2; }
        Text {
            text: root.label;
            color: root.light ? #000 : Palette.text;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

/** Big clickable card for the sign-in choices. */
component ChoiceCard inherits Focusable {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;
    min-height: 76px;
    border-radius: 20px;
    background: self.active ? Palette.surface-high : Palette.surface;
    border-width: 1px;
    border-color: Palette.outline;
    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        Rectangle {
            width: 44px;
            height: 44px;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: Palette.surface-high;
            Icon { source: root.icon; tint: Palette.accent; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.title; color: Palette.text; font-size: 17px; font-weight: 700; }
            Text { text: root.subtitle; color: Palette.muted; font-size: 13px; wrap: word-wrap; }
        }
        Icon { source: @image-url("icons/chevron_right.svg"); tint: Palette.subtle; y: (parent.height - self.height) / 2; }
    }
}

component IconButton inherits Focusable {
    in property <image> icon;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: root.active ? #ffffff : Palette.surface-high;
    Icon { source: root.icon; tint: root.active ? #000 : Palette.text; }
}

// Cast and crew: round photos with name and role, scrolling sideways.
component CastRow inherits ScrollView {
    in property <[Card]> people;
    height: 150px;
    content-width: root.people.length * 104px;
    for c[i] in root.people : VerticalLayout {
        x: i * 104px;
        width: 92px;
        spacing: 4px;
        Rectangle {
            width: 76px;
            height: 76px;
            border-radius: 38px;
            clip: true;
            background: Palette.surface;
            Image { source: c.image; width: parent.width; height: parent.height; image-fit: cover; }
        }
        Text { text: c.title; color: Palette.text; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; max-height: 32px; overflow: elide; }
        Text { text: c.subtitle; color: Palette.muted; font-size: 11px; horizontal-alignment: center; overflow: elide; }
    }
}

component NavItem inherits Focusable {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    height: 44px;
    border-radius: 22px;
    background: root.active ? #ffffff : (root.selected ? Palette.surface-high : transparent);
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 14px;
        Icon {
            source: root.icon;
            tint: root.active ? #000 : (root.selected ? Palette.text : Palette.muted);
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.label;
            color: root.active ? #000 : (root.selected ? Palette.text : Palette.muted);
            font-size: 15px;
            font-weight: root.selected ? 700 : 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 2px;
    Text { text: root.title; color: Palette.text; font-size: 34px; font-weight: 800; letter-spacing: -0.5px; }
    if root.subtitle != "" : Text { text: root.subtitle; color: Palette.muted; font-size: 15px; }
}

// Rounded text field (bare TextInput: no inner widget box).
component Field inherits Rectangle {
    in-out property <string> text <=> ti.text;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    /// Takes the keyboard when it appears (the search page: type at once).
    in property <bool> autofocus;
    callback accepted(string);
    callback edited(string);
    init => { if root.autofocus { ti.focus(); } }
    height: 48px;
    border-radius: 24px;
    background: Palette.surface;
    border-width: ti.has-focus ? 2px : 1px;
    border-color: ti.has-focus ? #ffffff : Palette.outline;
    TouchArea { mouse-cursor: MouseCursor.text; clicked => { ti.focus(); } }
    if ti.text == "" : Text {
        x: 20px;
        text: root.placeholder;
        color: Palette.subtle;
        font-size: 15px;
        vertical-alignment: center;
    }
    ti := TextInput {
        x: 20px;
        width: parent.width - 40px;
        color: Palette.text;
        font-size: 15px;
        vertical-alignment: center;
        single-line: true;
        input-type: root.input-type;
        selection-background-color: #ffb22466;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
    }
}

component Badge inherits Rectangle {
    in property <string> label;
    in property <color> tone: #000000a0;
    in property <color> fg: #ffffff;
    height: 22px;
    width: t.preferred-width + 14px;
    border-radius: 6px;
    background: root.tone;
    t := Text { text: root.label; color: root.fg; font-size: 11px; font-weight: 800; letter-spacing: 0.6px; }
}

component Progress inherits Rectangle {
    in property <float> value;
    height: 4px;
    border-radius: 2px;
    background: #ffffff40;
    Rectangle { x: 0; width: parent.width * root.value; border-radius: 2px; background: Palette.accent; }
}

// Which server a card is from: a chevron in Plex's yellow, a triangle in Jellyfin's purple to
// blue (simple shapes, not the brands' logo files; same marks as Android).
component ServerMark inherits Rectangle {
    in property <string> server;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: #000000b8;
    if root.server == "plex" : Path {
        x: 5px; y: 5px; width: 12px; height: 12px;
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 22 0 L 52 0 L 86 50 L 52 100 L 22 100 L 56 50 Z";
        fill: #e5a00d;
    }
    if root.server == "jellyfin" : Path {
        x: 5px; y: 5px; width: 12px; height: 12px;
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 50 0 L 100 100 L 0 100 Z M 50 42 L 28 86 L 72 86 Z";
        fill: @linear-gradient(135deg, #aa5cc3 0%, #00a4dc 100%);
    }
}

component PosterCard inherits Focusable {
    in property <Card> card;
    width: 160px;
    height: 292px;
    background: transparent;
    VerticalLayout {
        spacing: 8px;
        Rectangle {
            height: 240px;
            border-radius: 14px;
            clip: true;
            background: Palette.surface;
            border-width: root.active ? 3px : 0px;
            border-color: #ffffff;
            Image { source: root.card.image; width: parent.width; height: parent.height; image-fit: cover; }
            if root.card.progress > 0 : Progress { x: 8px; y: parent.height - 12px; width: parent.width - 16px; value: root.card.progress; }
            if root.card.played : Rectangle {
                x: parent.width - 30px;
                y: 8px;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: #000000a0;
                Icon { source: @image-url("icons/check.svg"); tint: Palette.accent; width: 15px; height: 15px; }
            }
            if root.card.server != "" : ServerMark { x: 8px; y: 8px; server: root.card.server; }
        }
        Text { text: root.card.title; color: Palette.text; overflow: elide; font-size: 14px; font-weight: 700; }
        Text { text: root.card.subtitle; color: Palette.muted; overflow: elide; font-size: 12px; }
    }
}

// 16:9 card for "Continue watching": still, title, time, progress.
component LandscapeCard inherits Focusable {
    in property <Card> card;
    width: 300px;
    height: 169px;
    clip: true;
    background: Palette.surface;
    border-width: root.active ? 3px : 0px;
    border-color: #ffffff;
    Image { source: root.card.image; width: parent.width; height: parent.height; image-fit: cover; }
    Rectangle { background: @linear-gradient(180deg, #00000000 45%, #000000c0 100%); }
    if root.card.server != "" : ServerMark { x: 8px; y: 8px; server: root.card.server; }
    VerticalLayout {
        padding: 12px;
        spacing: 2px;
        alignment: end;
        Text { text: root.card.title; color: Palette.text; overflow: elide; font-size: 15px; font-weight: 700; }
        Text { text: root.card.subtitle; color: Palette.muted; overflow: elide; font-size: 12px; }
        if root.card.progress > 0 : Rectangle { height: 8px; }
        if root.card.progress > 0 : Progress { value: root.card.progress; }
    }
}

component RailView {
    in property <Rail> rail;
    property <length> step: root.rail.landscape ? 316px : 176px;
    property <length> h: root.rail.landscape ? 181px : 304px;
    callback open(string);
    callback hovered(string);
    VerticalLayout {
        spacing: 10px;
        Text { text: root.rail.title; color: Palette.text; font-size: 20px; font-weight: 700; }
        sv := ScrollView {
            height: root.h + 8px;
            content-width: root.rail.items.length * root.step + 12px;
            content-height: root.h + 4px;
            vertical-scrollbar-policy: always-off;
            for c[i] in root.rail.items : Rectangle {
                x: i * root.step + 4px;
                y: 4px;
                width: root.step - 16px;
                height: root.h;
                if root.rail.landscape : LandscapeCard {
                    card: c;
                    clicked => { root.open(c.id); }
                    focused => {
                        if (parent.x + sv.content-x < 0) { sv.content-x = -parent.x + 4px; }
                        if (parent.x + parent.width + sv.content-x > sv.visible-width) { sv.content-x = sv.visible-width - parent.x - parent.width - 4px; }
                        root.hovered(c.id);
                    }
                }
                if !root.rail.landscape : PosterCard {
                    card: c;
                    clicked => { root.open(c.id); }
                    focused => {
                        if (parent.x + sv.content-x < 0) { sv.content-x = -parent.x + 4px; }
                        if (parent.x + parent.width + sv.content-x > sv.visible-width) { sv.content-x = sv.visible-width - parent.x - parent.width - 4px; }
                        root.hovered(c.id);
                    }
                }
            }
        }
    }
}

// Grouped settings card.
component Group inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    if root.title != "" : Text { text: root.title; color: Palette.subtle; font-size: 11px; font-weight: 800; letter-spacing: 1px; }
    Rectangle {
        border-radius: 18px;
        background: Palette.surface;
        border-width: 1px;
        border-color: Palette.outline;
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            @children
        }
    }
}

/// A labelled on/off switch row (settings).
component SettingToggle inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> on;
    callback clicked();
    VerticalLayout {
        alignment: center;
        Text { text: root.title; color: Palette.text; font-weight: 700; }
        Text { text: root.subtitle; color: Palette.muted; font-size: 12px; }
    }
    Rectangle { horizontal-stretch: 1; }
    Focusable {
        width: 48px;
        height: 28px;
        border-radius: 14px;
        background: root.on ? Palette.accent : Palette.surface-high;
        y: (parent.height - self.height) / 2;
        clicked => { root.clicked(); }
        Rectangle {
            x: root.on ? parent.width - 24px : 4px;
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: #ffffff;
            animate x { duration: 150ms; }
        }
    }
}

export component AppWindow inherits Window {
    title: "AlwyWatch";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Palette.bg;
    default-font-size: 15px;
    default-font-family: "Manrope";

    in-out property <Page> page: Page.home;
    in property <string> status;
    in property <string> error;
    in property <bool> can-go-back;
    // Home
    in property <[Rail]> rails;
    in property <[NamedId]> libraries;
    in property <Detail> hero;
    // Library / search grid
    in property <string> grid-title;
    in property <[Card]> grid;
    in property <[NamedId]> sorts;
    in property <string> library-id;
    // Library page tab: recommended | browse | collections | categories; empty on a genre or
    // collection page.
    in property <string> library-tab;
    in property <[Rail]> lib-rails;
    in property <[NamedId]> genres;
    // Detail
    in property <Detail> detail;
    in property <[NamedId]> seasons;
    in property <[Card]> episodes;
    // Add server
    in property <string> add-step: "choose"; // choose | jellyfin-url | jellyfin | plex | plex-servers | receive
    // Device transfer. New device: the code to type elsewhere and the check number.
    in-out property <string> keep-address; // typed at the AlwyWatch server step
    in property <string> transfer-code;
    in property <string> transfer-check;
    in property <string> transfer-status;
    // Signed-in device, "Add a device": "" | code | confirm | sent.
    in property <string> send-step;
    in property <string> send-code;
    in property <string> send-device;
    in property <string> send-check;
    in property <string> send-error;
    in property <string> quick-code;
    in property <string> plex-code;
    in property <[NamedId]> plex-servers;
    // Settings
    in property <[AccountRow]> accounts;
    in property <string> cache-size;
    in property <string> about;
    in-out property <bool> spdif;
    in property <bool> auto-skip-intro;
    in property <bool> auto-next: true;
    in-out property <string> search-text;
    in property <[DownloadRow]> downloads;
    // Seerr
    in property <bool> seerr-active;
    in property <string> seerr-label;
    in property <string> seerr-step: "url"; // url | choose | plex | jellyfin | local
    in property <[NamedId]> seerr-logins;
    in property <string> seerr-code;
    in property <string> seerr-message;
    in property <[Card]> seerr-results;
    in property <[Card]> seerr-mine;
    in property <SeerrPanel> seerr-panel;
    in property <[NamedId]> seerr-seasons;
    in property <SeerrPage> seerr-title;
    in property <[Card]> seerr-cast;
    /// Cast of the title page.
    in property <[Card]> cast;
    in property <SeerrPage> seerr-saga;
    in property <[Card]> seerr-parts;
    // Keep service
    in property <bool> keep-active;
    in property <bool> keep-admin;
    in property <string> keep-label;
    in property <string> keep-message;
    in property <[LeavingRow]> leaving;
    in property <[TogetherRow]> together-rooms;
    in property <string> together-status;
    // Join dialog: shown while join-message is set; join-done swaps Cancel for Close.
    in property <string> join-title;
    in property <string> join-message;
    in property <bool> join-done;
    in-out property <string> leaving-open;
    in property <LeavingRow> triage-card;
    in property <int> triage-left;
    in property <[AdminRow]> admin-users;
    in property <[NamedId]> admin-collections;
    in property <string> forever-summary;
    in property <[ForeverRow]> forever-people;
    in property <[ForeverRow]> forever-titles;

    callback back();
    callback move-focus(bool);
    callback open-item(string);
    callback prefetch(string);
    callback open-library(string, string);
    callback set-sort(string);
    callback grid-scrolled(float);
    callback library-tab-chosen(string);
    callback open-genre(string, string); // id, name
    callback play(string, bool);
    callback toggle-played(string);
    callback toggle-watchlist(string);
    callback play-trailer(string);
    callback select-season(string);
    callback search(string);
    callback go(Page);
    callback add-choose(string);
    callback jellyfin-url(string);
    callback jellyfin-sign-in(string, string);
    callback plex-pick(string);
    callback add-keep-servers(string);
    callback add-keep-pick(string);
    in property <[ServerChoice]> preset-servers;
    /// Add page opened while connected to an AlwyWatch server: its list comes first.
    in property <bool> add-from-keep;
    callback use-account(string);
    callback remove-account(string);
    callback clear-cache();
    callback toggle-spdif();
    /// Flips a boolean setting ("1"/"0") and refreshes the switches.
    callback toggle-setting(string);
    callback download(string);
    callback download-action(int, string); // pause | resume | remove
    callback play-download(string, string); // account, item
    callback seerr-url(string);
    callback seerr-login(string);
    callback seerr-password(string, string);
    callback seerr-disconnect();
    callback seerr-bridge(); // Seerr through the AlwyWatch server
    callback seerr-search(string);
    callback seerr-open(string);
    callback seerr-toggle-season(string);
    callback seerr-request(bool); // all seasons?
    callback seerr-open-saga();
    callback transfer-receive(string); // AlwyWatch server address
    callback send-start();
    callback send-lookup(string);
    callback send-confirm();
    callback send-cancel();
    callback keep-connect(string);
    /// Accounts that can sync with the AlwyWatch server (selected = the one syncing).
    in property <[NamedId]> keep-choices;
    in property <bool> keep-can-switch;
    callback keep-sync(string);
    callback keep-choose();
    callback keep-disconnect();
    callback keep-vote(string, string); // key, choice
    callback watch-together(string); // item: play it in a new room
    callback together-join(string); // room code
    callback together-cancel();
    callback leaving-scrolled(int); // first visible row, to load the posters around it
    callback triage-vote(string);       // choice
    callback admin-rights(string, string); // user key, field
    callback admin-countdown(string, int); // collection id, stagger days

    // Arrow keys and Escape not consumed by a focused element end up here.
    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape || (e.text == Key.Backspace && !e.modifiers.control)) {
                if (root.can-go-back) { root.back(); return accept; }
            }
            if (e.text == Key.RightArrow || e.text == Key.DownArrow) { root.move-focus(true); return accept; }
            if (e.text == Key.LeftArrow || e.text == Key.UpArrow) { root.move-focus(false); return accept; }
            return reject;
        }

        HorizontalLayout {
            // ----- Sidebar ----------------------------------------------------------------
            if root.page != Page.add : Rectangle {
                width: 232px;
                background: #ffffff08;
                Rectangle { x: parent.width - 1px; width: 1px; background: Palette.outline; }
                VerticalLayout {
                    padding: 16px;
                    padding-top: 24px;
                    spacing: 4px;
                    alignment: start;
                    Text {
                        text: "AlwyWatch";
                        color: Palette.text;
                        font-size: 24px;
                        font-weight: 800;
                        letter-spacing: -0.5px;
                    }
                    Rectangle { height: 22px; }
                    NavItem { label: "Home"; icon: @image-url("icons/home.svg"); selected: root.page == Page.home; clicked => { root.go(Page.home); } }
                    NavItem { label: "Search"; icon: @image-url("icons/search.svg"); selected: root.page == Page.search; clicked => { root.go(Page.search); } }
                    NavItem { label: "My list"; icon: @image-url("icons/bookmark.svg"); selected: root.page == Page.mylist; clicked => { root.go(Page.mylist); } }
                    for lib in root.libraries : NavItem {
                        label: lib.title;
                        icon: @image-url("icons/movie.svg");
                        selected: root.page == Page.library && root.library-id == lib.id;
                        clicked => { root.open-library(lib.id, lib.title); }
                    }
                    if root.keep-active : NavItem {
                        label: "Leaving soon";
                        icon: @image-url("icons/hourglass_bottom.svg");
                        selected: root.page == Page.leaving || root.page == Page.triage || root.page == Page.keepadmin;
                        clicked => { root.go(Page.leaving); }
                    }
                    if root.keep-active : NavItem {
                        label: "Together";
                        icon: @image-url("icons/group.svg");
                        selected: root.page == Page.together;
                        clicked => { root.go(Page.together); }
                    }
                    if root.seerr-active : NavItem { label: "Requests"; icon: @image-url("icons/add.svg"); selected: root.page == Page.requests || root.page == Page.seerrtitle || root.page == Page.seerrsaga; clicked => { root.go(Page.requests); } }
                    NavItem { label: "Downloads"; icon: @image-url("icons/download.svg"); selected: root.page == Page.downloads; clicked => { root.go(Page.downloads); } }
                    NavItem { label: "Settings"; icon: @image-url("icons/settings.svg"); selected: root.page == Page.settings; clicked => { root.go(Page.settings); } }
                }
            }

            // ----- Content ----------------------------------------------------------------
            Rectangle {
                horizontal-stretch: 1;
                clip: true;

                VerticalLayout {
                    if root.keep-message != "" : Rectangle {
                        height: 40px;
                        background: #ffb2241f;
                        Text { text: root.keep-message; color: Palette.accent; font-weight: 600; }
                    }
                    if root.error != "" : Rectangle {
                        height: 40px;
                        background: Palette.surface;
                        Text { text: root.error; color: Palette.muted; }
                    }

                    // Home: artwork hero that follows the hovered/focused card, then rails.
                    if root.page == Page.home : ScrollView {
                        VerticalLayout {
                            spacing: 18px;
                            Rectangle {
                                height: 460px;
                                clip: true;
                                Image { source: root.hero.backdrop; width: parent.width; height: parent.height; image-fit: cover; }
                                Rectangle { background: @linear-gradient(90deg, #09090cf5 0%, #09090cb0 35%, #09090c00 70%); }
                                Rectangle { background: @linear-gradient(180deg, #09090c00 50%, #09090c 100%); }
                                VerticalLayout {
                                    x: 40px;
                                    width: min(560px, parent.width - 80px);
                                    padding-bottom: 36px;
                                    spacing: 12px;
                                    alignment: end;
                                    if root.hero.logo.width > 0 : Image {
                                        source: root.hero.logo;
                                        height: 110px;
                                        width: min(380px, self.height * root.hero.logo.width / max(1, root.hero.logo.height) * 1px / 1px);
                                        image-fit: contain;
                                        horizontal-alignment: left;
                                    }
                                    if root.hero.logo.width == 0 : Text {
                                        text: root.hero.title;
                                        color: Palette.text;
                                        font-size: 44px;
                                        font-weight: 800;
                                        letter-spacing: -1px;
                                        wrap: word-wrap;
                                    }
                                    Text { text: root.hero.meta; color: Palette.muted; font-size: 15px; overflow: elide; }
                                    Text { text: root.hero.overview; color: Palette.muted; font-size: 14px; wrap: word-wrap; max-height: 60px; overflow: elide; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        if root.hero.playable : Button {
                                            label: root.hero.resumable ? "Resume" : "Play";
                                            primary: true;
                                            has-icon: true;
                                            icon: @image-url("icons/play_arrow_fill1.svg");
                                            clicked => { root.play(root.hero.id, false); }
                                        }
                                        if root.hero.id != "" : Button {
                                            label: "Details";
                                            has-icon: true;
                                            icon: @image-url("icons/info.svg");
                                            clicked => { root.open-item(root.hero.id); }
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                padding-left: 40px;
                                padding-right: 24px;
                                padding-bottom: 32px;
                                spacing: 22px;
                                for rail in root.rails : RailView {
                                    rail: rail;
                                    open(id) => { root.open-item(id); }
                                    hovered(id) => { root.prefetch(id); }
                                }
                                if root.rails.length == 0 : Text { text: root.status; color: Palette.muted; }
                            }
                        }
                    }

                    if root.page == Page.library || root.page == Page.search || root.page == Page.mylist : VerticalLayout {
                        padding-left: 40px;
                        padding-right: 24px;
                        padding-top: 28px;
                        spacing: 18px;
                        if root.page == Page.library : HorizontalLayout {
                            spacing: 10px;
                            PageTitle { title: root.grid-title; }
                            Rectangle { horizontal-stretch: 1; }
                            if root.library-tab == "browse" || root.library-tab == "" : HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                for s in root.sorts : Button {
                                    label: s.title;
                                    primary: s.selected;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.set-sort(s.id); }
                                }
                            }
                        }
                        if root.page == Page.library && root.library-tab != "" : HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            for t in [
                                { id: "recommended", title: "Recommended" },
                                { id: "browse", title: "Browse" },
                                { id: "collections", title: "Collections" },
                                { id: "categories", title: "Categories" },
                            ] : Button {
                                label: t.title;
                                primary: root.library-tab == t.id;
                                clicked => { root.library-tab-chosen(t.id); }
                            }
                        }
                        if root.page == Page.library && root.library-tab == "recommended" : ScrollView {
                            VerticalLayout {
                                spacing: 22px;
                                padding-bottom: 32px;
                                alignment: start;
                                for rail in root.lib-rails : RailView {
                                    rail: rail;
                                    open(id) => { root.open-item(id); }
                                    hovered(id) => { root.prefetch(id); }
                                }
                                if root.lib-rails.length == 0 : Text { text: "Nothing in progress or recently added."; color: Palette.muted; }
                            }
                        }
                        if root.page == Page.library && root.library-tab == "categories" : ScrollView {
                            property <int> gcols: max(1, floor((self.visible-width - 10px) / 236px));
                            content-height: ceil(root.genres.length / self.gcols) * 60px + 20px;
                            for g[i] in root.genres : Button {
                                x: mod(i, parent.gcols) * 236px + 4px;
                                y: floor(i / parent.gcols) * 60px + 4px;
                                width: 224px;
                                label: g.title;
                                clicked => { root.open-genre(g.id, g.title); }
                            }
                        }
                        if root.page == Page.library && root.library-tab == "collections" && root.grid.length == 0 : Text {
                            text: root.status;
                            color: Palette.muted;
                        }
                        if root.page == Page.mylist : PageTitle { title: "My list"; }
                        if root.page == Page.mylist && root.grid.length == 0 : Text { text: root.status; color: Palette.muted; wrap: word-wrap; }
                        if root.page == Page.search : VerticalLayout {
                            spacing: 14px;
                            // Its own height only: the results grid below takes the rest.
                            vertical-stretch: 0;
                            PageTitle { title: "Search"; }
                            Field {
                                autofocus: true;
                                placeholder: "Movies, shows, episodes…";
                                text <=> root.search-text;
                                edited(t) => { root.search(t); }
                            }
                        }
                        if root.page == Page.search || root.page == Page.mylist || root.library-tab == "browse" || root.library-tab == "collections" || root.library-tab == "" : grid := ScrollView {
                            property <int> cols: max(1, floor((self.visible-width - 10px) / 176px));
                            content-height: ceil(root.grid.length / self.cols) * 312px + 20px;
                            scrolled => {
                                root.grid-scrolled(-self.content-y / max(1px, self.content-height - self.visible-height));
                            }
                            for c[i] in root.grid : PosterCard {
                                x: mod(i, grid.cols) * 176px + 4px;
                                y: floor(i / grid.cols) * 312px + 4px;
                                card: c;
                                clicked => { root.open-item(c.id); }
                                focused => { root.prefetch(c.id); }
                            }
                        }
                    }

                    if root.page == Page.detail : ScrollView {
                        VerticalLayout {
                            spacing: 18px;
                            Rectangle {
                                height: 520px;
                                clip: true;
                                Image { source: root.detail.backdrop; width: parent.width; height: parent.height; image-fit: cover; }
                                Rectangle { background: @linear-gradient(90deg, #09090cf0 0%, #09090c90 40%, #09090c00 75%); }
                                Rectangle { background: @linear-gradient(180deg, #09090c80 0%, #09090c00 18%, #09090c00 55%, #09090c 100%); }
                                if root.can-go-back : IconButton {
                                    x: 24px;
                                    y: 20px;
                                    icon: @image-url("icons/arrow_back.svg");
                                    clicked => { root.back(); }
                                }
                                VerticalLayout {
                                    x: 40px;
                                    width: min(620px, parent.width - 80px);
                                    padding-bottom: 32px;
                                    spacing: 12px;
                                    alignment: end;
                                    if root.detail.logo.width > 0 : Image {
                                        source: root.detail.logo;
                                        height: 120px;
                                        image-fit: contain;
                                        horizontal-alignment: left;
                                    }
                                    if root.detail.logo.width == 0 : Text {
                                        text: root.detail.title;
                                        color: Palette.text;
                                        font-size: 46px;
                                        font-weight: 800;
                                        letter-spacing: -1px;
                                        wrap: word-wrap;
                                    }
                                    Text { text: root.detail.meta; color: Palette.muted; font-size: 15px; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        if root.detail.playable : Button {
                                            label: root.detail.resumable ? "Resume from " + root.detail.resume-at : "Play";
                                            primary: true;
                                            has-icon: true;
                                            icon: @image-url("icons/play_arrow_fill1.svg");
                                            clicked => { root.play(root.detail.id, false); }
                                        }
                                        if root.detail.resumable : Button {
                                            label: "From start";
                                            clicked => { root.play(root.detail.id, true); }
                                        }
                                        if root.detail.playable && root.keep-active : Button {
                                            label: "Watch together";
                                            has-icon: true;
                                            icon: @image-url("icons/group.svg");
                                            clicked => { root.watch-together(root.detail.id); }
                                        }
                                        if root.detail.has-trailer : IconButton {
                                            icon: @image-url("icons/movie.svg");
                                            clicked => { root.play-trailer(root.detail.id); }
                                        }
                                        if root.detail.can-watchlist : IconButton {
                                            icon: root.detail.watchlisted ? @image-url("icons/bookmark_fill1.svg") : @image-url("icons/bookmark.svg");
                                            clicked => { root.toggle-watchlist(root.detail.id); }
                                        }
                                        if root.detail.playable : IconButton {
                                            icon: @image-url("icons/download.svg");
                                            clicked => { root.download(root.detail.id); }
                                        }
                                        IconButton {
                                            icon: @image-url("icons/check.svg");
                                            clicked => { root.toggle-played(root.detail.id); }
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                padding-left: 40px;
                                padding-right: 40px;
                                padding-bottom: 32px;
                                spacing: 14px;
                                Text { text: root.detail.overview; color: #f4f4f6d9; font-size: 16px; wrap: word-wrap; }
                                if root.detail.genres != "" : Text { text: root.detail.genres; color: Palette.subtle; }
                                if root.detail.crew != "" : Text { text: root.detail.crew; color: Palette.muted; }
                                if root.detail.is-series : Text { text: "Episodes"; color: Palette.text; font-size: 20px; font-weight: 700; }
                                if root.detail.is-series : HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    for s in root.seasons : Button {
                                        label: s.title;
                                        primary: s.selected;
                                        clicked => { root.select-season(s.id); }
                                    }
                                }
                                for ep in root.episodes : Focusable {
                                    height: 112px;
                                    background: self.active ? Palette.surface-high : transparent;
                                    clicked => { root.play(ep.id, false); }
                                    focused => { root.prefetch(ep.id); }
                                    HorizontalLayout {
                                        padding: 8px;
                                        spacing: 16px;
                                        Rectangle {
                                            width: 170px;
                                            border-radius: 10px;
                                            clip: true;
                                            background: Palette.surface;
                                            Image { source: ep.image; width: parent.width; height: parent.height; image-fit: cover; }
                                            if ep.progress > 0 : Progress { y: parent.height - 4px; width: parent.width; value: ep.progress; border-radius: 0; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            Text { text: ep.title; color: Palette.text; font-size: 16px; font-weight: 700; overflow: elide; }
                                            Text { text: ep.subtitle; color: Palette.muted; overflow: elide; wrap: word-wrap; font-size: 13px; }
                                        }
                                        if ep.played : Icon { source: @image-url("icons/check.svg"); tint: Palette.accent; y: (parent.height - self.height) / 2; }
                                    }
                                }
                                if root.cast.length > 0 : Text { text: "Cast"; color: Palette.text; font-size: 20px; font-weight: 700; }
                                if root.cast.length > 0 : CastRow { people: root.cast; }
                            }
                        }
                    }

                    if root.page == Page.add : Rectangle {
                        background: @radial-gradient(circle, #ffb2244d 0%, #09090c00 60%);
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                width: min(560px, root.width - 48px);
                                padding-top: 72px;
                                spacing: 16px;
                                alignment: start;
                                if root.add-step == "choose" && root.add-from-keep : Text { text: "Add a server"; color: Palette.text; font-size: 36px; font-weight: 800; }
                                if root.add-step == "choose" && root.add-from-keep && root.preset-servers.length > 0 : Text { text: "From your AlwyWatch server"; color: Palette.text; font-size: 17px; font-weight: 700; }
                                if root.add-step == "choose" && root.add-from-keep : VerticalLayout {
                                    spacing: 16px;
                                    for s in root.preset-servers : ChoiceCard {
                                        title: s.title;
                                        subtitle: s.subtitle;
                                        icon: s.plex ? @image-url("icons/play_arrow_fill1.svg") : @image-url("icons/video_library.svg");
                                        clicked => { root.add-keep-pick(s.id); }
                                    }
                                }
                                if root.add-step == "choose" && root.add-from-keep && root.preset-servers.length > 0 : Text { text: "Another server"; color: Palette.text; font-size: 17px; font-weight: 700; }
                                if root.add-step == "choose" && root.add-from-keep : ChoiceCard {
                                    title: "Jellyfin";
                                    subtitle: "Quick Connect or password";
                                    icon: @image-url("icons/video_library.svg");
                                    clicked => { root.add-choose("jellyfin"); }
                                }
                                if root.add-step == "choose" && root.add-from-keep : ChoiceCard {
                                    title: "Plex";
                                    subtitle: "Sign in on plex.tv";
                                    icon: @image-url("icons/play_arrow_fill1.svg");
                                    clicked => { root.add-choose("plex"); }
                                }
                                if root.add-step == "choose" && !root.add-from-keep : VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "AlwyWatch"; color: Palette.text; font-size: 56px; font-weight: 800; letter-spacing: -1.5px; }
                                    Text { text: "Your Jellyfin and Plex, fast and beautiful."; color: Palette.muted; font-size: 17px; }
                                    Rectangle { height: 16px; }
                                }
                                if root.add-step != "choose" : HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    IconButton { icon: @image-url("icons/arrow_back.svg"); clicked => { root.add-choose("back"); } }
                                    Text {
                                        text: root.add-step == "alwywatch" ? "AlwyWatch server"
                                            : root.add-step == "receive" ? "Copy from another device"
                                            : root.add-step == "direct" ? "Sign in"
                                            : root.add-step == "plex" || root.add-step == "plex-servers" ? "Plex" : "Jellyfin";
                                        color: Palette.text;
                                        font-size: 28px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }
                                if root.add-step == "choose" && !root.add-from-keep : Text { text: "How do you watch?"; color: Palette.text; font-size: 17px; font-weight: 700; }
                                if root.add-step == "choose" && !root.add-from-keep : ChoiceCard {
                                    title: "I have an AlwyWatch server";
                                    subtitle: "Its address comes from your server's owner. Includes what's leaving soon and requests.";
                                    icon: @image-url("icons/hourglass_bottom.svg");
                                    clicked => { root.add-choose("alwywatch"); }
                                }
                                if root.add-step == "choose" && !root.add-from-keep : ChoiceCard {
                                    title: "I don't have one";
                                    subtitle: "Sign in to Jellyfin or Plex directly. You can add an AlwyWatch server later in Settings.";
                                    icon: @image-url("icons/person.svg");
                                    clicked => { root.add-choose("direct"); }
                                }
                                if root.add-step == "direct" : ChoiceCard {
                                    title: "Jellyfin";
                                    subtitle: "Quick Connect or password";
                                    icon: @image-url("icons/video_library.svg");
                                    clicked => { root.add-choose("jellyfin"); }
                                }
                                if root.add-step == "direct" : ChoiceCard {
                                    title: "Plex";
                                    subtitle: "Sign in on plex.tv";
                                    icon: @image-url("icons/play_arrow_fill1.svg");
                                    clicked => { root.add-choose("plex"); }
                                }
                                if root.add-step == "alwywatch" : VerticalLayout {
                                    spacing: 12px;
                                    Text { text: "Enter the address your server's owner gave you, then pick the server you watch on."; color: Palette.muted; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        kserver := Field { placeholder: "watch.example.org"; text <=> root.keep-address; accepted(t) => { root.add-keep-servers(t); } }
                                        Button { label: "Show servers"; primary: root.preset-servers.length == 0; y: (parent.height - self.height) / 2; clicked => { root.add-keep-servers(kserver.text); } }
                                    }
                                    for s in root.preset-servers : ChoiceCard {
                                        title: s.title;
                                        subtitle: s.subtitle;
                                        icon: s.plex ? @image-url("icons/play_arrow_fill1.svg") : @image-url("icons/video_library.svg");
                                        clicked => { root.add-keep-pick(s.id); }
                                    }
                                    if root.keep-address != "" : ChoiceCard {
                                        title: "Copy from another device";
                                        subtitle: "Signed in on your phone or TV? Bring its accounts and settings here.";
                                        icon: @image-url("icons/download.svg");
                                        clicked => { root.transfer-receive(root.keep-address); }
                                    }
                                }
                                if root.add-step == "receive" : VerticalLayout {
                                    spacing: 12px;
                                    Text { text: root.transfer-code; color: Palette.text; font-size: 56px; font-weight: 800; letter-spacing: 4px; }
                                    Text {
                                        text: "On a device where you're signed in: Settings → AlwyWatch server → Add a device, and type this code.";
                                        color: Palette.muted;
                                        wrap: word-wrap;
                                    }
                                    if root.transfer-check != "" : Text {
                                        text: "Check number: " + root.transfer-check + ". It must match the one shown on the other device.";
                                        color: Palette.muted;
                                        wrap: word-wrap;
                                    }
                                    Text { text: "Waiting for the other device…"; color: Palette.muted; font-size: 13px; }
                                    if root.transfer-status != "" : Text { text: root.transfer-status; color: Palette.danger; wrap: word-wrap; }
                                }
                                if root.add-step == "jellyfin-url" : VerticalLayout {
                                    spacing: 12px;
                                    url := Field {
                                        placeholder: "jellyfin.example.org";
                                        accepted(t) => { root.jellyfin-url(t); }
                                    }
                                    Text { text: "Your Jellyfin server's address, as you use it in a browser."; color: Palette.muted; }
                                    HorizontalLayout { alignment: start; Button { label: "Continue"; primary: true; clicked => { root.jellyfin-url(url.text); } } }
                                }
                                if root.add-step == "jellyfin" : VerticalLayout {
                                    spacing: 12px;
                                    if root.quick-code != "" : Rectangle {
                                        height: 190px;
                                        border-radius: 24px;
                                        background: Palette.surface;
                                        border-width: 1px;
                                        border-color: Palette.outline;
                                        VerticalLayout {
                                            padding: 24px;
                                            spacing: 8px;
                                            Text { text: "QUICK CONNECT"; color: Palette.accent; font-size: 11px; font-weight: 800; letter-spacing: 1px; }
                                            Text { text: root.quick-code; color: Palette.text; font-size: 54px; font-weight: 800; letter-spacing: 8px; }
                                            Text { text: "In a Jellyfin app where you're signed in, open your profile → Quick Connect and enter this code."; color: Palette.muted; wrap: word-wrap; }
                                        }
                                    }
                                    if root.quick-code != "" : Text { text: "Or with your password"; color: Palette.text; font-size: 17px; font-weight: 700; }
                                    user := Field { placeholder: "Username"; }
                                    pass := Field {
                                        placeholder: "Password";
                                        input-type: password;
                                        accepted => { root.jellyfin-sign-in(user.text, pass.text); }
                                    }
                                    HorizontalLayout { alignment: start; Button { label: "Sign in"; primary: true; clicked => { root.jellyfin-sign-in(user.text, pass.text); } } }
                                }
                                if root.add-step == "plex" : Rectangle {
                                    height: 170px;
                                    border-radius: 24px;
                                    background: Palette.surface;
                                    border-width: 1px;
                                    border-color: Palette.outline;
                                    VerticalLayout {
                                        padding: 24px;
                                        spacing: 8px;
                                        Text { text: "Finish signing in to Plex in your browser. You can also go to plex.tv/link and enter:"; color: Palette.muted; wrap: word-wrap; }
                                        Text { text: root.plex-code; color: Palette.text; font-size: 48px; font-weight: 800; letter-spacing: 6px; }
                                    }
                                }
                                if root.add-step == "plex-servers" : VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Choose a server"; color: Palette.text; font-size: 18px; font-weight: 700; }
                                    for s in root.plex-servers : HorizontalLayout {
                                        alignment: start;
                                        Button { label: s.title; clicked => { root.plex-pick(s.id); } }
                                    }
                                }
                                Text { text: root.status; color: Palette.danger; wrap: word-wrap; }
                            }
                        }
                    }

                    if root.page == Page.downloads : ScrollView {
                        VerticalLayout {
                            padding: 40px;
                            padding-top: 28px;
                            spacing: 12px;
                            alignment: start;
                            PageTitle { title: "Downloads"; subtitle: "Available offline"; }
                            if root.downloads.length == 0 : Text { text: "Nothing downloaded yet. Use the download button on a movie or an episode."; color: Palette.muted; }
                            for d in root.downloads : Rectangle {
                                background: Palette.surface;
                                border-radius: 18px;
                                height: 92px;
                                HorizontalLayout {
                                    padding: 16px;
                                    spacing: 14px;
                                    VerticalLayout {
                                        spacing: 6px;
                                        alignment: center;
                                        Text { text: d.title; color: Palette.text; font-size: 16px; font-weight: 700; overflow: elide; }
                                        Text { text: d.status; color: Palette.muted; font-size: 12px; }
                                        if !d.completed : Progress { value: d.progress; }
                                    }
                                    if d.completed : IconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/play_arrow_fill1.svg"); clicked => { root.play-download(d.account, d.item); } }
                                    if !d.completed && d.active : Button { y: (parent.height - self.height) / 2; label: "Pause"; clicked => { root.download-action(d.id, "pause"); } }
                                    if !d.completed && !d.active : Button { y: (parent.height - self.height) / 2; label: "Resume"; primary: true; clicked => { root.download-action(d.id, "resume"); } }
                                    IconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/delete.svg"); clicked => { root.download-action(d.id, "remove"); } }
                                }
                            }
                        }
                    }

                    if root.page == Page.requests : ScrollView {
                        VerticalLayout {
                            padding: 40px;
                            padding-top: 28px;
                            spacing: 14px;
                            alignment: start;
                            PageTitle { title: "Requests"; subtitle: "Ask for a movie or a show; it is added when ready."; }
                            Field {
                                placeholder: "Find a movie or a show…";
                                edited(t) => { root.seerr-search(t); }
                            }
                            if root.seerr-message != "" : Text { text: root.seerr-message; color: Palette.accent; }
                            results := Rectangle {
                                property <int> cols: max(1, floor((self.width - 10px) / 176px));
                                height: ceil(root.seerr-results.length / self.cols) * 312px;
                                for c[i] in root.seerr-results : PosterCard {
                                    x: mod(i, results.cols) * 176px;
                                    y: floor(i / results.cols) * 312px;
                                    card: c;
                                    clicked => { root.seerr-open(c.id); }
                                }
                            }
                            if root.seerr-results.length == 0 : Text { text: "My requests"; color: Palette.text; font-size: 20px; font-weight: 700; }
                            if root.seerr-results.length == 0 : mine := Rectangle {
                                property <int> cols: max(1, floor((self.width - 10px) / 176px));
                                height: ceil(root.seerr-mine.length / self.cols) * 312px;
                                for c[i] in root.seerr-mine : PosterCard {
                                    x: mod(i, mine.cols) * 176px;
                                    y: floor(i / mine.cols) * 312px;
                                    card: c;
                                    clicked => { root.seerr-open(c.id); }
                                }
                            }
                        }
                    }

                    // A title from Seerr: artwork, facts, request, saga, cast.
                    if root.page == Page.seerrtitle : ScrollView {
                        VerticalLayout {
                            spacing: 18px;
                            padding-bottom: 40px;
                            Rectangle {
                                height: 380px;
                                clip: true;
                                Image { source: root.seerr-title.backdrop; width: parent.width; height: parent.height; image-fit: cover; }
                                Rectangle { background: @linear-gradient(180deg, #09090c40 0%, #09090c00 30%, #09090c00 55%, #09090c 100%); }
                            }
                            HorizontalLayout {
                                padding-left: 40px;
                                padding-right: 40px;
                                spacing: 22px;
                                Rectangle {
                                    width: 150px;
                                    height: 225px;
                                    border-radius: 14px;
                                    clip: true;
                                    background: Palette.surface;
                                    Image { source: root.seerr-title.poster; width: parent.width; height: parent.height; image-fit: cover; }
                                }
                                VerticalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Text { text: root.seerr-title.title; color: Palette.text; font-size: 38px; font-weight: 800; letter-spacing: -0.5px; wrap: word-wrap; }
                                    Text { text: root.seerr-title.meta; color: Palette.muted; font-size: 15px; }
                                    if root.seerr-title.status != "" : HorizontalLayout {
                                        alignment: start;
                                        Badge {
                                            label: root.seerr-title.status;
                                            tone: root.seerr-title.available ? Palette.success : Palette.surface-high;
                                            fg: root.seerr-title.available ? #000000 : #ffffff;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        if root.seerr-panel.can-request : Button {
                                            label: root.seerr-panel.is-tv ? "Request all seasons" : "Request";
                                            primary: true;
                                            has-icon: true;
                                            icon: @image-url("icons/add.svg");
                                            clicked => { root.seerr-request(true); }
                                        }
                                        if root.seerr-panel.can-request && root.seerr-panel.is-tv : Button {
                                            label: "Request selected";
                                            clicked => { root.seerr-request(false); }
                                        }
                                    }
                                    if root.seerr-panel.can-request && root.seerr-panel.is-tv : HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        for s in root.seerr-seasons : Button {
                                            label: s.title;
                                            primary: s.selected;
                                            clicked => { root.seerr-toggle-season(s.id); }
                                        }
                                    }
                                    if root.seerr-message != "" : Text { text: root.seerr-message; color: Palette.accent; }
                                }
                            }
                            VerticalLayout {
                                padding-left: 40px;
                                padding-right: 40px;
                                spacing: 12px;
                                if root.seerr-title.tagline != "" : Text { text: root.seerr-title.tagline; color: Palette.text; font-size: 18px; font-weight: 700; wrap: word-wrap; }
                                if root.seerr-title.overview != "" : Text { text: root.seerr-title.overview; color: Palette.muted; font-size: 15px; wrap: word-wrap; }
                                if root.seerr-title.genres != "" : Text { text: root.seerr-title.genres; color: Palette.muted; font-size: 13px; }
                                if root.seerr-title.saga-id != "" : ChoiceCard {
                                    title: "PART OF THE SAGA";
                                    subtitle: root.seerr-title.saga-name;
                                    icon: @image-url("icons/movie.svg");
                                    clicked => { root.seerr-open-saga(); }
                                }
                                if root.seerr-cast.length > 0 : Text { text: "Cast"; color: Palette.text; font-size: 20px; font-weight: 700; }
                                if root.seerr-cast.length > 0 : CastRow { people: root.seerr-cast; }
                            }
                        }
                    }

                    // A saga: its films with their state; each opens its page.
                    if root.page == Page.seerrsaga : ScrollView {
                        VerticalLayout {
                            padding: 40px;
                            padding-top: 28px;
                            spacing: 14px;
                            alignment: start;
                            PageTitle { title: root.seerr-saga.title; subtitle: root.seerr-saga.meta; }
                            if root.seerr-saga.overview != "" : Text { text: root.seerr-saga.overview; color: Palette.muted; wrap: word-wrap; }
                            parts := Rectangle {
                                property <int> cols: max(1, floor((self.width - 10px) / 176px));
                                height: ceil(root.seerr-parts.length / self.cols) * 312px;
                                for c[i] in root.seerr-parts : PosterCard {
                                    x: mod(i, parts.cols) * 176px;
                                    y: floor(i / parts.cols) * 312px;
                                    card: c;
                                    clicked => { root.seerr-open(c.id); }
                                }
                            }
                        }
                    }

                    // A ListView, not a ScrollView: only the visible rows exist (the list can hold
                    // a thousand titles, past the software renderer's 16-bit coordinates).
                    if root.page == Page.leaving : VerticalLayout {
                        padding: 40px;
                        padding-top: 28px;
                        padding-bottom: 0;
                        spacing: 10px;
                        PageTitle { title: "Leaving soon"; subtitle: "What the server will delete, soonest first. Keep what you want to watch or love."; }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            padding-bottom: 8px;
                            Button { label: "Sort them out"; primary: true; has-icon: true; icon: @image-url("icons/favorite.svg"); clicked => { root.go(Page.triage); } }
                            if root.keep-admin : Button { label: "Admin"; has-icon: true; icon: @image-url("icons/settings.svg"); clicked => { root.go(Page.keepadmin); } }
                        }
                        ListView {
                            vertical-stretch: 1;
                            changed content-y => { root.leaving-scrolled(-self.content-y / 118px); }
                            for row in root.leaving : Rectangle {
                                height: (root.leaving-open == row.key ? 164px : 108px) + 10px;
                                Rectangle {
                                y: 0;
                                height: parent.height - 10px;
                                background: root.leaving-open == row.key ? Palette.surface-high : Palette.surface;
                                border-radius: 18px;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 10px;
                                    Focusable {
                                        height: 88px;
                                        clicked => { root.leaving-open = root.leaving-open == row.key ? "" : row.key; }
                                        HorizontalLayout {
                                            spacing: 14px;
                                            Rectangle {
                                                width: 58px;
                                                border-radius: 10px;
                                                clip: true;
                                                background: Palette.surface-high;
                                                Image { source: row.poster; width: parent.width; height: parent.height; image-fit: cover; }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                Text { text: row.title; color: Palette.text; font-size: 16px; font-weight: 700; overflow: elide; }
                                                HorizontalLayout {
                                                    alignment: start;
                                                    Badge { label: row.when; tone: row.urgent ? Palette.danger : Palette.surface-high; }
                                                }
                                                if row.vote != "" || row.others != "" : Text {
                                                    text: row.vote + (row.vote != "" && row.others != "" ? " · " : "") + row.others;
                                                    color: row.voted ? Palette.accent : Palette.muted;
                                                    font-size: 12px;
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Icon { source: @image-url("icons/chevron_right.svg"); tint: Palette.subtle; y: (parent.height - self.height) / 2; }
                                        }
                                    }
                                    if root.leaving-open == row.key : HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        Button { label: "Until I watch it"; primary: true; has-icon: true; icon: @image-url("icons/schedule.svg"); clicked => { root.keep-vote(row.key, "watched"); } }
                                        Button { label: "Keep 30 days"; clicked => { root.keep-vote(row.key, "days30"); } }
                                        Button { label: "Keep 7 days"; clicked => { root.keep-vote(row.key, "days7"); } }
                                        Button { label: "I love it"; has-icon: true; icon: @image-url("icons/favorite.svg"); clicked => { root.keep-vote(row.key, "love"); } }
                                        Button { label: "A classic"; clicked => { root.keep-vote(row.key, "classic"); } }
                                        Button { label: "Don't care"; clicked => { root.keep-vote(row.key, "dontcare"); } }
                                        if row.voted : Button { label: "Remove my choice"; clicked => { root.keep-vote(row.key, "remove"); } }
                                    }
                                }
                                }
                            }
                        }
                    }

                    if root.page == Page.together : ScrollView {
                        VerticalLayout {
                            padding: 40px;
                            padding-top: 28px;
                            spacing: 10px;
                            alignment: start;
                            PageTitle { title: "Together"; subtitle: "What people on your AlwyWatch server are watching together. Join one: its host lets you in."; }
                            if root.together-status != "" : Text { text: root.together-status; color: Palette.muted; font-size: 16px; wrap: word-wrap; }
                            for room in root.together-rooms : Focusable {
                                height: 128px;
                                background: self.active ? Palette.surface-high : Palette.surface;
                                border-radius: 18px;
                                clicked => { root.together-join(room.code); }
                                HorizontalLayout {
                                    padding: 10px;
                                    spacing: 16px;
                                    Rectangle {
                                        width: 72px;
                                        border-radius: 10px;
                                        clip: true;
                                        background: Palette.surface-high;
                                        Image { source: room.poster; width: parent.width; height: parent.height; image-fit: cover; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text { text: room.title; color: Palette.text; font-size: 18px; font-weight: 700; overflow: elide; }
                                        Text { text: room.people; color: Palette.muted; font-size: 14px; overflow: elide; }
                                        Text { text: room.status; color: Palette.subtle; font-size: 13px; overflow: elide; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button {
                                        label: "Join";
                                        primary: true;
                                        y: (parent.height - self.height) / 2;
                                        clicked => { root.together-join(room.code); }
                                    }
                                }
                            }
                        }
                    }

                    if root.page == Page.triage : FocusScope {
                        key-pressed(e) => {
                            if (e.text == Key.LeftArrow) { root.triage-vote("dontcare"); return accept; }
                            if (e.text == Key.RightArrow) { root.triage-vote("watched"); return accept; }
                            if (e.text == Key.UpArrow) { root.triage-vote("love"); return accept; }
                            return reject;
                        }
                        init => { self.focus(); }
                        Rectangle {
                            background: @radial-gradient(circle, #ffb22440 0%, #09090c00 65%);
                            VerticalLayout {
                                padding: 32px;
                                spacing: 14px;
                                alignment: start;
                                Text { text: "Sort them out"; color: Palette.text; font-size: 30px; font-weight: 800; horizontal-alignment: center; }
                                if root.triage-left == 0 : Text { text: "Nothing left to sort. Thanks!"; color: Palette.muted; horizontal-alignment: center; }
                                if root.triage-left > 0 : Text {
                                    text: root.triage-left + " left  ·  ← don't care   → until I watch it   ↑ forever";
                                    color: Palette.subtle;
                                    horizontal-alignment: center;
                                }
                                if root.triage-left > 0 : HorizontalLayout {
                                    alignment: center;
                                    spacing: 32px;
                                    Rectangle {
                                        width: 280px;
                                        height: 420px;
                                        border-radius: 18px;
                                        clip: true;
                                        background: Palette.surface-high;
                                        Image { source: root.triage-card.poster; width: parent.width; height: parent.height; image-fit: cover; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 12px;
                                        width: 320px;
                                        Text { text: root.triage-card.title; color: Palette.text; font-size: 28px; font-weight: 800; wrap: word-wrap; }
                                        HorizontalLayout { alignment: start; Badge { label: root.triage-card.when; tone: root.triage-card.urgent ? Palette.danger : Palette.surface-high; } }
                                        Rectangle { height: 6px; }
                                        HorizontalLayout { alignment: start; Button { label: "Until I watch it"; primary: true; has-icon: true; icon: @image-url("icons/schedule.svg"); clicked => { root.triage-vote("watched"); } } }
                                        HorizontalLayout { alignment: start; Button { label: "Forever"; has-icon: true; icon: @image-url("icons/favorite.svg"); clicked => { root.triage-vote("love"); } } }
                                        HorizontalLayout { alignment: start; Button { label: "Keep 30 days"; clicked => { root.triage-vote("days30"); } } }
                                        HorizontalLayout { alignment: start; Button { label: "Don't care"; has-icon: true; icon: @image-url("icons/close.svg"); clicked => { root.triage-vote("dontcare"); } } }
                                    }
                                }
                            }
                        }
                    }

                    if root.page == Page.keepadmin : ScrollView {
                        VerticalLayout {
                            padding: 40px;
                            padding-top: 28px;
                            spacing: 20px;
                            alignment: start;
                            PageTitle { title: "Admin"; subtitle: "Leaving soon: countdown and people's rights"; }
                            Group {
                                title: "START COUNTDOWN";
                                Text {
                                    text: "Every item is already past its date. Before activating a collection in Maintainerr, restart its countdown so people get the full delay to vote. This changes deletion dates in Maintainerr. Click twice to confirm.";
                                    color: Palette.muted;
                                    wrap: word-wrap;
                                }
                                for c in root.admin-collections : HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: c.title; color: Palette.text; font-weight: 700; vertical-alignment: center; min-width: 200px; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button { label: "Today"; clicked => { root.admin-countdown(c.id, 0); } }
                                    Button { label: "Over 14 days"; clicked => { root.admin-countdown(c.id, 14); } }
                                    Button { label: "Over 30 days"; clicked => { root.admin-countdown(c.id, 30); } }
                                }
                            }
                            Group {
                                title: "PEOPLE";
                                for u in root.admin-users : VerticalLayout {
                                    spacing: 6px;
                                    Text { text: u.name + "  ·  " + u.detail; color: Palette.text; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Button { label: u.forever; clicked => { root.admin-rights(u.key, "forever"); } }
                                        Button { label: u.max-forever; clicked => { root.admin-rights(u.key, "max-forever"); } }
                                        Button { label: u.max-days; clicked => { root.admin-rights(u.key, "max-days"); } }
                                    }
                                }
                            }
                            Group {
                                title: "KEPT FOREVER";
                                Text { text: root.forever-summary; color: Palette.muted; wrap: word-wrap; }
                                for p in root.forever-people : VerticalLayout {
                                    spacing: 4px;
                                    Text { text: p.title; color: Palette.text; font-weight: 700; }
                                    Text { text: p.detail; color: Palette.muted; font-size: 13px; wrap: word-wrap; }
                                    Rectangle {
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Palette.surface-high;
                                        Rectangle {
                                            x: 0;
                                            width: parent.width * max(0, p.shared);
                                            border-radius: 3px;
                                            background: Palette.accent;
                                        }
                                    }
                                }
                                if root.forever-titles.length > 0 : Text { text: "Titles"; color: Palette.text; font-weight: 700; }
                                for t in root.forever-titles : HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: t.title; color: Palette.text; min-width: 260px; }
                                    Text { text: t.detail; color: Palette.muted; wrap: word-wrap; horizontal-stretch: 1; }
                                }
                            }
                        }
                    }

                    if root.page == Page.settings : ScrollView {
                        VerticalLayout {
                            padding: 40px;
                            padding-top: 28px;
                            spacing: 22px;
                            alignment: start;
                            PageTitle { title: "Settings"; }
                            Group {
                                title: "ACCOUNTS";
                                for a in root.accounts : HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        Text { text: a.label; color: Palette.text; font-weight: 700; }
                                        Text { text: a.detail; color: Palette.muted; font-size: 12px; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    if !a.current : Button { label: "Use"; clicked => { root.use-account(a.id); } }
                                    if a.current : Text { text: "In use"; color: Palette.muted; vertical-alignment: center; }
                                    IconButton { icon: @image-url("icons/delete.svg"); clicked => { root.remove-account(a.id); } }
                                }
                                HorizontalLayout { alignment: start; Button { label: "Add a server"; has-icon: true; icon: @image-url("icons/add.svg"); clicked => { root.go(Page.add); } } }
                            }
                            Group {
                                title: "ALWYWATCH SERVER";
                                if root.keep-active : HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: root.keep-label; color: Palette.text; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    if root.keep-can-switch && root.keep-choices.length == 0 : Button { label: "Sync another account"; clicked => { root.keep-choose(); } }
                                    if root.send-step == "" : Button { label: "Add a device"; clicked => { root.send-start(); } }
                                    Button { label: "Stop syncing"; clicked => { root.keep-disconnect(); } }
                                }
                                if root.keep-active && root.send-step == "code" : VerticalLayout {
                                    spacing: 10px;
                                    Text { text: "On the new device, choose \"Copy from another device\" and type its code here."; color: Palette.muted; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        scode := Field { placeholder: "123456"; accepted(t) => { root.send-lookup(t); } }
                                        Button { label: "Continue"; primary: true; y: (parent.height - self.height) / 2; clicked => { root.send-lookup(scode.text); } }
                                        Button { label: "Cancel"; y: (parent.height - self.height) / 2; clicked => { root.send-cancel(); } }
                                    }
                                }
                                if root.keep-active && root.send-step == "confirm" : VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Send your accounts and settings to “" + root.send-device + "”?"; color: Palette.text; font-weight: 700; wrap: word-wrap; }
                                    Text { text: "Check number"; color: Palette.muted; font-size: 13px; }
                                    Text { text: root.send-check; color: Palette.accent; font-size: 40px; font-weight: 800; letter-spacing: 4px; }
                                    Text { text: "Only send if the new device shows the same number."; color: Palette.muted; font-size: 13px; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        Button { label: "Send"; primary: true; clicked => { root.send-confirm(); } }
                                        Button { label: "Cancel"; clicked => { root.send-cancel(); } }
                                    }
                                }
                                if root.keep-active && root.send-step == "sent" : HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Sent. The other device signs in by itself."; color: Palette.accent; vertical-alignment: center; }
                                    Button { label: "Done"; clicked => { root.send-cancel(); } }
                                }
                                if root.keep-active && root.send-error != "" && root.send-step != "" : Text { text: root.send-error; color: Palette.danger; wrap: word-wrap; }
                                if !root.keep-active : Text {
                                    text: "Shows what your server will delete and lets you keep it. Your Jellyfin or Plex account is your sign-in there.";
                                    color: Palette.muted;
                                    wrap: word-wrap;
                                }
                                if !root.keep-active : HorizontalLayout {
                                    spacing: 10px;
                                    kurl := Field { placeholder: "AlwyWatch server address"; accepted(t) => { root.keep-connect(t); } }
                                    Button { label: "Connect"; primary: true; y: (parent.height - self.height) / 2; clicked => { root.keep-connect(kurl.text); } }
                                }
                                if root.keep-choices.length > 0 : Text { text: "Choose the account that syncs with it:"; color: Palette.muted; }
                                for c in root.keep-choices : HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: c.title; color: c.selected ? Palette.accent : Palette.text; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    if c.selected : Text { text: "Syncing"; color: Palette.muted; vertical-alignment: center; }
                                    if !c.selected : Button { label: "Sync this one"; primary: true; clicked => { root.keep-sync(c.id); } }
                                }
                            }
                            Group {
                                title: "REQUESTS";
                                if root.seerr-active : HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: root.seerr-label; color: Palette.text; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button { label: "Disconnect"; clicked => { root.seerr-disconnect(); } }
                                }
                                if !root.seerr-active && root.seerr-step == "url" : HorizontalLayout {
                                    spacing: 10px;
                                    surl := Field { placeholder: "Seerr address"; accepted(t) => { root.seerr-url(t); } }
                                    Button { label: "Connect"; y: (parent.height - self.height) / 2; clicked => { root.seerr-url(surl.text); } }
                                    if root.keep-active : Button { label: "Use my AlwyWatch server"; primary: true; y: (parent.height - self.height) / 2; clicked => { root.seerr-bridge(); } }
                                }
                                if !root.seerr-active && root.seerr-step == "choose" : HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    for l in root.seerr-logins : Button { label: l.title; primary: true; clicked => { root.seerr-login(l.id); } }
                                }
                                if !root.seerr-active && root.seerr-step == "plex" : Text {
                                    text: "Finish signing in to Plex in your browser…";
                                    color: Palette.muted;
                                }
                                if !root.seerr-active && (root.seerr-step == "jellyfin" || root.seerr-step == "local") : VerticalLayout {
                                    spacing: 8px;
                                    if root.seerr-code != "" : Text { text: "Quick Connect code: " + root.seerr-code; color: Palette.text; font-size: 20px; font-weight: 800; }
                                    su := Field { placeholder: root.seerr-step == "local" ? "Email" : "Username"; }
                                    sp := Field { placeholder: "Password"; input-type: password; accepted => { root.seerr-password(su.text, sp.text); } }
                                    HorizontalLayout { alignment: start; Button { label: "Sign in"; primary: true; clicked => { root.seerr-password(su.text, sp.text); } } }
                                }
                                if root.seerr-message != "" && root.page == Page.settings : Text { text: root.seerr-message; color: Palette.danger; }
                            }
                            Group {
                                title: "PLAYBACK";
                                SettingToggle {
                                    title: "Audio passthrough";
                                    subtitle: "Send Dolby/DTS untouched to an HDMI or S/PDIF receiver.";
                                    on: root.spdif;
                                    clicked => { root.toggle-spdif(); }
                                }
                                SettingToggle {
                                    title: "Skip intros automatically";
                                    subtitle: "Otherwise press S when the intro starts.";
                                    on: root.auto-skip-intro;
                                    clicked => { root.toggle-setting("player.auto_skip_intro"); }
                                }
                                SettingToggle {
                                    title: "Play next episode during credits";
                                    subtitle: "After a 10 second countdown, which C cancels.";
                                    on: root.auto-next;
                                    clicked => { root.toggle-setting("player.auto_next"); }
                                }
                            }
                            Group {
                                title: "STORAGE";
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Image cache"; color: Palette.text; font-weight: 700; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: root.cache-size; color: Palette.muted; vertical-alignment: center; }
                                    Button { label: "Clear"; clicked => { root.clear-cache(); } }
                                }
                            }
                            Text { text: root.about; color: Palette.subtle; }
                        }
                    }
                }
            }
        }
    }
    // Asking to join a watch together room: over everything until let in, declined or closed.
    if root.join-message != "" : Rectangle {
        width: root.width;
        height: root.height;
        background: #000000b0;
        TouchArea { }
        Rectangle {
            width: min(480px, root.width - 48px);
            height: jd.preferred-height;
            border-radius: 22px;
            background: Palette.surface-high;
            jd := VerticalLayout {
                padding: 28px;
                spacing: 14px;
                Text { text: root.join-title; color: Palette.text; font-size: 22px; font-weight: 800; wrap: word-wrap; }
                Text { text: root.join-message; color: Palette.muted; font-size: 15px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        label: root.join-done ? "Close" : "Cancel";
                        primary: root.join-done;
                        clicked => { root.together-cancel(); }
                    }
                }
            }
        }
    }
}
