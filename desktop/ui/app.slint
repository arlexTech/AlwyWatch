    /// Admin → People: Seerr users to request as ("" = automatic), and the row picking one.
    in property <[NamedId]> admin-seerr-users;
    property <string> admin-seerr-open;
    callback admin-seerr(string, string); // user key, Seerr user id ("" = automatic)
    // Add a profile → Create an AlwyWatch account: the address step leads to the form.
    in-out property <bool> add-create;
    in property <bool> create-invite-needed;
    // Create an account: the invitation code typed, who invited, what it gives (or why it
    // doesn't work), the username (prefilled from the invitation).
    in-out property <string> create-invite;
    in property <string> create-invite-from;
    in property <string> create-invite-note;
    in property <bool> create-invite-bad;
    in-out property <string> create-username;
    // Prefilled from the invitation: where "forgot password" sends its link.
    in-out property <string> create-email;
    // "Forgot password?": what happened (not an error).
    in property <string> account-info;
    callback account-forgot(string, string); // AlwyWatch server address, username or email
    callback create-invite-edited(string, string); // address, code
    callback create-check(string); // AlwyWatch server address
    callback account-create(string, string, string, string, string); // address, invitation, username, password, again
    callback account-manage();
    callback cycle-language();
    in property <string> language-label;
    callback keep-vote(string, string); // key, choice
    callback keep-look-up(); // the title page's title, in no deletion list
    callback watch-together(string); // item: a new room (lobby) with it
    callback together-open(string); // room code: join an invitation, or open my room
    callback together-decline(string); // room code: "Not now"
    callback room-start();
    callback together-new(); // a room first, its title afterwards
    callback player-room-start();
    callback player-room-cancel();
    callback room-play(); // started room, player closed: back to the video
    callback room-leave();
    callback room-invite();
    callback room-uninvite(string); // user key
    callback picker-toggle(string); // user key
    callback picker-filter(string);
    callback picker-send();
    callback picker-cancel();
    callback invite-join();
    callback invite-decline();
    callback invite-dismiss();
    callback account-dialog-open(string); // name | avatar
    callback account-name-edited(string);
    callback account-name-save();
    callback account-name-reset();
    callback account-preset(string); // preset id, or "default"
    callback account-upload();
    callback account-remove-avatar();
    callback account-dialog-close();
    callback welcome-continue();
    callback welcome-skip();
    callback link-ask(string); // account id ("Link another sign-in")
    callback link-confirm();
    callback link-dialog-close(); // Not now / Cancel / Escape
    callback unlink-ask(string); // user key
    callback unlink-confirm();
    callback crop-drag(float, float); // screen pixels
    callback crop-zoom-by(float); // wheel steps
    callback crop-set-zoom(float);
    callback crop-save();
    callback crop-cancel();
    callback leaving-scrolled(int); // first visible row, to load the posters around it
    callback triage-vote(string);       // choice
    callback admin-rights(string, string); // user key, field
    callback admin-countdown(string, int); // collection id, stagger days
    // Profiles
    in property <[ProfileRow]> profiles;
    in property <string> profile-name; // the one in use
    in property <bool> profile-auto;
    in property <string> profile-dialog; // "" | add | rename | pin | switch | remove
    in property <ProfileRow> profile-target;
    in-out property <string> profile-input; // the dialog's name or PIN field
    in property <string> profile-message;
    in property <bool> profile-gate; // "Who's watching?" before the app
    // Settings: the section shown (account | servers | requests | playback | audio | device |
    // admin). Older ids still lead somewhere: alwywatch/services → account, about/profiles →
    // device.
    in-out property <string> settings-section: "account";
    property <string> shown-section: root.page == Page.profiles ? "device"
        : root.settings-section == "alwywatch" || root.settings-section == "services" ? "account"
        : root.settings-section == "about" || root.settings-section == "profiles" ? "device"
        : root.settings-section == "admin" && !root.keep-admin ? "account"
        : root.settings-section;
    in property <string> audio-lang-label;
    in property <string> sub-mode-label;
    in property <string> sub-lang-label;
    callback cycle-setting(string); // next choice of a setting key
    in property <bool> profile-gate-back; // the gate's PIN step can go back to the tiles
    in property <bool> profile-gate-menu; // opened from the menu: it can be closed
    callback profile-switcher(); // the menu's profile item: "Who's watching?" over the app
    callback profile-open(string); // switch to (or, at start, pick) a profile
    callback profile-dialog-open(string, string); // kind, profile id
    callback profile-submit();
    callback profile-edited(string);
    callback profile-pin-remove();
    callback profile-cancel();
    callback profile-auto-toggle();
    // Copy watch history
    in property <[AccountChoice]> history-from;
    in property <[AccountChoice]> history-to;
    in property <string> history-state: "idle"; // idle | running | plan | done
    in property <string> history-step;
    in property <float> history-progress: -1; // -1: not known yet
    in property <string> history-summary;
    in property <string> history-detail;
    in property <string> history-copy-label; // "" when there is nothing to copy
    in property <string> history-missing; // titles the destination doesn't have, one per line
    in property <bool> history-show-missing;
    in property <string> history-error;
    callback history-pick(string, string); // from | to, account id
    callback history-check();
    callback history-copy();
    callback history-toggle-missing();

    // The in-window player (see PlayerOverlay).
    in-out property <bool> player-on;
    in property <string> player-title;
    in property <int> player-pos;
    in property <int> player-dur;
    in property <int> player-cache;
    in property <bool> player-paused;
    in property <string> player-skip;
    in property <int> player-countdown;
    in property <string> player-note;
    in property <bool> player-has-next;
    in property <bool> player-has-previous;
    in property <bool> player-near-end;
    in property <string> player-ends-at;
    in property <string> player-room-label;
    in property <[PlayerTrack]> player-audio;
    in property <[PlayerTrack]> player-subtitles;
    in property <string> player-audio-label;
    in property <string> player-subtitle-label;
    in property <bool> player-fullscreen;
    callback player-cmd(string, string);
    // A row's "See all" (key from Rail.see-all, the row's title).
    callback rail-see-all(string, string);
    // The poster grid page's title when it isn't My list ("Continue watching").
    in property <string> list-title: @tr("My list");

    // Arrow keys and Escape not consumed by a focused element end up here.
    FocusScope {
        visible: !root.profile-gate && !root.player-on;
        key-pressed(e) => {
            if (e.text == Key.Escape && root.profile-dialog != "") { root.profile-cancel(); return accept; }
            if (e.text == Key.Escape && root.crop-open) { root.crop-cancel(); return accept; }
            if (e.text == Key.Escape && root.mark-confirm != "") { root.mark-confirm-cancel(); return accept; }
            if (e.text == Key.Escape && root.link-dialog != "") { root.link-dialog-close(); return accept; }
            if (e.text == Key.Escape && root.account-dialog == "welcome") { root.welcome-skip(); return accept; }
            if (e.text == Key.Escape && root.account-dialog != "") { root.account-dialog-close(); return accept; }
            if (e.text == Key.Escape && root.room-picker) { root.picker-cancel(); return accept; }
            if (e.text == Key.Escape && root.invite-code != "") { root.invite-dismiss(); return accept; }
            if (e.text == Key.Escape || (e.text == Key.Backspace && !e.modifiers.control)) {
                if (root.can-go-back) { root.back(); return accept; }
            }
            if (e.text == Key.RightArrow || e.text == Key.DownArrow) { root.move-focus(true); return accept; }
            if (e.text == Key.LeftArrow || e.text == Key.UpArrow) { root.move-focus(false); return accept; }
            return reject;
        }

        HorizontalLayout {
            // ----- Sidebar ----------------------------------------------------------------
            if root.page != Page.add : Rectangle {
                width: 232px;
                background: #ffffff08;
                Rectangle { x: parent.width - 1px; width: 1px; background: Palette.outline; }
                VerticalLayout {
                    padding: 16px;
                    padding-top: 24px;
                    spacing: 4px;
                    alignment: start;
                    Text {
                        text: "AlwyWatch";
                        color: Palette.text;
                        font-size: 24px;
                        font-weight: 800;
                        letter-spacing: -0.5px;
                    }
                    Rectangle { height: 22px; }
                    // Several profiles on this computer: who is watching, one click to switch.
                    if root.profiles.length > 1 : NavItem { label: root.profile-name; icon: @image-url("icons/person.svg"); selected: false; clicked => { root.profile-switcher(); } }
                    NavItem { label: @tr("Home"); icon: @image-url("icons/home.svg"); selected: root.page == Page.home; clicked => { root.go(Page.home); } }
                    NavItem { label: @tr("Search"); icon: @image-url("icons/search.svg"); selected: root.page == Page.search; clicked => { root.go(Page.search); } }
                    NavItem { label: @tr("My list"); icon: @image-url("icons/bookmark.svg"); selected: root.page == Page.mylist && root.list-title == "My list"; clicked => { root.go(Page.mylist); } }
                    for lib in root.libraries : NavItem {
                        label: lib.title;
                        icon: @image-url("icons/movie.svg");
                        selected: root.page == Page.library && root.library-id == lib.id;
                        clicked => { root.open-library(lib.id, lib.title); }
                    }
                    if root.keep-active && root.leaving-available : NavItem {
                        label: @tr("Leaving soon");
                        icon: @image-url("icons/hourglass_bottom.svg");
                        selected: root.page == Page.leaving || root.page == Page.triage || root.page == Page.keepadmin;
                        clicked => { root.go(Page.leaving); }
                    }
                    if root.keep-active : NavItem {
                        label: @tr("Together");
                        icon: @image-url("icons/group.svg");
                        selected: root.page == Page.together || root.page == Page.room;
                        clicked => { root.go(Page.together); }
                    }
                    if root.seerr-active && root.requests-available : NavItem { label: @tr("Requests"); icon: @image-url("icons/add.svg"); selected: root.page == Page.requests || root.page == Page.seerrtitle || root.page == Page.seerrsaga; clicked => { root.go(Page.requests); } }
                    NavItem { label: @tr("Downloads"); icon: @image-url("icons/download.svg"); selected: root.page == Page.downloads; clicked => { root.go(Page.downloads); } }
                    NavItem { label: @tr("Settings"); icon: @image-url("icons/settings.svg"); selected: root.page == Page.settings || root.page == Page.profiles || root.page == Page.historycopy; clicked => { root.go(Page.settings); } }
                }
            }

            // ----- Content ----------------------------------------------------------------
            Rectangle {
                horizontal-stretch: 1;
                clip: true;

                VerticalLayout {
                    if root.keep-message != "" : Rectangle {
                        height: 40px;
                        background: #ffb2241f;
                        Text { text: root.keep-message; color: Palette.accent; font-weight: 600; }
                    }
                    if root.error != "" : Rectangle {
                        height: 40px;
                        background: Palette.surface;
                        Text { text: root.error; color: Palette.muted; }
                    }

                    // Home: the rails (no artwork banner: like the phone, the page is for browsing).
                    if root.page == Page.home : ScrollView {
                        VerticalLayout {
                            spacing: 18px;
                            VerticalLayout {
                                padding-top: 28px;
                                padding-left: 40px;
                                padding-right: 24px;
                                padding-bottom: 32px;
                                spacing: 22px;
                                for rail in root.rails : RailView {
                                    rail: rail;
                                    open(id) => { root.open-item(id); }
                                    hovered(id) => { root.prefetch(id); }
                                    see-all(key) => { root.rail-see-all(key, rail.title); }
                                }
                                if root.rails.length == 0 : Text { text: root.status; color: Palette.muted; }
                            }
                        }
                    }

                    if root.page == Page.library || root.page == Page.search || root.page == Page.mylist : VerticalLayout {
                        padding-left: 40px;
                        padding-right: 24px;
                        padding-top: 28px;
                        spacing: 18px;
                        if root.page == Page.library : HorizontalLayout {
                            spacing: 10px;
                            PageTitle { title: root.grid-title; }
                            Rectangle { horizontal-stretch: 1; }
                            if root.library-tab == "browse" || root.library-tab == "" : HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                for s in root.sorts : Button {
                                    label: s.title;
                                    primary: s.selected;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.set-sort(s.id); }
                                }
                            }
                        }
                        if root.page == Page.library && root.library-tab != "" : HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            for t in [
                                { id: "recommended", title: @tr("Recommended") },
                                { id: "browse", title: @tr("Browse") },
                                { id: "collections", title: @tr("Collections") },
                                { id: "categories", title: @tr("Categories") },
                            ] : Button {
                                label: t.title;
                                primary: root.library-tab == t.id;
                                clicked => { root.library-tab-chosen(t.id); }
                            }
                        }
                        if root.page == Page.library && root.library-tab == "recommended" : ScrollView {
                            VerticalLayout {
                                spacing: 22px;
                                padding-bottom: 32px;
                                alignment: start;
                                for rail in root.lib-rails : RailView {
                                    rail: rail;
                                    open(id) => { root.open-item(id); }
                                    hovered(id) => { root.prefetch(id); }
                                    see-all(key) => { root.rail-see-all(key, root.grid-title); }
                                }
                                if root.lib-rails.length == 0 : Text { text: @tr("Nothing in progress or recently added."); color: Palette.muted; }
                            }
                        }
                        if root.page == Page.library && root.library-tab == "categories" : ScrollView {
                            property <int> gcols: max(1, floor((self.visible-width - 10px) / 236px));
                            content-height: ceil(root.genres.length / self.gcols) * 60px + 20px;
                            for g[i] in root.genres : Button {
                                x: mod(i, parent.gcols) * 236px + 4px;
                                y: floor(i / parent.gcols) * 60px + 4px;
                                width: 224px;
                                label: g.title;
                                clicked => { root.open-genre(g.id, g.title); }
                            }
                        }
                        if root.page == Page.library && root.library-tab == "collections" && root.grid.length == 0 : Text {
                            text: root.status;
                            color: Palette.muted;
                        }
                        if root.page == Page.mylist : PageTitle { title: root.list-title; }
                        if root.page == Page.mylist && root.grid.length == 0 : Text { text: root.status; color: Palette.muted; wrap: word-wrap; }
                        if root.page == Page.search : VerticalLayout {
                            spacing: 14px;
                            // Its own height only: the results grid below takes the rest.
                            vertical-stretch: 0;
                            PageTitle { title: @tr("Search"); }
                            Field {
                                autofocus: true;
                                placeholder: @tr("Movies, shows, episodes…");
                                text <=> root.search-text;
                                edited(t) => { root.search(t); }
                            }
                        }
                        if root.page == Page.search || root.page == Page.mylist || root.library-tab == "browse" || root.library-tab == "collections" || root.library-tab == "" : grid := ScrollView {
                            property <int> cols: max(1, floor((self.visible-width - 10px) / 176px));
                            content-height: ceil(root.grid.length / self.cols) * 312px + 20px;
                            scrolled => {
                                root.grid-scrolled(-self.content-y / max(1px, self.content-height - self.visible-height));
                            }
                            for c[i] in root.grid : PosterCard {
                                x: mod(i, grid.cols) * 176px + 4px;
                                y: floor(i / grid.cols) * 312px + 4px;
                                card: c;
                                clicked => { root.open-item(c.id); }
                                focused => { root.prefetch(c.id); }
                            }
                        }
                    }

                    if root.page == Page.detail : ScrollView {
                        VerticalLayout {
                            spacing: 18px;
                            Rectangle {
                                height: 520px;
                                clip: true;
                                Image { source: root.detail.backdrop; width: parent.width; height: parent.height; image-fit: cover; }
                                Rectangle { background: @linear-gradient(90deg, #09090cf0 0%, #09090c90 40%, #09090c00 75%); }
                                Rectangle { background: @linear-gradient(180deg, #09090c80 0%, #09090c00 18%, #09090c00 55%, #09090c 100%); }
                                if root.can-go-back : IconButton {
                                    x: 24px;
                                    y: 20px;
                                    icon: @image-url("icons/arrow_back.svg");
                                    clicked => { root.back(); }
                                }
                                VerticalLayout {
                                    x: 40px;
                                    width: min(620px, parent.width - 80px);
                                    padding-bottom: 32px;
                                    spacing: 12px;
                                    alignment: end;
                                    if root.detail.logo.width > 0 : Image {
                                        source: root.detail.logo;
                                        height: 120px;
                                        image-fit: contain;
                                        horizontal-alignment: left;
                                    }
                                    if root.detail.logo.width == 0 : Text {
                                        text: root.detail.title;
                                        color: Palette.text;
                                        font-size: 46px;
                                        font-weight: 800;
                                        letter-spacing: -1px;
                                        wrap: word-wrap;
                                    }
                                    Text { text: root.detail.meta; color: Palette.muted; font-size: 15px; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        if root.detail.playable : Button {
                                            label: root.detail.resumable ? @tr("Resume from {}", root.detail.resume-at) : @tr("Play");
                                            primary: true;
                                            has-icon: true;
                                            icon: @image-url("icons/play_arrow_fill1.svg");
                                            clicked => { root.play(root.detail.id, false); }
                                        }
                                        if root.detail.resumable : Button {
                                            label: @tr("From start");
                                            clicked => { root.play(root.detail.id, true); }
                                        }
                                        if root.detail.playable && root.keep-active : Button {
                                            label: root.room-hosting ? @tr("Watch in your room") : @tr("Watch together");
                                            has-icon: true;
                                            icon: @image-url("icons/group.svg");
                                            clicked => { root.watch-together(root.detail.id); }
                                        }
                                        if root.detail.can-watchlist : IconButton {
                                            icon: root.detail.watchlisted ? @image-url("icons/bookmark_fill1.svg") : @image-url("icons/bookmark.svg");
                                            tip: root.detail.watchlisted ? @tr("In my list") : @tr("Add to my list");
                                            clicked => { root.toggle-watchlist(root.detail.id); }
                                        }
                                        if root.detail.playable : IconButton {
                                            icon: @image-url("icons/download.svg");
                                            tip: @tr("Download");
                                            clicked => { root.download(root.detail.id); }
                                        }
                                        IconButton {
                                            icon: @image-url("icons/check.svg");
                                            tip: @tr("Watched or not");
                                            clicked => { root.toggle-played(root.detail.id); }
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                padding-left: 40px;
                                padding-right: 40px;
                                padding-bottom: 32px;
                                spacing: 14px;
                                Text { text: root.detail.overview; color: #f4f4f6d9; font-size: 16px; wrap: word-wrap; }
                                if root.detail.genres != "" : Text { text: root.detail.genres; color: Palette.subtle; }
                                // About the title rather than actions on it: the trailer and the saga.
                                if root.detail.has-trailer || root.detail.saga-id != "" : HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    if root.detail.has-trailer : Button {
                                        label: @tr("Trailer");
                                        has-icon: true;
                                        icon: @image-url("icons/movie.svg");
                                        clicked => { root.play-trailer(root.detail.id); }
                                    }
                                    if root.detail.saga-id != "" : Button {
                                        label: root.detail.saga-label;
                                        has-icon: true;
                                        icon: @image-url("icons/video_library.svg");
                                        clicked => { root.detail-open-saga(); }
                                    }
                                }
                                // Where the title stands in Leaving soon, my choice, the keep choices on demand.
                                if root.detail-keep.shown : Rectangle {
                                    background: Palette.surface;
                                    border-radius: 16px;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;
                                            Icon { source: @image-url("icons/hourglass_bottom.svg"); tint: root.detail-keep.listed ? Palette.accent : Palette.muted; width: 20px; height: 20px; y: (parent.height - self.height) / 2; }
                                            Text { text: root.detail-keep.title; color: Palette.text; font-size: 16px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        if !root.detail-keep.listed : Text { text: @tr("The server doesn't plan to delete this. You can still say you want it kept, in case it does later."); color: Palette.muted; font-size: 13px; wrap: word-wrap; }
                                        if root.detail-keep.detail != "" : Text { text: root.detail-keep.detail; color: Palette.muted; font-size: 13px; wrap: word-wrap; }
                                        Text { text: root.detail-keep.choice; color: Palette.text; font-size: 14px; wrap: word-wrap; }
                                        if root.detail-keep.key == "" || root.leaving-open != root.detail-keep.key : HorizontalLayout {
                                            alignment: start;
                                            padding-top: 6px;
                                            Button {
                                                label: root.detail-keep.looking ? @tr("Looking it up…") : root.detail-keep.voted ? @tr("Change my choice") : @tr("Keep it");
                                                has-icon: true;
                                                icon: @image-url("icons/schedule.svg");
                                                // A title in no list: its entry comes from the server first.
                                                clicked => {
                                                    if root.detail-keep.key != "" {
                                                        root.leaving-open = root.detail-keep.key;
                                                    } else if !root.detail-keep.looking {
                                                        root.keep-look-up();
                                                    }
                                                }
                                            }
                                        }
                                        if root.detail-keep.error != "" : Text { text: root.detail-keep.error; color: Palette.danger; font-size: 13px; wrap: word-wrap; }
                                        if root.detail-keep.key != "" && root.leaving-open == root.detail-keep.key : KeepChoices {
                                            padding-top: 6px;
                                            key: root.detail-keep.key;
                                            voted: root.detail-keep.voted;
                                            vote(k, c) => { root.keep-vote(k, c); }
                                        }
                                    }
                                }
                                if root.detail.crew != "" : Text { text: root.detail.crew; color: Palette.muted; }
                                if root.detail.is-series : Text { text: @tr("Episodes"); color: Palette.text; font-size: 20px; font-weight: 700; }
                                if root.detail.is-series : HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    for s in root.seasons : Button {
                                        label: s.title;
                                        primary: s.selected;
                                        clicked => { root.select-season(s.id); }
                                    }
                                }
                                // Whole season or show at once (every episode under it).
                                if root.detail.is-series : HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text { text: @tr("Mark as"); color: Palette.subtle; font-size: 13px; vertical-alignment: center; }
                                    if root.seasons.length > 0 : Button { label: @tr("Season watched"); clicked => { root.mark-many("season", true); } }
                                    if root.seasons.length > 0 : Button { label: @tr("Season unwatched"); clicked => { root.mark-many("season", false); } }
                                    Button { label: @tr("All episodes watched"); clicked => { root.mark-many("show", true); } }
                                    Button { label: @tr("All episodes unwatched"); clicked => { root.mark-many("show", false); } }
                                }
                                for ep in root.episodes : Focusable {
                                    height: 112px;
                                    background: self.active ? Palette.surface-high : transparent;
                                    clicked => { root.play(ep.id, false); }
                                    focused => { root.prefetch(ep.id); }
                                    HorizontalLayout {
                                        padding: 8px;
                                        spacing: 16px;
                                        Rectangle {
                                            width: 170px;
                                            border-radius: 10px;
                                            clip: true;
                                            background: Palette.surface;
                                            Image { source: ep.image; width: parent.width; height: parent.height; image-fit: cover; }
                                            if ep.progress > 0 : Progress { y: parent.height - 4px; width: parent.width; value: ep.progress; border-radius: 0; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            Text { text: ep.title; color: Palette.text; font-size: 16px; font-weight: 700; overflow: elide; }
                                            Text { text: ep.subtitle; color: Palette.muted; overflow: elide; wrap: word-wrap; font-size: 13px; }
                                        }
                                        if ep.played : Icon { source: @image-url("icons/check.svg"); tint: Palette.accent; y: (parent.height - self.height) / 2; }
                                    }
                                }
                                if root.cast.length > 0 : Text { text: @tr("Cast"); color: Palette.text; font-size: 20px; font-weight: 700; }
                                if root.cast.length > 0 : CastRow { people: root.cast; }
                            }
                        }
                    }

                    if root.page == Page.add : Rectangle {
                        background: @radial-gradient(circle, #ffb2244d 0%, #09090c00 60%);
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                width: min(560px, root.width - 48px);
                                padding-top: 72px;
                                spacing: 16px;
                                alignment: start;
                                if root.add-step == "choose" && root.add-from-keep : Text { text: @tr("Add a server"); color: Palette.text; font-size: 36px; font-weight: 800; }
                                if root.add-step == "choose" && root.add-from-keep && root.preset-servers.length > 0 : Text { text: @tr("From your AlwyWatch server"); color: Palette.text; font-size: 17px; font-weight: 700; }
                                if root.add-step == "choose" && root.add-from-keep : VerticalLayout {
                                    spacing: 16px;
                                    for s in root.preset-servers : ChoiceCard {
                                        title: s.title;
                                        subtitle: s.subtitle;
                                        icon: s.plex ? @image-url("icons/play_arrow_fill1.svg") : @image-url("icons/video_library.svg");
                                        clicked => { root.add-keep-pick(s.id); }
                                    }
                                }
                                if root.add-step == "choose" && root.add-from-keep && root.preset-servers.length > 0 : Text { text: @tr("Another server"); color: Palette.text; font-size: 17px; font-weight: 700; }
                                if root.add-step == "choose" && root.add-from-keep : ChoiceCard {
                                    title: "Jellyfin";
                                    subtitle: @tr("Password, or a code from another Jellyfin app");
                                    icon: @image-url("icons/video_library.svg");
                                    clicked => { root.add-choose("jellyfin"); }
                                }
                                if root.add-step == "choose" && root.add-from-keep : ChoiceCard {
                                    title: "Plex";
                                    subtitle: @tr("Sign in on plex.tv");
                                    icon: @image-url("icons/play_arrow_fill1.svg");
                                    clicked => { root.add-choose("plex"); }
                                }
                                if root.add-step == "choose" && !root.add-from-keep : VerticalLayout {
                                    spacing: 4px;
                                    Text { text: @tr("Welcome to AlwyWatch"); color: Palette.text; font-size: 44px; font-weight: 800; letter-spacing: -1px; wrap: word-wrap; }
                                    Text { text: @tr("Your Jellyfin and Plex, fast and beautiful."); color: Palette.muted; font-size: 17px; }
                                    Rectangle { height: 16px; }
                                }
                                if root.add-step != "choose" : HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    IconButton { icon: @image-url("icons/arrow_back.svg"); clicked => { root.add-choose("back"); } }
                                    Text {
                                        text: root.add-step == "create" || (root.add-step == "alwywatch" && root.add-create) ? @tr("Create an AlwyWatch account")
                                            : root.add-step == "alwywatch" ? @tr("Sign in to AlwyWatch")
                                            : root.add-step == "receive" ? @tr("Sign in with a code")
                                            : root.add-step == "account" ? @tr("AlwyWatch account")
                                            : root.add-step == "direct" ? (root.accounts.length > 0 ? @tr("Add a server") : @tr("Jellyfin or Plex only"))
                                            : root.add-step == "plex" || root.add-step == "plex-servers" ? "Plex" : "Jellyfin";
                                        color: Palette.text;
                                        font-size: 28px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }
                                if root.add-step == "choose" && !root.add-from-keep : ChoiceCard {
                                    title: @tr("Sign in to AlwyWatch");
                                    subtitle: @tr("Your name, settings and servers come with you.");
                                    icon: @image-url("icons/hourglass_bottom.svg");
                                    clicked => { root.add-choose("alwywatch"); }
                                }
                                if root.add-step == "choose" && !root.add-from-keep : ChoiceCard {
                                    title: @tr("Create an AlwyWatch account");
                                    subtitle: @tr("If someone invited you");
                                    icon: @image-url("icons/add.svg");
                                    clicked => { root.add-choose("create"); }
                                }
                                if root.add-step == "choose" && !root.add-from-keep : ChoiceCard {
                                    title: @tr("Jellyfin or Plex only");
                                    subtitle: @tr("No account: nothing synced, no Leaving soon or watch together.");
                                    icon: @image-url("icons/person.svg");
                                    clicked => { root.add-choose("direct"); }
                                }
                                if root.add-step == "direct" : ChoiceCard {
                                    title: "Jellyfin";
                                    subtitle: @tr("Quick Connect or password");
                                    icon: @image-url("icons/video_library.svg");
                                    clicked => { root.add-choose("jellyfin"); }
                                }
                                if root.add-step == "direct" : ChoiceCard {
                                    title: "Plex";
                                    subtitle: @tr("Sign in on plex.tv");
                                    icon: @image-url("icons/play_arrow_fill1.svg");
                                    clicked => { root.add-choose("plex"); }
                                }
                                if root.add-step == "alwywatch" && root.add-create : VerticalLayout {
                                    spacing: 12px;
                                    Text { text: @tr("Type the address of the AlwyWatch server you were invited to, something like watch.example.org."); color: Palette.muted; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        cserver := Field { placeholder: "watch.example.org"; text <=> root.keep-address; accepted(t) => { root.create-check(t); } }
                                        Button { label: @tr("Continue"); primary: true; y: (parent.height - self.height) / 2; clicked => { root.create-check(cserver.text); } }
                                    }
                                }
                                if root.add-step == "create" : VerticalLayout {
                                    spacing: 12px;
                                    Text { text: @tr("An account keeps your profile, settings and server list, and signs your devices in. To watch, add your Jellyfin or Plex server afterwards."); color: Palette.muted; wrap: word-wrap; }
                                    cinvite := Field {
                                        placeholder: root.create-invite-needed ? @tr("Invitation code") : @tr("Invitation code (not needed)");
                                        text <=> root.create-invite;
                                        edited(t) => { root.create-invite-edited(root.keep-address, t); }
                                    }
                                    if root.create-invite-from != "" : Text { text: root.create-invite-from; color: Palette.text; font-size: 17px; font-weight: 700; wrap: word-wrap; }
                                    if root.create-invite-note != "" : Text { text: root.create-invite-note; color: root.create-invite-bad ? Palette.danger : Palette.muted; wrap: word-wrap; }
                                    cuser := Field { placeholder: @tr("Username"); text <=> root.create-username; }
                                    Field { placeholder: @tr("Email (to reset a forgotten password)"); text <=> root.create-email; }
                                    cpass := Field { placeholder: @tr("Password"); input-type: password; }
                                    cpass2 := Field {
                                        placeholder: @tr("Password again");
                                        input-type: password;
                                        accepted => { root.account-create(root.keep-address, cinvite.text, cuser.text, cpass.text, cpass2.text); }
                                    }
                                    HorizontalLayout { alignment: start; Button { label: @tr("Create the account"); primary: true; clicked => { root.account-create(root.keep-address, cinvite.text, cuser.text, cpass.text, cpass2.text); } } }
                                    Text { text: @tr("You can add a passkey once signed in, on the AlwyWatch website."); color: Palette.muted; font-size: 13px; wrap: word-wrap; }
                                    if root.transfer-status != "" : Text { text: root.transfer-status; color: Palette.danger; wrap: word-wrap; }
                                }
                                if root.add-step == "alwywatch" && !root.add-create : VerticalLayout {
                                    spacing: 12px;
                                    if root.account-note == "" : Text { text: @tr("Type the AlwyWatch address the person who runs your server gave you. You then sign in with your Jellyfin or Plex login, or with a code from a device where you already use AlwyWatch."); color: Palette.muted; wrap: word-wrap; }
                                    if root.account-note != "" : Text { text: root.account-note; color: Palette.text; font-size: 17px; font-weight: 700; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        kserver := Field { placeholder: "watch.example.org"; text <=> root.keep-address; accepted(t) => { root.add-keep-servers(t); } }
                                        Button { label: @tr("Continue"); primary: root.preset-servers.length == 0; y: (parent.height - self.height) / 2; clicked => { root.add-keep-servers(kserver.text); } }
                                    }
                                    for s in root.preset-servers : ChoiceCard {
                                        title: s.title;
                                        subtitle: s.subtitle;
                                        icon: s.plex ? @image-url("icons/play_arrow_fill1.svg") : @image-url("icons/video_library.svg");
                                        clicked => { root.add-keep-pick(s.id); }
                                    }
                                    if root.keep-address != "" && root.account-note == "" : ChoiceCard {
                                        title: @tr("Sign in with a code");
                                        subtitle: @tr("Scan a QR code with your phone, or approve on a device where you're signed in.");
                                        icon: @image-url("icons/download.svg");
                                        clicked => { root.transfer-receive(root.keep-address); }
                                    }
                                    if root.keep-address != "" && root.account-note == "" : ChoiceCard {
                                        title: @tr("AlwyWatch account");
                                        subtitle: @tr("Username and password");
                                        icon: @image-url("icons/person.svg");
                                        clicked => { root.add-choose("account"); }
                                    }
                                }
                                if root.add-step == "account" : VerticalLayout {
                                    spacing: 12px;
                                    Text { text: @tr("Your AlwyWatch account keeps your profile, settings and server list. To watch, you then sign in to your server."); color: Palette.muted; wrap: word-wrap; }
                                    auser := Field { placeholder: @tr("Username"); }
                                    apass := Field {
                                        placeholder: @tr("Password");
                                        input-type: password;
                                        accepted => { root.account-login(root.keep-address, auser.text, apass.text); }
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        spacing: 10px;
                                        Button { label: @tr("Sign in"); primary: true; clicked => { root.account-login(root.keep-address, auser.text, apass.text); } }
                                        Button { label: @tr("Forgot password?"); clicked => { root.account-forgot(root.keep-address, auser.text); } }
                                    }
                                    if root.account-info != "" : Text { text: root.account-info; color: Palette.text; wrap: word-wrap; }
                                    Text { text: @tr("No password (passkey or single sign-on)? Go back, choose “Sign in with a code” and approve it on your phone."); color: Palette.muted; font-size: 13px; wrap: word-wrap; }
                                    if root.transfer-status != "" : Text { text: root.transfer-status; color: Palette.danger; wrap: word-wrap; }
                                }
                                if root.add-step == "receive" : VerticalLayout {
                                    spacing: 12px;
                                    HorizontalLayout {
                                        spacing: 28px;
                                        alignment: start;
                                        Rectangle {
                                            width: 200px;
                                            height: 200px;
                                            border-radius: 12px;
                                            background: white;
                                            Image { x: 12px; y: 12px; width: 176px; height: 176px; source: root.transfer-qr; image-rendering: pixelated; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 8px;
                                            Text { text: root.transfer-code; color: Palette.text; font-size: 56px; font-weight: 800; letter-spacing: 4px; }
                                            Text { text: @tr("Scan with your phone, or open"); color: Palette.muted; }
                                            Text { text: root.transfer-url; color: Palette.text; font-size: 17px; font-weight: 700; }
                                        }
                                    }
                                    Text {
                                        text: @tr("Or on a device where you're signed in: Settings → This device → Sign in another device, and type this code.");
                                        color: Palette.muted;
                                        wrap: word-wrap;
                                    }
                                    if root.transfer-check != "" : Text {
                                        text: @tr("Check number: {}. It must match if the other device shows one.", root.transfer-check);
                                        color: Palette.muted;
                                        wrap: word-wrap;
                                    }
                                    Text { text: @tr("Waiting for the other device…"); color: Palette.muted; font-size: 13px; }
                                    if root.transfer-status != "" : Text { text: root.transfer-status; color: Palette.danger; wrap: word-wrap; }
                                }
                                if root.add-step == "jellyfin-url" : VerticalLayout {
                                    spacing: 12px;
                                    url := Field {
                                        placeholder: "jellyfin.example.org";
                                        accepted(t) => { root.jellyfin-url(t); }
                                    }
                                    Text { text: @tr("Your Jellyfin server's address, as you use it in a browser."); color: Palette.muted; }
                                    HorizontalLayout { alignment: start; Button { label: @tr("Continue"); primary: true; clicked => { root.jellyfin-url(url.text); } } }
                                }
                                if root.add-step == "jellyfin" : VerticalLayout {
                                    spacing: 12px;
                                    if root.quick-code != "" : Rectangle {
                                        height: 190px;
                                        border-radius: 24px;
                                        background: Palette.surface;
                                        border-width: 1px;
                                        border-color: Palette.outline;
                                        VerticalLayout {
                                            padding: 24px;
                                            spacing: 8px;
                                            Text { text: @tr("QUICK CONNECT"); color: Palette.accent; font-size: 11px; font-weight: 800; letter-spacing: 1px; }
                                            Text { text: root.quick-code; color: Palette.text; font-size: 54px; font-weight: 800; letter-spacing: 8px; }
                                            Text { text: @tr("In a Jellyfin app where you're signed in, open your profile → Quick Connect and enter this code."); color: Palette.muted; wrap: word-wrap; }
                                        }
                                    }
                                    if root.quick-code != "" : Text { text: @tr("Or with your password"); color: Palette.text; font-size: 17px; font-weight: 700; }
                                    user := Field { placeholder: @tr("Username"); }
                                    pass := Field {
                                        placeholder: @tr("Password");
                                        input-type: password;
                                        accepted => { root.jellyfin-sign-in(user.text, pass.text); }
                                    }
                                    HorizontalLayout { alignment: start; Button { label: @tr("Sign in"); primary: true; clicked => { root.jellyfin-sign-in(user.text, pass.text); } } }
                                }
                                if root.add-step == "plex" : Rectangle {
                                    height: 170px;
                                    border-radius: 24px;
                                    background: Palette.surface;
                                    border-width: 1px;
                                    border-color: Palette.outline;
                                    VerticalLayout {
                                        padding: 24px;
                                        spacing: 8px;
                                        Text { text: @tr("Finish signing in to Plex in your browser. You can also go to plex.tv/link and enter:"); color: Palette.muted; wrap: word-wrap; }
                                        Text { text: root.plex-code; color: Palette.text; font-size: 48px; font-weight: 800; letter-spacing: 6px; }
                                    }
                                }
                                if root.add-step == "plex-servers" : VerticalLayout {
                                    spacing: 8px;
                                    Text { text: @tr("Choose a server"); color: Palette.text; font-size: 18px; font-weight: 700; }
                                    for s in root.plex-servers : HorizontalLayout {
                                        alignment: start;
                                        Button { label: s.title; clicked => { root.plex-pick(s.id); } }
                                    }
                                }
                                Text { text: root.status; color: Palette.danger; wrap: word-wrap; }
                            }
                        }
                    }

                    if root.page == Page.downloads : ScrollView {
                        VerticalLayout {
                            padding: 40px;
                            padding-top: 28px;
                            spacing: 12px;
                            alignment: start;
                            PageTitle { title: @tr("Downloads"); subtitle: @tr("Available offline"); }
                            if root.downloads.length == 0 : Text { text: @tr("Nothing downloaded yet. Use the download button on a movie or an episode."); color: Palette.muted; }
                            for d in root.downloads : Rectangle {
                                background: Palette.surface;
                                border-radius: 18px;
                                height: 92px;
                                HorizontalLayout {
                                    padding: 16px;
                                    spacing: 14px;
                                    VerticalLayout {
                                        spacing: 6px;
                                        alignment: center;
                                        Text { text: d.title; color: Palette.text; font-size: 16px; font-weight: 700; overflow: elide; }
                                        Text { text: d.status; color: Palette.muted; font-size: 12px; }
                                        if !d.completed : Progress { value: d.progress; }
                                    }
                                    if d.completed : IconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/play_arrow_fill1.svg"); clicked => { root.play-download(d.account, d.item); } }
                                    if !d.completed && d.active : Button { y: (parent.height - self.height) / 2; label: @tr("Pause"); clicked => { root.download-action(d.id, "pause"); } }
                                    if !d.completed && !d.active : Button { y: (parent.height - self.height) / 2; label: @tr("Resume"); primary: true; clicked => { root.download-action(d.id, "resume"); } }
                                    IconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/delete.svg"); tip: @tr("Delete download"); clicked => { root.download-action(d.id, "remove"); } }
                                }
                            }
                        }
                    }

                    if root.page == Page.requests : ScrollView {
                        VerticalLayout {
                            padding: 40px;
                            padding-top: 28px;
                            spacing: 14px;
                            alignment: start;
                            PageTitle { title: @tr("Requests"); subtitle: @tr("Ask for a movie or a show; it is added when ready."); }
                            Field {
                                placeholder: @tr("Find a movie or a show…");
                                edited(t) => { root.seerr-search(t); }
                            }
                            if root.seerr-message != "" : Text { text: root.seerr-message; color: Palette.accent; }
                            results := Rectangle {
                                property <int> cols: max(1, floor((self.width - 10px) / 176px));
                                height: ceil(root.seerr-results.length / self.cols) * 312px;
                                for c[i] in root.seerr-results : PosterCard {
                                    x: mod(i, results.cols) * 176px;
                                    y: floor(i / results.cols) * 312px;
                                    card: c;
                                    clicked => { root.seerr-open(c.id); }
                                }
                            }
                            if root.seerr-results.length == 0 : Text { text: @tr("My requests"); color: Palette.text; font-size: 20px; font-weight: 700; }
                            if root.seerr-results.length == 0 : mine := Rectangle {
                                property <int> cols: max(1, floor((self.width - 10px) / 176px));
                                height: ceil(root.seerr-mine.length / self.cols) * 312px;
                                for c[i] in root.seerr-mine : PosterCard {
                                    x: mod(i, mine.cols) * 176px;
                                    y: floor(i / mine.cols) * 312px;
                                    card: c;
                                    clicked => { root.seerr-open(c.id); }
                                }
                            }
                        }
                    }

                    // A title from Seerr: artwork, facts, request, saga, cast.
                    if root.page == Page.seerrtitle : ScrollView {
                        VerticalLayout {
                            spacing: 18px;
                            padding-bottom: 40px;
                            Rectangle {
                                height: 380px;
                                clip: true;
                                Image { source: root.seerr-title.backdrop; width: parent.width; height: parent.height; image-fit: cover; }
                                Rectangle { background: @linear-gradient(180deg, #09090c40 0%, #09090c00 30%, #09090c00 55%, #09090c 100%); }
                            }
                            HorizontalLayout {
                                padding-left: 40px;
                                padding-right: 40px;
                                spacing: 22px;
                                Rectangle {
                                    width: 150px;
                                    height: 225px;
                                    border-radius: 14px;
                                    clip: true;
                                    background: Palette.surface;
                                    Image { source: root.seerr-title.poster; width: parent.width; height: parent.height; image-fit: cover; }
                                }
                                VerticalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Text { text: root.seerr-title.title; color: Palette.text; font-size: 38px; font-weight: 800; letter-spacing: -0.5px; wrap: word-wrap; }
                                    Text { text: root.seerr-title.meta; color: Palette.muted; font-size: 15px; }
                                    if root.seerr-title.status != "" : HorizontalLayout {
                                        alignment: start;
                                        Badge {
                                            label: root.seerr-title.status;
                                            tone: root.seerr-title.available ? Palette.success : Palette.surface-high;
                                            fg: root.seerr-title.available ? #000000 : #ffffff;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        if root.seerr-panel.can-request : Button {
                                            label: root.seerr-panel.is-tv ? @tr("Request all seasons") : @tr("Request");
                                            primary: true;
                                            has-icon: true;
                                            icon: @image-url("icons/add.svg");
                                            clicked => { root.seerr-request(true); }
                                        }
                                        if root.seerr-panel.can-request && root.seerr-panel.is-tv : Button {
                                            label: @tr("Request selected");
                                            clicked => { root.seerr-request(false); }
                                        }
                                    }
                                    if root.seerr-panel.can-request && root.seerr-panel.is-tv : HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        for s in root.seerr-seasons : Button {
                                            label: s.title;
                                            primary: s.selected;
                                            clicked => { root.seerr-toggle-season(s.id); }
                                        }
                                    }
                                    if root.seerr-message != "" : Text { text: root.seerr-message; color: Palette.accent; }
                                }
                            }
                            VerticalLayout {
                                padding-left: 40px;
                                padding-right: 40px;
                                spacing: 12px;
                                if root.seerr-title.tagline != "" : Text { text: root.seerr-title.tagline; color: Palette.text; font-size: 18px; font-weight: 700; wrap: word-wrap; }
                                if root.seerr-title.overview != "" : Text { text: root.seerr-title.overview; color: Palette.muted; font-size: 15px; wrap: word-wrap; }
                                if root.seerr-title.genres != "" : Text { text: root.seerr-title.genres; color: Palette.muted; font-size: 13px; }
                                if root.seerr-title.saga-id != "" : ChoiceCard {
                                    title: @tr("PART OF THE SAGA");
                                    subtitle: root.seerr-title.saga-name;
                                    icon: @image-url("icons/movie.svg");
                                    clicked => { root.seerr-open-saga(); }
                                }
                                if root.seerr-cast.length > 0 : Text { text: @tr("Cast"); color: Palette.text; font-size: 20px; font-weight: 700; }
                                if root.seerr-cast.length > 0 : CastRow { people: root.seerr-cast; }
                            }
                        }
                    }

                    // A saga: its films with their state; each opens its page.
                    if root.page == Page.seerrsaga : ScrollView {
                        VerticalLayout {
                            padding: 40px;
                            padding-top: 28px;
                            spacing: 14px;
                            alignment: start;
                            PageTitle { title: root.seerr-saga.title; subtitle: root.seerr-saga.meta; }
                            if root.seerr-saga.overview != "" : Text { text: root.seerr-saga.overview; color: Palette.muted; wrap: word-wrap; }
                            parts := Rectangle {
                                property <int> cols: max(1, floor((self.width - 10px) / 176px));
                                height: ceil(root.seerr-parts.length / self.cols) * 312px;
                                for c[i] in root.seerr-parts : PosterCard {
                                    x: mod(i, parts.cols) * 176px;
                                    y: floor(i / parts.cols) * 312px;
                                    card: c;
                                    clicked => { root.seerr-open(c.id); }
                                }
                            }
                        }
                    }

                    // A ListView, not a ScrollView: only the visible rows exist (the list can hold
                    // a thousand titles, past the software renderer's 16-bit coordinates).
                    if root.page == Page.leaving : VerticalLayout {
                        padding: 40px;
                        padding-top: 28px;
                        padding-bottom: 0;
                        spacing: 10px;
                        PageTitle { title: @tr("Leaving soon"); subtitle: @tr("What the server will delete, soonest first. Keep what you want to watch or love. Everyone's choices count and the longest one wins."); }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            padding-bottom: 8px;
                            Button { label: @tr("Go through them one by one"); primary: true; has-icon: true; icon: @image-url("icons/favorite.svg"); clicked => { root.go(Page.triage); } }
                            if root.keep-admin : Button { label: @tr("Admin"); has-icon: true; icon: @image-url("icons/settings.svg"); clicked => { root.go(Page.keepadmin); } }
                        }
                        if root.leaving.length == 0 : Text { text: @tr("Nothing is leaving. Nothing to do."); color: Palette.muted; }
                        ListView {
                            vertical-stretch: 1;
                            changed content-y => { root.leaving-scrolled(-self.content-y / 118px); }
                            for row in root.leaving : Rectangle {
                                height: (root.leaving-open == row.key ? 164px : 108px) + 10px;
                                Rectangle {
                                y: 0;
                                height: parent.height - 10px;
                                background: root.leaving-open == row.key ? Palette.surface-high : Palette.surface;
                                border-radius: 18px;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 10px;
                                    Focusable {
                                        height: 88px;
                                        clicked => { root.leaving-open = root.leaving-open == row.key ? "" : row.key; }
                                        HorizontalLayout {
                                            spacing: 14px;
                                            Rectangle {
                                                width: 58px;
                                                border-radius: 10px;
                                                clip: true;
                                                background: Palette.surface-high;
                                                Image { source: row.poster; width: parent.width; height: parent.height; image-fit: cover; }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                Text { text: row.title; color: Palette.text; font-size: 16px; font-weight: 700; overflow: elide; }
                                                HorizontalLayout {
                                                    alignment: start;
                                                    Badge { label: row.when; tone: row.urgent ? Palette.danger : Palette.surface-high; }
                                                }
                                                if row.vote != "" || row.others != "" : Text {
                                                    text: row.vote + (row.vote != "" && row.others != "" ? " · " : "") + row.others;
                                                    color: row.voted ? Palette.accent : Palette.muted;
                                                    font-size: 12px;
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Icon { source: @image-url("icons/chevron_right.svg"); tint: Palette.subtle; y: (parent.height - self.height) / 2; }
                                        }
                                    }
                                    if root.leaving-open == row.key : KeepChoices {
                                        key: row.key;
                                        voted: row.voted;
                                        vote(k, c) => { root.keep-vote(k, c); }
                                    }
                                }
                                }
                            }
                        }
                    }

                    if root.page == Page.together : ScrollView {
                        VerticalLayout {
                            padding: 40px;
                            padding-top: 28px;
                            spacing: 10px;
                            alignment: start;
                            PageTitle { title: @tr("Together"); subtitle: @tr("Your rooms and your invitations. Rooms are private: only the people invited see them."); }
                            HorizontalLayout {
                                spacing: 14px;
                                alignment: start;
                                Button { label: @tr("New room"); primary: true; has-icon: true; icon: @image-url("icons/add.svg"); clicked => { root.together-new(); } }
                                Text { text: @tr("Invite people first, choose what to watch afterwards."); color: Palette.muted; vertical-alignment: center; }
                            }
                            if root.together-status != "" : Text { text: root.together-status; color: Palette.muted; font-size: 16px; wrap: word-wrap; }
                            for room in root.together-rooms : Focusable {
                                height: 128px;
                                background: self.active ? Palette.surface-high : Palette.surface;
                                border-radius: 18px;
                                clicked => { root.together-open(room.code); }
                                HorizontalLayout {
                                    padding: 10px;
                                    spacing: 16px;
                                    Rectangle {
                                        width: 72px;
                                        border-radius: 10px;
                                        clip: true;
                                        background: Palette.surface-high;
                                        Image { source: room.poster; width: parent.width; height: parent.height; image-fit: cover; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            UserAvatar { avatar: room.host-avatar; size: 24px; }
                                            Text { text: room.people; color: room.invited ? Palette.accent : Palette.muted; font-size: 14px; font-weight: room.invited ? 700 : 400; vertical-alignment: center; overflow: elide; }
                                        }
                                        Text { text: room.title; color: Palette.text; font-size: 18px; font-weight: 700; overflow: elide; }
                                        Text { text: room.status; color: Palette.subtle; font-size: 13px; overflow: elide; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button {
                                        label: room.invited ? @tr("Join") : @tr("Open");
                                        primary: true;
                                        y: (parent.height - self.height) / 2;
                                        clicked => { root.together-open(room.code); }
                                    }
                                    if room.invited : Button {
                                        label: @tr("Not now");
                                        y: (parent.height - self.height) / 2;
                                        clicked => { root.together-decline(room.code); }
                                    }
                                }
                            }
                        }
                    }

                    // A watch together room: the lobby before the start, the room behind the
                    // player after it.
                    if root.page == Page.room : ScrollView {
                        VerticalLayout {
                            padding: 40px;
                            padding-top: 28px;
                            spacing: 22px;
                            alignment: start;
                            HorizontalLayout {
                                spacing: 24px;
                                Rectangle {
                                    width: 120px;
                                    height: 180px;
                                    border-radius: 14px;
                                    clip: true;
                                    background: Palette.surface;
                                    Image { source: root.room-poster; width: parent.width; height: parent.height; image-fit: cover; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text { text: @tr("WATCH TOGETHER"); color: Palette.subtle; font-size: 11px; font-weight: 800; letter-spacing: 1px; }
                                    Text { text: root.room-title; color: Palette.text; font-size: 32px; font-weight: 800; letter-spacing: -0.5px; wrap: word-wrap; }
                                    Text { text: root.room-status; color: Palette.muted; font-size: 15px; wrap: word-wrap; }
                                    Rectangle { height: 4px; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        if root.room-is-host && !root.room-started && root.room-untitled : Button {
                                            label: @tr("Choose what to watch");
                                            primary: true;
                                            autofocus: true;
                                            has-icon: true;
                                            icon: @image-url("icons/video_library.svg");
                                            clicked => { root.go(Page.home); }
                                        }
                                        if root.room-is-host && !root.room-started && !root.room-untitled : Button {
                                            label: @tr("Start watching");
                                            primary: true;
                                            autofocus: true;
                                            has-icon: true;
                                            icon: @image-url("icons/play_arrow_fill1.svg");
                                            clicked => { root.room-start(); }
                                        }
                                        if root.room-started : Button {
                                            label: @tr("Back to the video");
                                            primary: true;
                                            has-icon: true;
                                            icon: @image-url("icons/play_arrow_fill1.svg");
                                            clicked => { root.room-play(); }
                                        }
                                        if root.room-is-host : Button {
                                            label: @tr("Invite");
                                            has-icon: true;
                                            icon: @image-url("icons/add.svg");
                                            clicked => { root.room-invite(); }
                                        }
                                        Button { label: @tr("Leave"); clicked => { root.room-leave(); } }
                                    }
                                    if !root.room-is-host && !root.room-started && !root.room-untitled : Text {
                                        text: @tr("Waiting for {} to start", root.room-host-name);
                                        color: Palette.accent;
                                        font-weight: 700;
                                    }
                                }
                            }
                            if root.room-message != "" : Text { text: root.room-message; color: Palette.danger; wrap: word-wrap; }
                            Group {
                                title: @tr("IN THE ROOM");
                                for m in root.room-members : PersonLine { person: m; }
                            }
                            Group {
                                title: @tr("INVITED");
                                if root.room-invited.length == 0 : Text {
                                    text: root.room-is-host ? @tr("Nobody yet. Invite people: they join directly, no code needed.") : @tr("Nobody is waiting to join.");
                                    color: Palette.muted;
                                    wrap: word-wrap;
                                }
                                for p in root.room-invited : HorizontalLayout {
                                    spacing: 10px;
                                    PersonLine { person: p; }
                                    if root.room-is-host : Button { label: @tr("Remove"); y: (parent.height - self.height) / 2; clicked => { root.room-uninvite(p.key); } }
                                }
                            }
                        }
                    }

                    if root.page == Page.triage : FocusScope {
                        key-pressed(e) => {
                            if (e.text == Key.LeftArrow) { root.triage-vote("dontcare"); return accept; }
                            if (e.text == Key.RightArrow) { root.triage-vote("watched"); return accept; }
                            if (e.text == Key.UpArrow) { root.triage-vote("love"); return accept; }
                            return reject;
                        }
                        init => { self.focus(); }
                        Rectangle {
                            background: @radial-gradient(circle, #ffb22440 0%, #09090c00 65%);
                            VerticalLayout {
                                padding: 32px;
                                spacing: 14px;
                                alignment: start;
                                Text { text: @tr("One by one"); color: Palette.text; font-size: 30px; font-weight: 800; horizontal-alignment: center; }
                                if root.triage-left == 0 : Text { text: @tr("Nothing left to sort. Thanks!"); color: Palette.muted; horizontal-alignment: center; }
                                if root.triage-left > 0 : Text {
                                    text: @tr("{n} left  ·  ← fine to delete   → keep until I watch it   ↑ keep forever" | "{n} left  ·  ← fine to delete   → keep until I watch it   ↑ keep forever" % root.triage-left);
                                    color: Palette.subtle;
                                    horizontal-alignment: center;
                                }
                                if root.triage-left > 0 : HorizontalLayout {
                                    alignment: center;
                                    spacing: 32px;
                                    Rectangle {
                                        width: 280px;
                                        height: 420px;
                                        border-radius: 18px;
                                        clip: true;
                                        background: Palette.surface-high;
                                        Image { source: root.triage-card.poster; width: parent.width; height: parent.height; image-fit: cover; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 12px;
                                        width: 320px;
                                        Text { text: root.triage-card.title; color: Palette.text; font-size: 28px; font-weight: 800; wrap: word-wrap; }
                                        HorizontalLayout { alignment: start; Badge { label: root.triage-card.when; tone: root.triage-card.urgent ? Palette.danger : Palette.surface-high; } }
                                        Rectangle { height: 6px; }
                                        HorizontalLayout { alignment: start; Button { label: @tr("Until I watch it"); primary: true; has-icon: true; icon: @image-url("icons/schedule.svg"); clicked => { root.triage-vote("watched"); } } }
                                        HorizontalLayout { alignment: start; Button { label: @tr("Forever"); has-icon: true; icon: @image-url("icons/favorite.svg"); clicked => { root.triage-vote("love"); } } }
                                        HorizontalLayout { alignment: start; Button { label: @tr("Keep 30 days"); clicked => { root.triage-vote("days30"); } } }
                                        HorizontalLayout { alignment: start; Button { label: @tr("Fine to delete"); has-icon: true; icon: @image-url("icons/close.svg"); clicked => { root.triage-vote("dontcare"); } } }
                                    }
                                }
                            }
                        }
                    }

                    if root.page == Page.keepadmin : ScrollView {
                        VerticalLayout {
                            padding: 40px;
                            padding-top: 28px;
                            spacing: 20px;
                            alignment: start;
                            PageTitle { title: @tr("Admin"); subtitle: @tr("Leaving soon: countdown and people's rights"); }
                            Group {
                                title: @tr("START COUNTDOWN");
                                Text {
                                    text: @tr("Every item is already past its date. Before activating a collection in Maintainerr, restart its countdown so people get the full delay to vote. This changes deletion dates in Maintainerr. Click twice to confirm.");
                                    color: Palette.muted;
                                    wrap: word-wrap;
                                }
                                for c in root.admin-collections : HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: c.title; color: Palette.text; font-weight: 700; vertical-alignment: center; min-width: 200px; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button { label: @tr("Restart now"); clicked => { root.admin-countdown(c.id, 0); } }
                                    Button { label: @tr("Spread over 14 days"); clicked => { root.admin-countdown(c.id, 14); } }
                                    Button { label: @tr("Spread over 30 days"); clicked => { root.admin-countdown(c.id, 30); } }
                                }
                            }
                            Group {
                                title: @tr("PEOPLE");
                                for u in root.admin-users : VerticalLayout {
                                    spacing: 6px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        UserAvatar { avatar: u.avatar; size: 32px; }
                                        Text { text: u.name + "  ·  " + u.detail; color: Palette.text; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Button { label: u.forever; clicked => { root.admin-rights(u.key, "forever"); } }
                                        Button { label: u.max-forever; clicked => { root.admin-rights(u.key, "max-forever"); } }
                                        Button { label: u.max-days; clicked => { root.admin-rights(u.key, "max-days"); } }
                                        if u.seerr != "" : Button { label: u.seerr; clicked => { root.admin-seerr-open = root.admin-seerr-open == u.key ? "" : u.key; } }
                                    }
                                    if root.admin-seerr-open == u.key : VerticalLayout {
                                        spacing: 4px;
                                        Text { text: @tr("Their requests go to this Seerr user:"); color: Palette.muted; font-size: 13px; }
                                        for su in root.admin-seerr-users : HorizontalLayout {
                                            alignment: start;
                                            Button { label: su.title; primary: su.id == u.seerr-id; clicked => { root.admin-seerr-open = ""; root.admin-seerr(u.key, su.id); } }
                                        }
                                    }
                                }
                            }
                            Group {
                                title: @tr("KEPT FOREVER");
                                Text { text: root.forever-summary; color: Palette.muted; wrap: word-wrap; }
                                for p in root.forever-people : VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        UserAvatar { avatar: p.avatar; size: 28px; }
                                        Text { text: p.title; color: Palette.text; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    }
                                    Text { text: p.detail; color: Palette.muted; font-size: 13px; wrap: word-wrap; }
                                    Rectangle {
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Palette.surface-high;
                                        Rectangle {
                                            x: 0;
                                            width: parent.width * max(0, p.shared);
                                            border-radius: 3px;
                                            background: Palette.accent;
                                        }
                                    }
                                }
                                if root.forever-titles.length > 0 : Text { text: @tr("Titles"); color: Palette.text; font-weight: 700; }
                                for t in root.forever-titles : HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: t.title; color: Palette.text; min-width: 260px; }
                                    Text { text: t.detail; color: Palette.muted; wrap: word-wrap; horizontal-stretch: 1; }
                                }
                            }
                        }
                    }

                    if root.page == Page.historycopy : ScrollView {
                        VerticalLayout {
                            padding: 40px;
                            padding-top: 28px;
                            spacing: 18px;
                            alignment: start;
                            PageTitle { title: @tr("Copy watch history"); }
                            Text {
                                text: @tr("Marks what you watched on one server as watched on the other, and copies where you stopped. It only adds: nothing gets unmarked, and a resume point never goes back.");
                                color: Palette.muted;
                                wrap: word-wrap;
                            }
                            if root.history-from.length < 2 : Text { text: @tr("Sign in to both servers first: Settings → Servers → Add a server."); color: Palette.muted; }
                            if root.history-from.length >= 2 : Group {
                                title: @tr("FROM");
                                for c in root.history-from : AccountChoiceRow { choice: c; clicked => { root.history-pick("from", c.id); } }
                            }
                            if root.history-from.length >= 2 : Group {
                                title: @tr("TO");
                                for c in root.history-to : AccountChoiceRow { choice: c; clicked => { root.history-pick("to", c.id); } }
                            }
                            if root.history-state == "running" : VerticalLayout {
                                spacing: 10px;
                                Text { text: root.history-step; color: Palette.text; font-weight: 700; }
                                if root.history-progress >= 0 : Progress { value: root.history-progress; }
                                if root.history-progress < 0 : Progress { value: 0.05; }
                                Text { text: @tr("You can use the rest of the app meanwhile: this page shows where it is when you come back."); color: Palette.muted; font-size: 13px; wrap: word-wrap; }
                            }
                            if root.history-from.length >= 2 && root.history-state == "idle" : HorizontalLayout {
                                alignment: start;
                                Button { label: @tr("Check what will change"); primary: true; has-icon: true; icon: @image-url("icons/search.svg"); clicked => { root.history-check(); } }
                            }
                            if root.history-summary != "" : Text { text: root.history-summary; color: Palette.text; font-size: 18px; font-weight: 700; wrap: word-wrap; }
                            if root.history-detail != "" : Text { text: root.history-detail; color: Palette.muted; wrap: word-wrap; }
                            if root.history-state == "plan" && root.history-copy-label != "" : HorizontalLayout {
                                alignment: start;
                                Button { label: root.history-copy-label; primary: true; has-icon: true; icon: @image-url("icons/check.svg"); clicked => { root.history-copy(); } }
                            }
                            if root.history-state == "done" : HorizontalLayout {
                                alignment: start;
                                Button { label: @tr("Check again"); clicked => { root.history-check(); } }
                            }
                            if root.history-missing != "" && root.history-state != "running" : HorizontalLayout {
                                alignment: start;
                                Button { label: root.history-show-missing ? @tr("Hide missing titles") : @tr("Show missing titles"); clicked => { root.history-toggle-missing(); } }
                            }
                            if root.history-missing != "" && root.history-show-missing && root.history-state != "running" : Text { text: root.history-missing; color: Palette.muted; font-size: 13px; wrap: word-wrap; }
                            if root.history-error != "" : Text { text: root.history-error; color: Palette.danger; wrap: word-wrap; }
                        }
                    }

                    if root.page == Page.settings || root.page == Page.profiles : HorizontalLayout {
                        // The sections, the same on every platform (docs/settings.md).
                        VerticalLayout {
                            width: 270px;
                            padding: 40px;
                            padding-top: 28px;
                            padding-right: 0px;
                            spacing: 4px;
                            alignment: start;
                            PageTitle { title: @tr("Settings"); }
                            Rectangle { height: 14px; }
                                    NavItem { label: @tr("Account"); icon: @image-url("icons/person.svg"); selected: root.shown-section == "account"; clicked => { root.settings-section = "account"; if (root.page != Page.settings) { root.go(Page.settings); } } }
                                    NavItem { label: @tr("Servers"); icon: @image-url("icons/video_library.svg"); selected: root.shown-section == "servers"; clicked => { root.settings-section = "servers"; if (root.page != Page.settings) { root.go(Page.settings); } } }
                                    NavItem { label: @tr("Requests"); icon: @image-url("icons/add.svg"); selected: root.shown-section == "requests"; clicked => { root.settings-section = "requests"; if (root.page != Page.settings) { root.go(Page.settings); } } }
                                    NavItem { label: @tr("Playback"); icon: @image-url("icons/play_arrow_fill1.svg"); selected: root.shown-section == "playback"; clicked => { root.settings-section = "playback"; if (root.page != Page.settings) { root.go(Page.settings); } } }
                                    NavItem { label: @tr("Audio & subtitles"); icon: @image-url("icons/subtitles.svg"); selected: root.shown-section == "audio"; clicked => { root.settings-section = "audio"; if (root.page != Page.settings) { root.go(Page.settings); } } }
                                    NavItem { label: @tr("This device"); icon: @image-url("icons/info.svg"); selected: root.shown-section == "device"; clicked => { root.settings-section = "device"; if (root.page != Page.settings) { root.go(Page.settings); } } }
                                    if root.keep-admin : NavItem { label: @tr("Admin"); icon: @image-url("icons/settings.svg"); selected: root.shown-section == "admin"; clicked => { root.settings-section = "admin"; root.admin-open(); if (root.page != Page.settings) { root.go(Page.settings); } } }
                        }
                        ScrollView {
                        VerticalLayout {
                            padding: 40px;
                            padding-top: 96px;
                            spacing: 22px;
                            alignment: start;
                            if root.shown-section == "account" : VerticalLayout {
                                spacing: 22px;
                                alignment: start;
                            // A profile with AlwyWatch: how others see me (from the server).
                            if root.keep-active : Group {
                                title: @tr("HOW OTHERS SEE YOU");
                                HorizontalLayout {
                                    spacing: 14px;
                                    UserAvatar { avatar: root.me-avatar; size: 56px; y: (parent.height - self.height) / 2; }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text { text: root.me-loaded ? root.me-name : "…"; color: Palette.text; font-size: 17px; font-weight: 700; overflow: elide; }
                                        Text { text: root.me-detail; color: Palette.muted; font-size: 12px; wrap: word-wrap; }
                                        if root.me-also != "" : Text { text: root.me-also; color: Palette.muted; font-size: 12px; wrap: word-wrap; }
                                    }
                                    if root.me-loaded : Button { label: @tr("Change name"); y: (parent.height - self.height) / 2; clicked => { root.account-dialog-open("name"); } }
                                    if root.me-loaded && root.me-name-custom : Button { label: @tr("Reset"); y: (parent.height - self.height) / 2; clicked => { root.account-name-reset(); } }
                                    if root.me-loaded : Button { label: @tr("Change picture"); y: (parent.height - self.height) / 2; clicked => { root.account-dialog-open("avatar"); } }
                                }
                                if root.me-message != "" : Text { text: root.me-message; color: Palette.danger; wrap: word-wrap; }
                            }
                            // A profile without AlwyWatch (or an account without a login yet):
                            // the profile's own name on this computer.
                            if !root.keep-active : Group {
                                title: @tr("HOW OTHERS SEE YOU");
                                HorizontalLayout {
                                    spacing: 14px;
                                    Avatar { initial: root.profile-me.initial; tone: root.profile-me.tone; size: 56px; y: (parent.height - self.height) / 2; }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text { text: root.profile-me.name; color: Palette.text; font-size: 17px; font-weight: 700; overflow: elide; }
                                        Text { text: @tr("The name of this profile on this computer."); color: Palette.muted; font-size: 12px; wrap: word-wrap; }
                                    }
                                    Button { label: @tr("Change name"); y: (parent.height - self.height) / 2; clicked => { root.profile-dialog-open("rename", root.profile-me.id); } }
                                }
                            }
                            if root.alwy-on : Group {
                                title: @tr("ALWYWATCH");
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text { text: @tr("AlwyWatch server"); color: Palette.text; font-weight: 700; }
                                        Text {
                                            text: root.alwy-state == "ok" ? @tr("{} · Connected", root.alwy-address)
                                                : root.alwy-state == "offline" ? @tr("{} · Can't reach", root.alwy-address)
                                                : root.alwy-state == "expired" ? @tr("{} · Sign-in expired", root.alwy-address)
                                                : root.alwy-address;
                                            color: root.alwy-state == "ok" || root.alwy-state == "" ? Palette.muted : Palette.danger;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                        if root.keep-active : Text { text: root.keep-label; color: Palette.muted; font-size: 12px; wrap: word-wrap; }
                                    }
                                    if root.keep-active && !root.address-edit : Button { label: @tr("Change address"); y: (parent.height - self.height) / 2; clicked => { root.address-edit = true; } }
                                }
                                if root.address-edit : HorizontalLayout {
                                    spacing: 10px;
                                    kurl := Field { placeholder: @tr("AlwyWatch server address"); accepted(t) => { root.address-edit = false; root.keep-connect(t); } }
                                    Button { label: @tr("Connect"); primary: true; y: (parent.height - self.height) / 2; clicked => { root.address-edit = false; root.keep-connect(kurl.text); } }
                                    Button { label: @tr("Cancel"); y: (parent.height - self.height) / 2; clicked => { root.address-edit = false; } }
                                }
                                if root.alwy-account != "" : HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text { text: @tr("Password & passkeys"); color: Palette.text; font-weight: 700; }
                                        Text { text: @tr("Signed in to the account of {}. Password, passkeys, devices and deleting the account: on the AlwyWatch website.", root.alwy-account); color: Palette.muted; font-size: 12px; wrap: word-wrap; }
                                    }
                                    Button { label: @tr("Open the website"); y: (parent.height - self.height) / 2; clicked => { root.account-manage(); } }
                                }
                                if root.links.length > 1 || root.link-candidates.length > 0 : VerticalLayout {
                                    spacing: 10px;
                                    Rectangle { height: 1px; background: Palette.outline; }
                                    Text { text: @tr("Linked logins"); color: Palette.text; font-weight: 700; }
                                    Text {
                                        text: root.links.length > 1 ? @tr("These logins are one AlwyWatch account: same name, picture, keep choices and watch-together rooms.")
                                            : @tr("Another login on this computer may be you too. Linking makes them one AlwyWatch account.");
                                        color: Palette.muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                    for l in root.links : HorizontalLayout {
                                        spacing: 12px;
                                        ServerMark { server: l.server; y: (parent.height - self.height) / 2; }
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Text { text: l.title; color: Palette.text; font-weight: 700; overflow: elide; }
                                            Text { text: l.detail; color: Palette.muted; font-size: 12px; overflow: elide; }
                                        }
                                        if l.main : Badge { label: @tr("MAIN"); tone: Palette.accent; fg: #000; y: (parent.height - self.height) / 2; }
                                        if l.here : Badge { label: @tr("THIS COMPUTER"); tone: Palette.surface-high; y: (parent.height - self.height) / 2; }
                                        if !l.main : Button { label: @tr("Unlink"); y: (parent.height - self.height) / 2; clicked => { root.unlink-ask(l.key); } }
                                    }
                                    if root.link-candidates.length > 0 : Text { text: @tr("Link another login"); color: Palette.subtle; font-size: 11px; font-weight: 800; letter-spacing: 1px; }
                                    for c in root.link-candidates : HorizontalLayout {
                                        spacing: 10px;
                                        Text { text: c.title; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                        Button { label: @tr("Link…"); clicked => { root.link-ask(c.id); } }
                                    }
                                }
                                Rectangle { height: 1px; background: Palette.outline; }
                                if !root.signout-ask : HorizontalLayout {
                                    alignment: start;
                                    Button { label: @tr("Sign out of AlwyWatch"); clicked => { root.signout-ask = true; } }
                                }
                                if root.signout-ask : VerticalLayout {
                                    spacing: 10px;
                                    Text { text: @tr("Sign out of AlwyWatch?"); color: Palette.text; font-weight: 700; }
                                    Text {
                                        text: @tr("This profile keeps its Jellyfin and Plex logins and becomes a profile without an AlwyWatch account: Leaving soon and watch together disappear from it. Your keep choices stay on the server.");
                                        color: Palette.muted;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        Button { label: @tr("Sign out"); primary: true; clicked => { root.signout-ask = false; root.alwywatch-sign-out(); } }
                                        Button { label: @tr("Cancel"); clicked => { root.signout-ask = false; } }
                                    }
                                }
                            }
                            if !root.alwy-on : Group {
                                title: @tr("CONNECT TO ALWYWATCH");
                                Text {
                                    text: @tr("With an AlwyWatch account your name, settings and servers come with you, and you get Leaving soon, requests and watch together. Your Jellyfin and Plex logins stay.");
                                    color: Palette.muted;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Button { label: @tr("Sign in"); primary: true; clicked => { root.alwy-connect(false); } }
                                    Button { label: @tr("Create an account"); clicked => { root.alwy-connect(true); } }
                                }
                            }
                            }
                            if root.shown-section == "servers" : VerticalLayout {
                                spacing: 22px;
                                alignment: start;
                            Group {
                                title: @tr("YOUR JELLYFIN AND PLEX SERVERS");
                                for a in root.accounts : HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        Text { text: a.label; color: Palette.text; font-weight: 700; }
                                        Text { text: a.detail; color: Palette.muted; font-size: 12px; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    if !a.current : Button { label: @tr("Switch to this one"); clicked => { root.use-account(a.id); } }
                                    if a.current : Text { text: @tr("Showing now"); color: Palette.muted; vertical-alignment: center; }
                                    Button {
                                        label: root.remove-armed == a.id ? @tr("Click again to sign out") : @tr("Sign out");
                                        clicked => {
                                            if (root.remove-armed == a.id) { root.remove-armed = ""; root.remove-account(a.id); } else { root.remove-armed = a.id; }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 10px;
                                    Button { label: @tr("Add a server"); has-icon: true; icon: @image-url("icons/add.svg"); clicked => { root.go(Page.add); } }
                                    if root.accounts.length >= 2 : Button { label: @tr("Copy watch history"); has-icon: true; icon: @image-url("icons/schedule.svg"); clicked => { root.go(Page.historycopy); } }
                                }
                                if root.keep-active : Text { text: @tr("AlwyWatch follows the login showing now when its server is on your AlwyWatch server."); color: Palette.muted; font-size: 12px; wrap: word-wrap; }
                            }
                            }
                            if root.shown-section == "requests" : VerticalLayout {
                                spacing: 22px;
                                alignment: start;
                            if root.keep-active && root.seerr-bridge-offered : Group {
                                title: @tr("THROUGH YOUR ALWYWATCH SERVER");
                                SettingToggle {
                                    title: @tr("Request through your AlwyWatch server");
                                    subtitle: root.seerr-via-keep ? @tr("Through your AlwyWatch server, as {}", root.seerr-label) : @tr("No other sign-in needed.");
                                    on: root.seerr-via-keep;
                                    clicked => { if (root.seerr-via-keep) { root.seerr-disconnect(); } else { root.seerr-bridge(); } }
                                }
                            }
                            if root.keep-active && !root.seerr-bridge-offered : Text {
                                text: @tr("Your AlwyWatch server doesn't take requests. Ask its owner, or use a request site address below.");
                                color: Palette.muted;
                                wrap: word-wrap;
                            }
                            if !root.seerr-via-keep : Group {
                                title: @tr("REQUEST SITE");
                                if root.seerr-active : HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: root.seerr-label; color: Palette.text; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button { label: @tr("Sign out"); clicked => { root.seerr-disconnect(); } }
                                }
                                if !root.seerr-active && root.seerr-step == "url" : VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        surl := Field { placeholder: @tr("Request site address (Seerr, Overseerr, Jellyseerr)"); accepted(t) => { root.seerr-url(t); } }
                                        Button { label: @tr("Connect"); primary: !root.keep-active || !root.seerr-bridge-offered; y: (parent.height - self.height) / 2; clicked => { root.seerr-url(surl.text); } }
                                    }
                                    Text { text: @tr("It only accepts the logins it's set up for (Plex or Jellyfin)."); color: Palette.muted; font-size: 12px; wrap: word-wrap; }
                                }
                                if !root.seerr-active && root.seerr-step == "choose" : HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    for l in root.seerr-logins : Button { label: l.title; primary: true; clicked => { root.seerr-login(l.id); } }
                                }
                                if !root.seerr-active && root.seerr-step == "plex" : Text {
                                    text: @tr("Finish signing in to Plex in your browser…");
                                    color: Palette.muted;
                                }
                                if !root.seerr-active && (root.seerr-step == "jellyfin" || root.seerr-step == "local") : VerticalLayout {
                                    spacing: 8px;
                                    if root.seerr-code != "" : Text { text: @tr("Quick Connect code: {}", root.seerr-code); color: Palette.text; font-size: 20px; font-weight: 800; }
                                    su := Field { placeholder: root.seerr-step == "local" ? @tr("Email") : @tr("Username"); }
                                    sp := Field { placeholder: @tr("Password"); input-type: password; accepted => { root.seerr-password(su.text, sp.text); } }
                                    HorizontalLayout { alignment: start; Button { label: @tr("Sign in"); primary: true; clicked => { root.seerr-password(su.text, sp.text); } } }
                                }
                            }
                            if root.seerr-message != "" && root.page == Page.settings : Text { text: root.seerr-message; color: Palette.danger; wrap: word-wrap; }
                            }
                            if root.shown-section == "playback" : VerticalLayout {
                                spacing: 22px;
                                alignment: start;
                            Group {
                                title: @tr("PLAYBACK");
                                SettingToggle {
                                    title: @tr("Audio passthrough");
                                    subtitle: @tr("Send Dolby/DTS untouched to an HDMI or S/PDIF receiver. This device only.");
                                    on: root.spdif;
                                    clicked => { root.toggle-spdif(); }
                                }
                                SettingToggle {
                                    title: @tr("Skip intros automatically");
                                    subtitle: @tr("Otherwise a Skip intro button appears.");
                                    on: root.auto-skip-intro;
                                    clicked => { root.toggle-setting("player.auto_skip_intro"); }
                                }
                                SettingToggle {
                                    title: @tr("Play the next episode automatically");
                                    subtitle: @tr("A 10 second countdown during the credits, which Keep watching cancels. Off: playback stops at the end of the episode.");
                                    on: root.auto-next;
                                    clicked => { root.toggle-setting("player.auto_next"); }
                                }
                            }
                            if root.keep-active : Group {
                                title: @tr("WATCH TOGETHER");
                                Text {
                                    text: @tr("In rooms you create, what the others may do. You can always do everything.");
                                    color: Palette.muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                SettingToggle {
                                    title: @tr("Others can change what's playing");
                                    subtitle: @tr("Next episode, another title.");
                                    on: root.together-title;
                                    clicked => { root.toggle-setting("together.others_title"); }
                                }
                                SettingToggle {
                                    title: @tr("Others can pause and play");
                                    subtitle: "";
                                    on: root.together-play;
                                    clicked => { root.toggle-setting("together.others_play"); }
                                }
                                SettingToggle {
                                    title: @tr("Others can move forward or back");
                                    subtitle: "";
                                    on: root.together-seek;
                                    clicked => { root.toggle-setting("together.others_seek"); }
                                }
                            }
                            }
                            if root.shown-section == "audio" : VerticalLayout {
                                spacing: 22px;
                                alignment: start;
                            Group {
                                title: @tr("LANGUAGES");
                                SettingChoice { title: @tr("Audio language"); subtitle: ""; value: root.audio-lang-label; clicked => { root.cycle-setting("player.audio_lang"); } }
                                SettingChoice { title: @tr("Subtitles"); subtitle: @tr("Automatic: when the audio is not in your subtitle language."); value: root.sub-mode-label; clicked => { root.cycle-setting("player.sub_mode"); } }
                                SettingChoice { title: @tr("Subtitle language"); subtitle: ""; value: root.sub-lang-label; clicked => { root.cycle-setting("player.sub_lang"); } }
                                Text { text: @tr("A movie or show remembers the tracks picked for it while watching, and its next episodes follow."); color: Palette.muted; font-size: 12px; wrap: word-wrap; }
                            }
                            }
                            if root.shown-section == "device" : VerticalLayout {
                                spacing: 22px;
                                alignment: start;
                            Group {
                                title: @tr("PROFILES");
                                Text {
                                    text: @tr("A profile is one person on this computer, with their own servers, history and settings. Downloads are shared.");
                                    color: Palette.muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                for p in root.profiles : HorizontalLayout {
                                    spacing: 12px;
                                    Avatar { initial: p.initial; tone: p.tone; size: 40px; y: (parent.height - self.height) / 2; }
                                    VerticalLayout {
                                        alignment: center;
                                        Text { text: p.name; color: Palette.text; font-weight: 700; }
                                        if p.has-pin : Text { text: @tr("Protected by a PIN"); color: Palette.muted; font-size: 12px; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    if p.current : Text { text: @tr("In use"); color: Palette.muted; vertical-alignment: center; }
                                    if p.current : Button { label: @tr("Rename"); y: (parent.height - self.height) / 2; clicked => { root.profile-dialog-open("rename", p.id); } }
                                    if p.current : Button { label: p.has-pin ? @tr("Change PIN") : @tr("Set a PIN"); y: (parent.height - self.height) / 2; clicked => { root.profile-dialog-open("pin", p.id); } }
                                    if !p.current : Button { label: @tr("Switch"); y: (parent.height - self.height) / 2; clicked => { root.profile-open(p.id); } }
                                    if p.removable : IconButton { icon: @image-url("icons/delete.svg"); tip: @tr("Remove profile"); clicked => { root.profile-dialog-open("remove", p.id); } }
                                }
                                HorizontalLayout { alignment: start; Button { label: @tr("Add a profile"); has-icon: true; icon: @image-url("icons/add.svg"); clicked => { root.profile-dialog-open("add", ""); } } }
                                if root.profiles.length > 1 : SettingToggle {
                                    title: @tr("Skip “Who's watching?” at startup");
                                    subtitle: @tr("Open the last profile used instead of asking who's watching (a PIN is still asked)");
                                    on: root.profile-auto;
                                    clicked => { root.profile-auto-toggle(); }
                                }
                            }
                            if root.alwy-on : Group {
                                title: @tr("SIGN IN ANOTHER DEVICE");
                                if root.send-step == "" : HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: @tr("Signs a new phone, TV or computer in to this profile: its AlwyWatch account, logins and settings."); color: Palette.muted; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                                    Button { label: @tr("Sign in another device"); y: (parent.height - self.height) / 2; clicked => { root.send-start(); } }
                                }
                                if root.send-step == "code" : VerticalLayout {
                                    spacing: 10px;
                                    Text { text: @tr("On the new device, choose \"Sign in with a code\" and type its code here."); color: Palette.muted; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        scode := Field { placeholder: "123456"; accepted(t) => { root.send-lookup(t); } }
                                        Button { label: @tr("Continue"); primary: true; y: (parent.height - self.height) / 2; clicked => { root.send-lookup(scode.text); } }
                                        Button { label: @tr("Cancel"); y: (parent.height - self.height) / 2; clicked => { root.send-cancel(); } }
                                    }
                                }
                                if root.send-step == "confirm" : VerticalLayout {
                                    spacing: 8px;
                                    Text { text: @tr("Send your accounts and settings to “{}”?", root.send-device); color: Palette.text; font-weight: 700; wrap: word-wrap; }
                                    Text { text: @tr("Check number"); color: Palette.muted; font-size: 13px; }
                                    Text { text: root.send-check; color: Palette.accent; font-size: 40px; font-weight: 800; letter-spacing: 4px; }
                                    Text { text: @tr("Only send if the new device shows the same number."); color: Palette.muted; font-size: 13px; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        Button { label: @tr("Send"); primary: true; clicked => { root.send-confirm(); } }
                                        Button { label: @tr("Cancel"); clicked => { root.send-cancel(); } }
                                    }
                                }
                                if root.send-step == "sent" : HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: @tr("Sent. The other device signs in by itself."); color: Palette.accent; vertical-alignment: center; }
                                    Button { label: @tr("Done"); clicked => { root.send-cancel(); } }
                                }
                                if root.send-error != "" && root.send-step != "" : Text { text: root.send-error; color: Palette.danger; wrap: word-wrap; }
                            }
                            Group {
                                title: @tr("LANGUAGE");
                                SettingChoice { title: @tr("Language"); subtitle: ""; value: root.language-label; clicked => { root.cycle-language(); } }
                            }
                            Group {
                                title: @tr("STORAGE");
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: @tr("Image cache"); color: Palette.text; font-weight: 700; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: root.cache-size; color: Palette.muted; vertical-alignment: center; }
                                    Button { label: @tr("Clear"); clicked => { root.clear-cache(); } }
                                }
                            }
                            Group {
                                title: @tr("ABOUT");
                                Text { text: root.about; color: Palette.text; }
                                Text { text: @tr("Free software under the GNU AGPL v3 or later."); color: Palette.muted; font-size: 12px; }
                            }
                            }
                            if root.shown-section == "admin" : VerticalLayout {
                                spacing: 22px;
                                alignment: start;
                            Group {
                                title: @tr("LEAVING SOON AND PEOPLE");
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: @tr("People and their rights, who they request as, the Leaving soon countdown and what is kept forever."); color: Palette.muted; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                                    Button { label: @tr("Open"); y: (parent.height - self.height) / 2; clicked => { root.go(Page.keepadmin); } }
                                }
                            }
                            Group {
                                title: @tr("ALWYWATCH SERVER");
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text { text: @tr("Server settings"); color: Palette.text; font-weight: 700; }
                                        Text { text: @tr("Media servers, Seerr, Maintainerr, Tautulli, email and sign-up are set up in the web app."); color: Palette.muted; font-size: 12px; wrap: word-wrap; }
                                    }
                                    Button { label: @tr("Open"); y: (parent.height - self.height) / 2; clicked => { root.open-server-settings(); } }
                                }
                            }
                            Group {
                                title: @tr("INVITE SOMEONE");
                                Text { text: @tr("A new person gets an AlwyWatch account, and a Jellyfin login if you like."); color: Palette.muted; font-size: 12px; wrap: word-wrap; }
                                if root.invite-mail : VerticalLayout {
                                    spacing: 4px;
                                    Field { placeholder: @tr("Email (optional)"); text <=> root.invite-email; }
                                    Text {
                                        text: root.invite-email == "" ? @tr("Empty: you get a link and a code to send them yourself.") : @tr("AlwyWatch emails them a link that works once.");
                                        color: Palette.muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                                if !root.invite-mail && root.invites-loaded : HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text { text: @tr("Set up email in Server settings to send invitations by email"); color: Palette.text; font-weight: 700; wrap: word-wrap; }
                                        Text { text: @tr("For now, you get a link and a code to send them yourself."); color: Palette.muted; font-size: 12px; wrap: word-wrap; }
                                    }
                                    Button { label: @tr("Server settings"); y: (parent.height - self.height) / 2; clicked => { root.open-server-settings(); } }
                                }
                                if root.invite-server != "" : SettingToggle {
                                    title: @tr("Also make a Jellyfin login on {}", root.invite-server);
                                    subtitle: @tr("Same username and password as their AlwyWatch account");
                                    on: root.invite-jellyfin;
                                    clicked => { root.invite-jellyfin = !root.invite-jellyfin; }
                                }
                                if root.invite-server != "" && root.invite-jellyfin && root.invite-server-many : SettingChoice {
                                    title: @tr("Jellyfin server");
                                    subtitle: "";
                                    value: root.invite-server;
                                    clicked => { root.invite-next-server(); }
                                }
                                if root.invite-server != "" && root.invite-jellyfin : SettingChoice {
                                    title: @tr("With the same access as");
                                    subtitle: @tr("Libraries, parental rating and permissions are copied from this user");
                                    value: root.invite-like;
                                    clicked => { root.invite-next-like(); }
                                }
                                if root.invite-emailing : Field { placeholder: @tr("Personal note (optional): a few words in the email"); text <=> root.invite-note; }
                                SettingChoice {
                                    title: @tr("Valid for");
                                    subtitle: "";
                                    value: @tr("{n} day" | "{n} days" % root.invite-days);
                                    clicked => { root.invite-days = root.invite-days == 1 ? 7 : root.invite-days == 7 ? 30 : 1; }
                                }
                                if !root.invite-emailing : SettingChoice {
                                    title: @tr("How many people");
                                    subtitle: "";
                                    value: @tr("{n} person" | "{n} people" % root.invite-uses);
                                    clicked => { root.invite-uses = root.invite-uses == 1 ? 5 : root.invite-uses == 5 ? 10 : 1; }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    Button {
                                        label: root.invite-busy ? (root.invite-emailing ? @tr("Sending…") : @tr("Creating…")) : (root.invite-emailing ? @tr("Send invitation") : @tr("Create link"));
                                        primary: true;
                                        clicked => { if (!root.invite-busy) { root.admin-invite(); } }
                                    }
                                }
                                if root.invite-sent-to != "" : Text { text: @tr("Sent to {}", root.invite-sent-to); color: Palette.accent; font-size: 17px; font-weight: 700; wrap: word-wrap; }
                                if root.invite-made-code != "" : VerticalLayout {
                                    spacing: 6px;
                                    Text { text: @tr("Invitation code"); color: Palette.muted; font-size: 13px; }
                                    Text { text: root.invite-made-code; color: Palette.accent; font-size: 28px; font-weight: 800; letter-spacing: 2px; }
                                    if root.invite-made-link != "" : Text { text: @tr("Or the link"); color: Palette.muted; font-size: 13px; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 40px;
                                            clip: true;
                                            copied := TextInput {
                                                width: parent.width;
                                                height: parent.height;
                                                text: root.invite-made-link != "" ? root.invite-made-link : root.invite-made-code;
                                                read-only: true;
                                                single-line: true;
                                                color: Palette.text;
                                                font-size: 15px;
                                                vertical-alignment: center;
                                                selection-background-color: #ffb22466;
                                            }
                                        }
                                        Button {
                                            label: root.invite-copied ? @tr("Copied") : @tr("Copy");
                                            clicked => {
                                                copied.select-all();
                                                copied.copy();
                                                copied.clear-selection();
                                                root.invite-copied = true;
                                            }
                                        }
                                    }
                                    if root.invite-made-hint != "" : Text { text: root.invite-made-hint; color: Palette.muted; font-size: 12px; wrap: word-wrap; }
                                }
                                if root.invite-made-message != "" : Text { text: root.invite-made-message; color: Palette.danger; wrap: word-wrap; }
                            }
                            Group {
                                title: @tr("INVITATIONS");
                                if root.invites.length == 0 && root.invites-message == "" : Text {
                                    text: root.invites-loaded ? @tr("None yet.") : @tr("Loading…");
                                    color: Palette.subtle;
                                }
                                for i in root.invites : VerticalLayout {
                                    spacing: 6px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Text { text: i.title; color: i.active ? Palette.text : Palette.muted; font-weight: 700; overflow: elide; }
                                            Text { text: i.detail; color: Palette.muted; font-size: 12px; wrap: word-wrap; }
                                        }
                                        if i.active && root.invite-ending != i.id : Button { label: @tr("End"); y: (parent.height - self.height) / 2; clicked => { root.invite-ending = i.id; } }
                                    }
                                    if root.invite-ending == i.id : HorizontalLayout {
                                        spacing: 10px;
                                        Text { text: @tr("Its code and link stop working. Accounts already made with it stay."); color: Palette.muted; font-size: 13px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                                        Button { label: @tr("End"); primary: true; y: (parent.height - self.height) / 2; clicked => { root.invite-end(i.id); root.invite-ending = ""; } }
                                        Button { label: @tr("Cancel"); y: (parent.height - self.height) / 2; clicked => { root.invite-ending = ""; } }
                                    }
                                }
                                if root.invites-message != "" : Text { text: root.invites-message; color: Palette.danger; wrap: word-wrap; }
                            }
                            Group {
                                title: @tr("SERVER STATUS");
                                if root.admin-dry-run : Text { text: @tr("Test mode: nothing is changed in Maintainerr or Seerr. Turn it off in Server settings (web app)."); color: Palette.accent; font-weight: 700; wrap: word-wrap; }
                                for s in root.admin-status : VerticalLayout {
                                    spacing: 2px;
                                    Text { text: s.title; color: Palette.text; font-weight: 700; }
                                    Text { text: s.text; color: s.ok ? Palette.muted : Palette.danger; font-size: 13px; wrap: word-wrap; }
                                }
                                if root.admin-status-message != "" : Text { text: root.admin-status-message; color: Palette.danger; wrap: word-wrap; }
                                Text { text: @tr("Read only: change these in Server settings (web app)."); color: Palette.subtle; font-size: 12px; wrap: word-wrap; }
                                HorizontalLayout { alignment: start; Button { label: @tr("Check again"); clicked => { root.admin-open(); } } }
                            }
                            }
                        }
                        }
                    }
                }
            }
        }
    }
    // Inviting people to the room: recent partners first, multi-select, one call.
    // My name and avatar: edit the name, change the avatar, and the one-time welcome step.
    if root.account-dialog != "" : Rectangle {
        width: root.width;
        height: root.height;
        background: #000000b0;
        TouchArea { }
        FocusScope {
            init => { if root.account-dialog == "avatar" { self.focus(); } }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    if (root.account-dialog == "welcome") { root.welcome-skip(); } else { root.account-dialog-close(); }
                    return accept;
                }
                if (e.text == Key.RightArrow || e.text == Key.DownArrow) { root.move-focus(true); return accept; }
                if (e.text == Key.LeftArrow || e.text == Key.UpArrow) { root.move-focus(false); return accept; }
                return reject;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(600px, root.width - 48px);
                height: ad.preferred-height;
                border-radius: 22px;
                background: #1d1d24;
                ad := VerticalLayout {
                    padding: 28px;
                    spacing: 14px;
                    Text {
                        text: root.account-dialog == "welcome" ? @tr("Welcome! This is how others see you")
                            : root.account-dialog == "name" ? @tr("Your name") : @tr("Your avatar");
                        color: Palette.text;
                        font-size: 22px;
                        font-weight: 800;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.account-dialog == "welcome" ? @tr("People you watch with see this name and avatar. You can change them later in Settings.")
                            : root.account-dialog == "name" ? @tr("Shown to the people you watch with, instead of your name on {}.", root.me-media-name)
                            : @tr("Pick one, or use a picture of your own.");
                        color: Palette.muted;
                        wrap: word-wrap;
                    }
                    if root.account-dialog == "welcome" : HorizontalLayout {
                        spacing: 16px;
                        UserAvatar { avatar: root.welcome-avatar; size: 72px; }
                        Field {
                            y: (parent.height - self.height) / 2;
                            text <=> root.account-name-input;
                            autofocus: true;
                            placeholder: @tr("Your name");
                            edited(t) => { root.account-name-edited(t); }
                            accepted => { root.welcome-continue(); }
                        }
                    }
                    if root.account-dialog == "name" : Field {
                        text <=> root.account-name-input;
                        autofocus: true;
                        placeholder: @tr("Your name");
                        edited(t) => { root.account-name-edited(t); }
                        accepted => { root.account-name-save(); }
                    }
                    if root.account-dialog != "avatar" && root.account-name-problem != "" : Text { text: root.account-name-problem; color: Palette.danger; wrap: word-wrap; }
                    if root.account-dialog != "name" : HorizontalLayout {
                        alignment: center;
                        AvatarGrid { presets: root.account-presets; picked(id) => { root.account-preset(id); } }
                    }
                    if root.account-dialog != "name" : HorizontalLayout {
                        alignment: start;
                        spacing: 10px;
                        Button { label: @tr("Upload a picture"); has-icon: true; icon: @image-url("icons/add.svg"); clicked => { root.account-upload(); } }
                        if root.account-dialog == "avatar" && root.me-has-avatar : Button { label: @tr("Remove"); clicked => { root.account-remove-avatar(); } }
                    }
                    if root.account-message != "" : Text { text: root.account-message; color: Palette.danger; wrap: word-wrap; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;
                        if root.account-dialog == "name" && root.me-name-custom : Button { label: @tr("Reset to {}", root.me-media-name); clicked => { root.account-name-reset(); } }
                        if root.account-dialog == "name" : Button { label: @tr("Cancel"); clicked => { root.account-dialog-close(); } }
                        if root.account-dialog == "name" : Button { label: root.account-busy ? @tr("Saving…") : @tr("Save"); primary: true; clicked => { root.account-name-save(); } }
                        if root.account-dialog == "avatar" : Button { label: @tr("Done"); primary: true; clicked => { root.account-dialog-close(); } }
                        if root.account-dialog == "welcome" : Button { label: @tr("Skip"); clicked => { root.welcome-skip(); } }
                        if root.account-dialog == "welcome" : Button { label: root.account-busy ? @tr("Saving…") : @tr("Continue"); primary: true; clicked => { root.welcome-continue(); } }
                    }
                }
            }
        }
    }
    // "Are these both you?" (Link focused first) and the unlink confirmation (Cancel focused).
    if root.link-dialog != "" : Rectangle {
        width: root.width;
        height: root.height;
        background: #000000b0;
        TouchArea { }
        FocusScope {
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.link-dialog-close(); return accept; }
                if (e.text == Key.RightArrow || e.text == Key.DownArrow) { root.move-focus(true); return accept; }
                if (e.text == Key.LeftArrow || e.text == Key.UpArrow) { root.move-focus(false); return accept; }
                return reject;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(560px, root.width - 48px);
                height: ld.preferred-height;
                border-radius: 22px;
                background: #1d1d24;
                ld := VerticalLayout {
                    padding: 28px;
                    spacing: 14px;
                    Text {
                        text: root.link-dialog == "ask" ? @tr("Are these both you?") : @tr("Unlink this sign-in?");
                        color: Palette.text;
                        font-size: 22px;
                        font-weight: 800;
                        wrap: word-wrap;
                    }
                    if root.link-dialog == "ask" : Rectangle {
                        border-radius: 16px;
                        background: Palette.surface;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 12px;
                            PersonLine { person: root.link-a; size: 48px; }
                            PersonLine { person: root.link-b; size: 48px; }
                        }
                    }
                    if root.link-dialog == "ask" : Text {
                        text: @tr("Use one AlwyWatch account for both: the same name, picture, keep choices and watch-together rooms everywhere you sign in with either. Only link sign-ins that are really yours.");
                        color: Palette.muted;
                        wrap: word-wrap;
                    }
                    if root.link-dialog == "ask" : Text {
                        text: @tr("This can't be undone as such: unlinking later gives that sign-in a fresh, empty account.");
                        color: Palette.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    if root.link-dialog == "unlink" : Text { text: root.unlink-question; color: Palette.muted; wrap: word-wrap; }
                    if root.link-message != "" : Text { text: root.link-message; color: Palette.danger; wrap: word-wrap; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;
                        if root.link-dialog == "ask" : Button { label: root.link-prompted ? @tr("Not now") : @tr("Cancel"); clicked => { root.link-dialog-close(); } }
                        if root.link-dialog == "ask" : Button { label: root.link-busy ? @tr("Linking…") : @tr("Link"); primary: true; autofocus: true; clicked => { root.link-confirm(); } }
                        if root.link-dialog == "unlink" : Button { label: @tr("Cancel"); autofocus: true; clicked => { root.link-dialog-close(); } }
                        if root.link-dialog == "unlink" : Button { label: root.link-busy ? @tr("Unlinking…") : @tr("Unlink"); clicked => { root.unlink-confirm(); } }
                    }
                }
            }
        }
    }
    // Cropping an uploaded picture: move and zoom it under the round frame.
    if root.crop-open : Rectangle {
        width: root.width;
        height: root.height;
        background: #000000c8;
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.crop-cancel(); return accept; }
                if (e.text == Key.LeftArrow) { root.crop-drag(-12, 0); return accept; }
                if (e.text == Key.RightArrow) { root.crop-drag(12, 0); return accept; }
                if (e.text == Key.UpArrow) { root.crop-drag(0, -12); return accept; }
                if (e.text == Key.DownArrow) { root.crop-drag(0, 12); return accept; }
                if (e.text == "+" || e.text == "=") { root.crop-zoom-by(1); return accept; }
                if (e.text == "-") { root.crop-zoom-by(-1); return accept; }
                if (e.text == Key.Return) { root.crop-save(); return accept; }
                return reject;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(440px, root.width - 32px);
                height: cd.preferred-height;
                border-radius: 22px;
                background: #1d1d24;
                cd := VerticalLayout {
                    padding: 28px;
                    spacing: 14px;
                    Text { text: @tr("Move and zoom"); color: Palette.text; font-size: 22px; font-weight: 800; }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 360px;
                            height: 360px;
                            clip: true;
                            background: #000;
                            Image { source: root.crop-image; x: root.crop-x; y: root.crop-y; width: root.crop-w; height: root.crop-h; image-fit: fill; }
                            // Dims what stays outside the round frame, then draws the frame.
                            Image { source: root.crop-mask; width: 360px; height: 360px; }
                            Rectangle {
                                x: 30px;
                                y: 30px;
                                width: 300px;
                                height: 300px;
                                border-radius: 150px;
                                border-width: 2px;
                                border-color: #ffffff;
                            }
                            TouchArea {
                                property <length> lx;
                                property <length> ly;
                                mouse-cursor: move;
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down) {
                                        self.lx = self.mouse-x;
                                        self.ly = self.mouse-y;
                                    }
                                }
                                moved => {
                                    if (self.pressed) {
                                        root.crop-drag((self.mouse-x - self.lx) / 1px, (self.mouse-y - self.ly) / 1px);
                                        self.lx = self.mouse-x;
                                        self.ly = self.mouse-y;
                                    }
                                }
                                scroll-event(e) => {
                                    if (e.delta-y > 0) { root.crop-zoom-by(1); } else if (e.delta-y < 0) { root.crop-zoom-by(-1); }
                                    return accept;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: @tr("Zoom"); color: Palette.muted; vertical-alignment: center; }
                        Slider {
                            horizontal-stretch: 1;
                            minimum: 1;
                            maximum: root.crop-zoom-max;
                            value <=> root.crop-zoom;
                            changed(v) => { root.crop-set-zoom(v); }
                        }
                    }
                    Text { text: @tr("Drag or use the arrow keys to move · wheel, slider or + and − to zoom"); color: Palette.subtle; font-size: 12px; wrap: word-wrap; }
                    if root.crop-message != "" : Text { text: root.crop-message; color: Palette.danger; wrap: word-wrap; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;
                        Button { label: @tr("Cancel"); clicked => { root.crop-cancel(); } }
                        Button { label: root.crop-busy ? @tr("Saving…") : @tr("Save"); primary: true; clicked => { root.crop-save(); } }
                    }
                }
            }
        }
    }
    // An invitation just arrived: a banner over whatever page is open (not blocking).
    if root.invite-code != "" : Rectangle {
        x: (root.width - self.width) / 2;
        y: 16px;
        width: min(680px, root.width - 32px);
        height: 76px;
        border-radius: 20px;
        background: #1d1d24;
        border-width: 1px;
        border-color: Palette.accent;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000a0;
        HorizontalLayout {
            padding: 14px;
            spacing: 12px;
            UserAvatar { avatar: root.invite-avatar; size: 44px; y: (parent.height - self.height) / 2; }
            Text { text: root.invite-text; color: Palette.text; font-weight: 700; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; overflow: elide; }
            Button { label: @tr("Join"); primary: true; y: (parent.height - self.height) / 2; clicked => { root.invite-join(); } }
            Button { label: @tr("Not now"); y: (parent.height - self.height) / 2; clicked => { root.invite-decline(); } }
            IconButton { icon: @image-url("icons/close.svg"); y: (parent.height - self.height) / 2; clicked => { root.invite-dismiss(); } }
        }
    }
    // Marking a season or a show unwatched forgets progress: asked first (Cancel focused).
    if root.mark-confirm != "" : Rectangle {
        width: root.width;
        height: root.height;
        background: #000000b0;
        TouchArea { }
        FocusScope {
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.mark-confirm-cancel(); return accept; }
                if (e.text == Key.RightArrow || e.text == Key.DownArrow) { root.move-focus(true); return accept; }
                if (e.text == Key.LeftArrow || e.text == Key.UpArrow) { root.move-focus(false); return accept; }
                return reject;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(480px, root.width - 48px);
                height: md.preferred-height;
                border-radius: 22px;
                background: #1d1d24;
                md := VerticalLayout {
                    padding: 28px;
                    spacing: 14px;
                    Text { text: root.mark-confirm; color: Palette.text; font-size: 18px; font-weight: 700; wrap: word-wrap; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;
                        Button { label: @tr("Cancel"); autofocus: true; clicked => { root.mark-confirm-cancel(); } }
                        Button { label: @tr("Mark unwatched"); clicked => { root.mark-confirm-ok(); } }
                    }
                }
            }
        }
    }
    // Profiles: add, rename, PIN, switch (PIN) and remove, over the page.
    if root.profile-dialog != "" : Rectangle {
        width: root.width;
        height: root.height;
        background: #000000b0;
        TouchArea { }
        FocusScope {
            // No field to type in (remove): the dialog takes the keyboard, for Escape.
            init => { if root.profile-dialog == "remove" { self.focus(); } }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.profile-cancel(); return accept; }
                return reject;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(480px, root.width - 48px);
                height: pd.preferred-height;
                border-radius: 22px;
                background: Palette.surface-high;
                pd := VerticalLayout {
                    padding: 28px;
                    spacing: 14px;
                    Text {
                        text: root.profile-dialog == "add" ? @tr("New profile")
                            : root.profile-dialog == "rename" ? @tr("Rename")
                            : root.profile-dialog == "pin" ? (root.profile-target.has-pin ? @tr("PIN for {}", root.profile-target.name) : @tr("Protect {} with a PIN", root.profile-target.name))
                            : root.profile-dialog == "switch" ? @tr("Switch to {}", root.profile-target.name)
                            : @tr("Remove {}?", root.profile-target.name);
                        color: Palette.text;
                        font-size: 22px;
                        font-weight: 800;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.profile-dialog == "add" ? @tr("A profile is one person on this computer. Next you choose how they sign in: with an AlwyWatch account, or with Jellyfin or Plex only.")
                            : root.profile-dialog == "pin" ? @tr("Asked when opening this profile.")
                            : root.profile-dialog == "switch" ? @tr("PIN for {}", root.profile-target.name)
                            : root.profile-dialog == "remove" ? @tr("Their servers, history and settings on this computer are deleted. Downloads only they wanted are deleted too.")
                            : "";
                        color: Palette.muted;
                        wrap: word-wrap;
                    }
                    if root.profile-dialog != "remove" : Field {
                        text <=> root.profile-input;
                        autofocus: true;
                        placeholder: root.profile-dialog == "add" || root.profile-dialog == "rename" ? @tr("Name")
                            : root.profile-dialog == "pin" ? (root.profile-target.has-pin ? @tr("New 4-digit PIN") : @tr("4-digit PIN"))
                            : "••••";
                        input-type: root.profile-dialog == "add" || root.profile-dialog == "rename" ? InputType.text : InputType.password;
                        accepted => { root.profile-submit(); }
                        edited(t) => { root.profile-edited(t); }
                    }
                    if root.profile-message != "" : Text { text: root.profile-message; color: Palette.danger; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;
                        if root.profile-dialog == "pin" && root.profile-target.has-pin : Button { label: @tr("Remove PIN"); clicked => { root.profile-pin-remove(); } }
                        Button { label: @tr("Cancel"); clicked => { root.profile-cancel(); } }
                        Button {
                            label: root.profile-dialog == "add" ? @tr("Create and switch")
                                : root.profile-dialog == "switch" ? @tr("Switch")
                                : root.profile-dialog == "remove" ? @tr("Remove")
                                : @tr("Save");
                            primary: true;
                            clicked => { root.profile-submit(); }
                        }
                    }
                }
            }
        }
    }
    // Before the app: "Who's watching?" when the computer has several profiles, or the PIN of
    // the profile when it has one.
    if root.profile-gate : Rectangle {
        width: root.width;
        height: root.height;
        background: Palette.bg;
        TouchArea { }
        FocusScope {
            key-pressed(e) => {
                if (e.text == Key.Escape && (root.profile-gate-back || root.profile-gate-menu)) { root.profile-cancel(); return accept; }
                if (e.text == Key.RightArrow || e.text == Key.DownArrow) { root.move-focus(true); return accept; }
                if (e.text == Key.LeftArrow || e.text == Key.UpArrow) { root.move-focus(false); return accept; }
                return reject;
            }
            VerticalLayout {
                padding: 24px;
                spacing: 28px;
                alignment: center;
                if root.profile-target.id == "" && root.profile-gate-menu : HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Button { label: @tr("Manage profiles"); clicked => { root.profile-cancel(); root.go(Page.profiles); } }
                    Button { label: @tr("Close"); clicked => { root.profile-cancel(); } }
                }
                if root.profile-target.id == "" : Text { text: @tr("Who's watching?"); color: Palette.text; font-size: 40px; font-weight: 800; letter-spacing: -0.5px; horizontal-alignment: center; }
                if root.profile-target.id == "" : HorizontalLayout {
                    alignment: center;
                    spacing: 20px;
                    for p[i] in root.profiles : ProfileTile { profile: p; autofocus: i == 0; clicked => { root.profile-open(p.id); } }
                }
                if root.profile-target.id != "" : HorizontalLayout { alignment: center; Avatar { initial: root.profile-target.initial; tone: root.profile-target.tone; size: 96px; } }
                if root.profile-target.id != "" : Text { text: @tr("PIN for {}", root.profile-target.name); color: Palette.text; font-size: 24px; font-weight: 700; horizontal-alignment: center; }
                if root.profile-target.id != "" : HorizontalLayout {
                    alignment: center;
                    Field {
                        width: 220px;
                        text <=> root.profile-input;
                        autofocus: true;
                        placeholder: "••••";
                        input-type: InputType.password;
                        accepted => { root.profile-submit(); }
                        edited(t) => { root.profile-edited(t); }
                    }
                }
                if root.profile-target.id != "" && root.profile-message != "" : Text { text: root.profile-message; color: Palette.danger; horizontal-alignment: center; }
                if root.profile-target.id != "" && root.profile-gate-back : HorizontalLayout { alignment: center; Button { label: @tr("Back"); clicked => { root.profile-cancel(); } } }
            }
        }
    }
    if root.player-on : PlayerOverlay {
        width: root.width;
        height: root.height;
        title: root.player-title;
        pos: root.player-pos;
        dur: root.player-dur;
        cache: root.player-cache;
        paused: root.player-paused;
        skip: root.player-skip;
        countdown: root.player-countdown;
        note: root.player-note;
        has-next: root.player-has-next;
        has-previous: root.player-has-previous;
        audio: root.player-audio;
        subtitles: root.player-subtitles;
        near-end: root.player-near-end;
        ends-at: root.player-ends-at;
        room-label: root.player-room-label;
        fullscreen: root.player-fullscreen;
        can-together: root.player-can-together && !root.player-room;
        cmd(c, a) => { root.player-cmd(c, a); }
    }
    if root.player-on && root.player-room : Rectangle {
        width: root.width;
        height: root.height;
        background: #000000a0;
        TouchArea { }
        FocusScope {
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.player-room-cancel(); return accept; }
                return reject;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(520px, parent.width - 32px);
                height: card.preferred-height;
                border-radius: 18px;
                background: Palette.bg;
                card := VerticalLayout {
                    padding: 24px;
                    spacing: 14px;
                    Text { text: @tr("WATCH TOGETHER"); color: Palette.subtle; font-size: 11px; font-weight: 800; letter-spacing: 1px; }
                    Text { text: root.room-title == "" ? @tr("Opening a room…") : root.room-title; color: Palette.text; font-size: 24px; font-weight: 800; wrap: word-wrap; }
                    Text {
                        text: @tr("Paused for now. Invite people, then start: everyone starts at {} at the same moment, once all of them have loaded it.", root.player-room-at);
                        color: Palette.muted;
                        wrap: word-wrap;
                    }
                    for m in root.room-members : PersonLine { person: m; }
                    for p in root.room-invited : PersonLine { person: p; }
                    if root.room-message != "" : Text { text: root.room-message; color: Palette.danger; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Button {
                            label: @tr("Invite people");
                            autofocus: true;
                            primary: root.room-invited.length == 0 && root.room-members.length < 2;
                            has-icon: true;
                            icon: @image-url("icons/add.svg");
                            clicked => { root.room-invite(); }
                        }
                        Button {
                            label: @tr("Start at {}", root.player-room-at);
                            primary: root.room-invited.length > 0 || root.room-members.length > 1;
                            has-icon: true;
                            icon: @image-url("icons/play_arrow_fill1.svg");
                            clicked => { root.player-room-start(); }
                        }
                        Button { label: @tr("Cancel"); clicked => { root.player-room-cancel(); } }
                    }
                }
            }
        }
    }
    if root.room-picker : Rectangle {
        width: root.width;
        height: root.height;
        background: #000000b0;
        TouchArea { }
        FocusScope {
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.picker-cancel(); return accept; }
                if (e.text == Key.DownArrow) { root.move-focus(true); return accept; }
                if (e.text == Key.UpArrow) { root.move-focus(false); return accept; }
                return reject;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(560px, root.width - 48px);
                height: min(680px, root.height - 48px);
                border-radius: 22px;
                background: #1d1d24;
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    Text { text: @tr("Invite people"); color: Palette.text; font-size: 22px; font-weight: 800; }
                    Text { text: @tr("They get an invitation and join directly."); color: Palette.muted; wrap: word-wrap; }
                    Field {
                        text <=> root.picker-filter-text;
                        autofocus: true;
                        placeholder: @tr("Search by name");
                        edited(t) => { root.picker-filter(t); }
                    }
                    if root.picker-message != "" : Text { text: root.picker-message; color: Palette.muted; wrap: word-wrap; }
                    psv := ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            for p in root.picker-people : VerticalLayout {
                                spacing: 2px;
                                if p.header != "" : Text { text: p.header; color: Palette.subtle; font-size: 11px; font-weight: 800; letter-spacing: 1px; height: 28px; vertical-alignment: bottom; }
                                prow := Focusable {
                                    height: 56px;
                                    border-radius: 12px;
                                    background: self.active ? Palette.surface : (p.selected ? #ffb2241f : transparent);
                                    clicked => { root.picker-toggle(p.key); }
                                    focused => {
                                        if (parent.y + self.y + psv.content-y < 0) { psv.content-y = -(parent.y + self.y); }
                                        if (parent.y + self.y + self.height + psv.content-y > psv.visible-height) { psv.content-y = psv.visible-height - parent.y - self.y - self.height; }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        PersonLine { person: p; }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 12px;
                                            border-width: 2px;
                                            border-color: p.selected ? Palette.accent : Palette.subtle;
                                            background: p.selected ? Palette.accent : transparent;
                                            if p.selected : Icon { source: @image-url("icons/check.svg"); tint: #000; width: 16px; height: 16px; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;
                        Button { label: @tr("Cancel"); clicked => { root.picker-cancel(); } }
                        Button {
                            label: root.picker-count == 0 ? @tr("Send invitations") : @tr("Send {n} invitation" | "Send {n} invitations" % root.picker-count);
                            primary: root.picker-count > 0;
                            clicked => { root.picker-send(); }
                        }
                    }
                }
            }
        }
    }
}
