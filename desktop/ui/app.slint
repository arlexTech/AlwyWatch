    property <bool> alwy-on: root.keep-active || root.alwy-account != "";
    property <bool> address-edit;
    property <bool> signout-ask;
    /// The profile in use (its own name and colours, for a profile without AlwyWatch).
    in property <ProfileRow> profile-me;
    // Settings → Requests: the AlwyWatch server takes requests; this profile uses that.
