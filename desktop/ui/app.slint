import { LineEdit, ScrollView, ListView } from "std-widgets.slint";

export struct Card {
    id: string,
    title: string,
    subtitle: string,
    image: image,
    progress: float,
    played: bool,
}

export struct Rail {
    title: string,
    items: [Card],
}

export struct NamedId {
    id: string,
    title: string,
    selected: bool,
}

export struct Detail {
    id: string,
    title: string,
    meta: string,
    overview: string,
    genres: string,
    backdrop: image,
    poster: image,
    playable: bool,
    resumable: bool,
    played: bool,
    is-series: bool,
}

export struct AccountRow {
    id: string,
    label: string,
    detail: string,
    current: bool,
}

export struct DownloadRow {
    id: int,
    account: string,
    item: string,
    title: string,
    status: string,
    progress: float,
    completed: bool,
    active: bool,
}

export struct SeerrPanel {
    open: bool,
    key: string,
    title: string,
    overview: string,
    status: string,
    is-tv: bool,
    can-request: bool,
}

export struct LeavingRow {
    key: string,
    title: string,
    when: string,
    vote: string,
    others: string,
    poster: image,
    urgent: bool,
    voted: bool,
}

export struct AdminRow {
    key: string,
    name: string,
    detail: string,
    forever: string,
    max-forever: string,
    max-days: string,
}

export enum Page { add, home, library, detail, search, settings, downloads, requests, leaving, triage, keepadmin }

export global Palette {
    out property <color> bg: #101114;
    out property <color> surface: #1a1c20;
    out property <color> surface-high: #24272c;
    out property <color> accent: #e5a00d;
    out property <color> text: #e8e8ea;
    out property <color> muted: #9a9ca3;
    out property <color> danger: #e5534b;
}

// A focusable, clickable surface: Enter/Space activate, focus ring always visible.
component Focusable inherits Rectangle {
    in property <bool> primary: false;
    callback clicked();
    callback focused();
    border-radius: 8px;
    border-width: fs.has-focus ? 3px : 0px;
    border-color: Palette.accent;
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-changed-event => { if (self.has-focus) { root.focused(); } }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            fs.focus();
            root.clicked();
        }
    }
    @children
}

component Button inherits Focusable {
    in property <string> label;
    height: 40px;
    min-width: txt.preferred-width + 36px;
    border-radius: 20px;
    background: root.primary ? Palette.accent : Palette.surface-high;
    txt := Text {
        text: root.label;
        color: root.primary ? #000 : Palette.text;
        font-size: 15px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component PosterCard inherits Focusable {
    in property <Card> card;
    width: 150px;
    height: 270px;
    VerticalLayout {
        spacing: 6px;
        Rectangle {
            height: 225px;
            border-radius: 8px;
            clip: true;
            background: Palette.surface-high;
            Image {
                source: root.card.image;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }
            if root.card.progress > 0 : Rectangle {
                y: parent.height - 4px;
                height: 4px;
                width: parent.width * root.card.progress;
                x: 0;
                background: Palette.accent;
            }
            if root.card.played : Rectangle {
                x: parent.width - 30px;
                y: 6px;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Palette.accent;
                Text { text: "✓"; color: #000; }
            }
        }
        Text { text: root.card.title; color: Palette.text; overflow: elide; font-size: 14px; }
        Text { text: root.card.subtitle; color: Palette.muted; overflow: elide; font-size: 12px; }
    }
}

component RailView {
    in property <Rail> rail;
    callback open(string);
    callback hovered(string);
    VerticalLayout {
        spacing: 8px;
        Text { text: root.rail.title; color: Palette.text; font-size: 20px; font-weight: 600; }
        rail := ScrollView {
            height: 290px;
            content-width: root.rail.items.length * 164px + 12px;
            content-height: 284px;
            vertical-scrollbar-policy: always-off;
            for c[i] in root.rail.items : PosterCard {
                x: i * 164px + 6px;
                y: 6px;
                card: c;
                clicked => { root.open(c.id); }
                focused => {
                    // Keep the focused card visible when moving with the keyboard.
                    if (self.x + rail.content-x < 0) { rail.content-x = -self.x + 6px; }
                    if (self.x + self.width + rail.content-x > rail.visible-width) {
                        rail.content-x = rail.visible-width - self.x - self.width - 6px;
                    }
                    root.hovered(c.id);
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "AlwyWatch";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Palette.bg;
    default-font-size: 15px;

    in-out property <Page> page: Page.home;
    in property <string> status;
    in property <string> error;
    in property <bool> can-go-back;
    // Home
    in property <[Rail]> rails;
    in property <[NamedId]> libraries;
    // Library / search grid
    in property <string> grid-title;
    in property <[Card]> grid;
    in property <[NamedId]> sorts;
    // Detail
    in property <Detail> detail;
    in property <[NamedId]> seasons;
    in property <[Card]> episodes;
    // Add server
    in property <string> add-step: "choose"; // choose | jellyfin-url | jellyfin | plex | plex-servers
    in property <string> quick-code;
    in property <string> plex-code;
    in property <[NamedId]> plex-servers;
    // Settings
    in property <[AccountRow]> accounts;
    in property <string> cache-size;
    in property <string> about;
    in-out property <bool> spdif;
    in-out property <string> search-text;
    in property <[DownloadRow]> downloads;
    // Seerr
    in property <bool> seerr-active;
    in property <string> seerr-label;
    in property <string> seerr-step: "url"; // url | choose | plex | jellyfin | local
    in property <[NamedId]> seerr-logins;
    in property <string> seerr-code;
    in property <string> seerr-message;
    in property <[Card]> seerr-results;
    in property <[Card]> seerr-mine;
    in property <SeerrPanel> seerr-panel;
    in property <[NamedId]> seerr-seasons;
    // Keep service
    in property <bool> keep-active;
    in property <bool> keep-admin;
    in property <string> keep-label;
    in property <string> keep-message;
    in property <[LeavingRow]> leaving;
    in-out property <string> leaving-open;
    in property <LeavingRow> triage-card;
    in property <int> triage-left;
    in property <[AdminRow]> admin-users;
    in property <[NamedId]> admin-collections;

    callback back();
    callback move-focus(bool);
    callback open-item(string);
    callback prefetch(string);
    callback open-library(string, string);
    callback set-sort(string);
    callback grid-scrolled(float);
    callback play(string, bool);
    callback toggle-played(string);
    callback select-season(string);
    callback search(string);
    callback go(Page);
    callback add-choose(string);
    callback jellyfin-url(string);
    callback jellyfin-sign-in(string, string);
    callback plex-pick(string);
    callback use-account(string);
    callback remove-account(string);
    callback clear-cache();
    callback toggle-spdif();
    callback download(string);
    callback download-action(int, string); // pause | resume | remove
    callback play-download(string, string); // account, item
    callback seerr-url(string);
    callback seerr-login(string);
    callback seerr-password(string, string);
    callback seerr-disconnect();
    callback seerr-search(string);
    callback seerr-open(string);
    callback seerr-toggle-season(string);
    callback seerr-request(bool); // all seasons?
    callback seerr-close();
    callback keep-connect(string);
    callback keep-disconnect();
    callback keep-vote(string, string); // key, choice
    callback triage-vote(string);       // choice
    callback admin-rights(string, string); // user key, field
    callback admin-countdown(string, int); // collection id, stagger days

    // Arrow keys and Escape not consumed by a focused element end up here.
    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape || (e.text == Key.Backspace && !e.modifiers.control)) {
                if (root.can-go-back) { root.back(); return accept; }
            }
            if (e.text == Key.RightArrow || e.text == Key.DownArrow) { root.move-focus(true); return accept; }
            if (e.text == Key.LeftArrow || e.text == Key.UpArrow) { root.move-focus(false); return accept; }
            return reject;
        }

        VerticalLayout {
            padding: 0;
            // Top bar
            HorizontalLayout {
                padding: 16px;
                spacing: 12px;
                height: 72px;
                if root.can-go-back : Button { label: "←"; clicked => { root.back(); } }
                Text {
                    text: "AlwyWatch";
                    color: Palette.text;
                    font-size: 24px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.page != Page.add : Button { label: "Search"; clicked => { root.go(Page.search); } }
                if root.page != Page.add && root.keep-active : Button { label: "Leaving soon"; clicked => { root.go(Page.leaving); } }
                if root.page != Page.add && root.seerr-active : Button { label: "Requests"; clicked => { root.go(Page.requests); } }
                if root.page != Page.add : Button { label: "Downloads"; clicked => { root.go(Page.downloads); } }
                if root.page != Page.add : Button { label: "Settings"; clicked => { root.go(Page.settings); } }
            }
            if root.keep-message != "" : Rectangle {
                height: 36px;
                background: Palette.surface-high;
                Text { text: root.keep-message; color: Palette.accent; }
            }
            if root.error != "" : Rectangle {
                height: 36px;
                background: Palette.surface-high;
                Text { text: root.error; color: Palette.muted; }
            }

            // Pages
            if root.page == Page.home : ScrollView {
                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 20px;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        for lib in root.libraries : Button {
                            label: lib.title;
                            clicked => { root.open-library(lib.id, lib.title); }
                        }
                    }
                    for rail in root.rails : RailView {
                        rail: rail;
                        open(id) => { root.open-item(id); }
                        hovered(id) => { root.prefetch(id); }
                    }
                    if root.rails.length == 0 : Text { text: root.status; color: Palette.muted; }
                }
            }

            if root.page == Page.library || root.page == Page.search : VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    height: 44px;
                    if root.page == Page.library : Text {
                        text: root.grid-title;
                        color: Palette.text;
                        font-size: 22px;
                        vertical-alignment: center;
                    }
                    if root.page == Page.search : LineEdit {
                        placeholder-text: "Search movies and shows";
                        text <=> root.search-text;
                        edited(t) => { root.search(t); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.page == Page.library : HorizontalLayout {
                        spacing: 8px;
                        for s in root.sorts : Button {
                            label: s.title;
                            primary: s.selected;
                            clicked => { root.set-sort(s.id); }
                        }
                    }
                }
                grid := ScrollView {
                    property <int> cols: max(1, floor((self.visible-width - 10px) / 164px));
                    content-height: ceil(root.grid.length / self.cols) * 290px + 20px;
                    scrolled => {
                        root.grid-scrolled(-self.content-y / max(1px, self.content-height - self.visible-height));
                    }
                    for c[i] in root.grid : PosterCard {
                        x: mod(i, grid.cols) * 164px + 6px;
                        y: floor(i / grid.cols) * 290px + 6px;
                        card: c;
                        clicked => { root.open-item(c.id); }
                        focused => { root.prefetch(c.id); }
                    }
                }
            }

            if root.page == Page.detail : ScrollView {
                VerticalLayout {
                    spacing: 16px;
                    Rectangle {
                        height: 380px;
                        clip: true;
                        Image {
                            source: root.detail.backdrop;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                            opacity: 0.55;
                        }
                        HorizontalLayout {
                            padding: 24px;
                            spacing: 20px;
                            alignment: start;
                            Rectangle {
                                width: 200px;
                                height: 300px;
                                border-radius: 8px;
                                clip: true;
                                background: Palette.surface-high;
                                Image { source: root.detail.poster; width: parent.width; height: parent.height; image-fit: cover; }
                            }
                            VerticalLayout {
                                alignment: end;
                                spacing: 8px;
                                Text { text: root.detail.title; color: Palette.text; font-size: 32px; font-weight: 700; wrap: word-wrap; }
                                Text { text: root.detail.meta; color: Palette.muted; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    if root.detail.playable : Button {
                                        label: root.detail.resumable ? "Resume" : "Play";
                                        primary: true;
                                        clicked => { root.play(root.detail.id, false); }
                                    }
                                    if root.detail.resumable : Button {
                                        label: "From start";
                                        clicked => { root.play(root.detail.id, true); }
                                    }
                                    if root.detail.playable : Button {
                                        label: "Download";
                                        clicked => { root.download(root.detail.id); }
                                    }
                                    Button {
                                        label: root.detail.played ? "Mark unwatched" : "Mark watched";
                                        clicked => { root.toggle-played(root.detail.id); }
                                    }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 10px;
                        Text { text: root.detail.overview; color: Palette.text; wrap: word-wrap; }
                        Text { text: root.detail.genres; color: Palette.muted; }
                        if root.detail.is-series : HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            for s in root.seasons : Button {
                                label: s.title;
                                primary: s.selected;
                                clicked => { root.select-season(s.id); }
                            }
                        }
                        for ep in root.episodes : Focusable {
                            height: 96px;
                            background: Palette.surface;
                            clicked => { root.play(ep.id, false); }
                            focused => { root.prefetch(ep.id); }
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 12px;
                                Rectangle {
                                    width: 142px;
                                    border-radius: 6px;
                                    clip: true;
                                    background: Palette.surface-high;
                                    Image { source: ep.image; width: parent.width; height: parent.height; image-fit: cover; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: ep.title; color: Palette.text; font-size: 16px; overflow: elide; }
                                    Text { text: ep.subtitle; color: Palette.muted; overflow: elide; wrap: word-wrap; }
                                }
                                if ep.played : Text { text: "✓"; color: Palette.accent; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            if root.page == Page.add : VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: start;
                Text { text: "Add a server"; color: Palette.text; font-size: 26px; }
                if root.add-step == "choose" : HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Button { label: "Jellyfin"; primary: true; clicked => { root.add-choose("jellyfin"); } }
                    Button { label: "Plex"; clicked => { root.add-choose("plex"); } }
                }
                if root.add-step == "jellyfin-url" : VerticalLayout {
                    spacing: 12px;
                    url := LineEdit {
                        placeholder-text: "jellyfin.example.org";
                        accepted(t) => { root.jellyfin-url(t); }
                    }
                    HorizontalLayout { alignment: start; Button { label: "Continue"; primary: true; clicked => { root.jellyfin-url(url.text); } } }
                }
                if root.add-step == "jellyfin" : VerticalLayout {
                    spacing: 12px;
                    if root.quick-code != "" : VerticalLayout {
                        spacing: 6px;
                        Text { text: "Quick Connect: in a Jellyfin app where you are signed in, enter"; color: Palette.muted; }
                        Text { text: root.quick-code; color: Palette.text; font-size: 44px; }
                        Text { text: "or sign in with your password:"; color: Palette.muted; }
                    }
                    user := LineEdit { placeholder-text: "Username"; }
                    pass := LineEdit {
                        placeholder-text: "Password";
                        input-type: password;
                        accepted => { root.jellyfin-sign-in(user.text, pass.text); }
                    }
                    HorizontalLayout { alignment: start; Button { label: "Sign in"; primary: true; clicked => { root.jellyfin-sign-in(user.text, pass.text); } } }
                }
                if root.add-step == "plex" : VerticalLayout {
                    spacing: 6px;
                    Text { text: "Finish signing in to Plex in your browser. You can also go to plex.tv/link and enter:"; color: Palette.muted; wrap: word-wrap; }
                    Text { text: root.plex-code; color: Palette.text; font-size: 44px; }
                }
                if root.add-step == "plex-servers" : VerticalLayout {
                    spacing: 8px;
                    Text { text: "Choose a server"; color: Palette.text; font-size: 18px; }
                    for s in root.plex-servers : HorizontalLayout {
                        alignment: start;
                        Button { label: s.title; clicked => { root.plex-pick(s.id); } }
                    }
                }
                if root.add-step != "choose" : HorizontalLayout { alignment: start; Button { label: "Back"; clicked => { root.add-choose(""); } } }
                Text { text: root.status; color: Palette.danger; wrap: word-wrap; }
            }

            if root.page == Page.downloads : ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 10px;
                    alignment: start;
                    Text { text: "Downloads"; color: Palette.text; font-size: 22px; }
                    if root.downloads.length == 0 : Text { text: "Nothing downloaded yet. Use \"Download\" on a movie or an episode."; color: Palette.muted; }
                    for d in root.downloads : Rectangle {
                        background: Palette.surface;
                        border-radius: 8px;
                        height: 104px;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text { text: d.title; color: Palette.text; font-size: 16px; overflow: elide; }
                            Text { text: d.status; color: Palette.muted; font-size: 12px; }
                            Rectangle {
                                height: 4px;
                                background: Palette.surface-high;
                                Rectangle { x: 0; width: parent.width * d.progress; background: Palette.accent; }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                if d.completed : Button { label: "Play"; primary: true; clicked => { root.play-download(d.account, d.item); } }
                                if !d.completed && d.active : Button { label: "Pause"; clicked => { root.download-action(d.id, "pause"); } }
                                if !d.completed && !d.active : Button { label: "Resume"; primary: true; clicked => { root.download-action(d.id, "resume"); } }
                                Button { label: "Delete"; clicked => { root.download-action(d.id, "remove"); } }
                            }
                        }
                    }
                }
            }

            if root.page == Page.requests : ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: start;
                    LineEdit {
                        placeholder-text: "Find a movie or a show to request";
                        edited(t) => { root.seerr-search(t); }
                    }
                    if root.seerr-message != "" : Text { text: root.seerr-message; color: Palette.accent; }
                    if root.seerr-panel.open : Rectangle {
                        background: Palette.surface;
                        border-radius: 8px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Text { text: root.seerr-panel.title; color: Palette.text; font-size: 18px; }
                            Text { text: root.seerr-panel.overview; color: Palette.muted; wrap: word-wrap; }
                            if root.seerr-panel.status != "" : Text { text: root.seerr-panel.status; color: Palette.accent; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                if root.seerr-panel.can-request : Button {
                                    label: root.seerr-panel.is-tv ? "Request all seasons" : "Request";
                                    primary: true;
                                    clicked => { root.seerr-request(true); }
                                }
                                if root.seerr-panel.is-tv : Button { label: "Request selected"; clicked => { root.seerr-request(false); } }
                                Button { label: "Close"; clicked => { root.seerr-close(); } }
                            }
                            if root.seerr-panel.is-tv : HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                for s in root.seerr-seasons : Button {
                                    label: s.title;
                                    primary: s.selected;
                                    clicked => { root.seerr-toggle-season(s.id); }
                                }
                            }
                        }
                    }
                    results := Rectangle {
                        property <int> cols: max(1, floor((self.width - 10px) / 164px));
                        height: ceil(root.seerr-results.length / self.cols) * 290px;
                        for c[i] in root.seerr-results : PosterCard {
                            x: mod(i, results.cols) * 164px;
                            y: floor(i / results.cols) * 290px;
                            card: c;
                            clicked => { root.seerr-open(c.id); }
                        }
                    }
                    if root.seerr-results.length == 0 : Text { text: "My requests"; color: Palette.text; font-size: 20px; }
                    if root.seerr-results.length == 0 : mine := Rectangle {
                        property <int> cols: max(1, floor((self.width - 10px) / 164px));
                        height: ceil(root.seerr-mine.length / self.cols) * 290px;
                        for c[i] in root.seerr-mine : PosterCard {
                            x: mod(i, mine.cols) * 164px;
                            y: floor(i / mine.cols) * 290px;
                            card: c;
                        }
                    }
                }
            }

            if root.page == Page.leaving : ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 8px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Text { text: "Leaving soon"; color: Palette.text; font-size: 22px; vertical-alignment: center; }
                        Button { label: "Sort them out"; primary: true; clicked => { root.go(Page.triage); } }
                        if root.keep-admin : Button { label: "Admin"; clicked => { root.go(Page.keepadmin); } }
                    }
                    Text { text: "What the server will delete, soonest first. Keep what you want to watch or love."; color: Palette.muted; }
                    for row in root.leaving : Rectangle {
                        background: Palette.surface;
                        border-radius: 8px;
                        height: root.leaving-open == row.key ? 150px : 100px;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 8px;
                            Focusable {
                                height: 84px;
                                clicked => { root.leaving-open = root.leaving-open == row.key ? "" : row.key; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Rectangle {
                                        width: 56px;
                                        border-radius: 6px;
                                        clip: true;
                                        background: Palette.surface-high;
                                        Image { source: row.poster; width: parent.width; height: parent.height; image-fit: cover; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Text { text: row.title; color: Palette.text; font-size: 16px; overflow: elide; }
                                        Text { text: row.when; color: row.urgent ? Palette.accent : Palette.muted; }
                                        if row.vote != "" : Text { text: row.vote; color: Palette.muted; font-size: 12px; }
                                        if row.others != "" : Text { text: row.others; color: Palette.muted; font-size: 12px; }
                                    }
                                }
                            }
                            if root.leaving-open == row.key : HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Button { label: "Keep 7 days"; clicked => { root.keep-vote(row.key, "days7"); } }
                                Button { label: "Keep 30 days"; clicked => { root.keep-vote(row.key, "days30"); } }
                                Button { label: "Until I watch it"; primary: true; clicked => { root.keep-vote(row.key, "watched"); } }
                                Button { label: "Forever: love it"; clicked => { root.keep-vote(row.key, "love"); } }
                                Button { label: "Forever: classic"; clicked => { root.keep-vote(row.key, "classic"); } }
                                Button { label: "Don't care"; clicked => { root.keep-vote(row.key, "dontcare"); } }
                                if row.voted : Button { label: "Remove my choice"; clicked => { root.keep-vote(row.key, "remove"); } }
                            }
                        }
                    }
                }
            }

            if root.page == Page.triage : FocusScope {
                key-pressed(e) => {
                    if (e.text == Key.LeftArrow) { root.triage-vote("dontcare"); return accept; }
                    if (e.text == Key.RightArrow) { root.triage-vote("watched"); return accept; }
                    if (e.text == Key.UpArrow) { root.triage-vote("love"); return accept; }
                    return reject;
                }
                init => { self.focus(); }
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: start;
                    Text { text: "Sort them out"; color: Palette.text; font-size: 22px; horizontal-alignment: center; }
                    if root.triage-left == 0 : Text { text: "Nothing left to sort. Thanks!"; color: Palette.muted; horizontal-alignment: center; }
                    if root.triage-left > 0 : VerticalLayout {
                        spacing: 10px;
                        alignment: start;
                        Text {
                            text: root.triage-left + " left · ← don't care   → keep until I watch it   ↑ keep forever";
                            color: Palette.muted;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 260px;
                                height: 390px;
                                border-radius: 12px;
                                clip: true;
                                background: Palette.surface-high;
                                Image { source: root.triage-card.poster; width: parent.width; height: parent.height; image-fit: cover; }
                            }
                        }
                        Text { text: root.triage-card.title; color: Palette.text; font-size: 18px; horizontal-alignment: center; }
                        Text { text: root.triage-card.when; color: Palette.accent; horizontal-alignment: center; }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Button { label: "Don't care"; clicked => { root.triage-vote("dontcare"); } }
                            Button { label: "Keep 30 days"; clicked => { root.triage-vote("days30"); } }
                            Button { label: "Until I watch it"; primary: true; clicked => { root.triage-vote("watched"); } }
                            Button { label: "Forever"; clicked => { root.triage-vote("love"); } }
                        }
                    }
                }
            }

            if root.page == Page.keepadmin : ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 10px;
                    alignment: start;
                    Text { text: "Admin"; color: Palette.text; font-size: 22px; }
                    Text { text: "Start countdown"; color: Palette.text; font-size: 18px; }
                    Text {
                        text: "Every item is already past its date. Before activating a collection in Maintainerr, restart its countdown so people get the full delay to vote. This changes deletion dates in Maintainerr. Click twice to confirm.";
                        color: Palette.muted;
                        wrap: word-wrap;
                    }
                    for c in root.admin-collections : HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: c.title; color: Palette.text; vertical-alignment: center; min-width: 200px; }
                        Button { label: "Today"; clicked => { root.admin-countdown(c.id, 0); } }
                        Button { label: "Spread over 14 days"; clicked => { root.admin-countdown(c.id, 14); } }
                        Button { label: "Spread over 30 days"; clicked => { root.admin-countdown(c.id, 30); } }
                    }
                    Text { text: "People"; color: Palette.text; font-size: 18px; }
                    for u in root.admin-users : Rectangle {
                        background: Palette.surface;
                        border-radius: 8px;
                        height: 92px;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;
                            Text { text: u.name + "  ·  " + u.detail; color: Palette.text; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Button { label: u.forever; clicked => { root.admin-rights(u.key, "forever"); } }
                                Button { label: u.max-forever; clicked => { root.admin-rights(u.key, "max-forever"); } }
                                Button { label: u.max-days; clicked => { root.admin-rights(u.key, "max-days"); } }
                            }
                        }
                    }
                }
            }

            if root.page == Page.settings : ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: start;
                    Text { text: "Accounts"; color: Palette.text; font-size: 20px; }
                    for a in root.accounts : HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            Text { text: a.label; color: Palette.text; }
                            Text { text: a.detail; color: Palette.muted; font-size: 12px; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if !a.current : Button { label: "Use"; clicked => { root.use-account(a.id); } }
                        if a.current : Text { text: "In use"; color: Palette.muted; vertical-alignment: center; }
                        Button { label: "Remove"; clicked => { root.remove-account(a.id); } }
                    }
                    HorizontalLayout { alignment: start; Button { label: "Add a server"; primary: true; clicked => { root.go(Page.add); } } }
                    Text { text: "Leaving soon (AlwyWatch server)"; color: Palette.text; font-size: 20px; }
                    if root.keep-active : HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Text { text: root.keep-label; color: Palette.text; vertical-alignment: center; }
                        Button { label: "Disconnect"; clicked => { root.keep-disconnect(); } }
                    }
                    if !root.keep-active : HorizontalLayout {
                        spacing: 10px;
                        kurl := LineEdit { placeholder-text: "AlwyWatch server address"; accepted(t) => { root.keep-connect(t); } }
                        Button { label: "Connect as this account"; clicked => { root.keep-connect(kurl.text); } }
                    }
                    Text { text: "Requests (Seerr)"; color: Palette.text; font-size: 20px; }
                    if root.seerr-active : HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Text { text: root.seerr-label; color: Palette.text; vertical-alignment: center; }
                        Button { label: "Disconnect"; clicked => { root.seerr-disconnect(); } }
                    }
                    if !root.seerr-active && root.seerr-step == "url" : HorizontalLayout {
                        spacing: 10px;
                        surl := LineEdit { placeholder-text: "Seerr address"; accepted(t) => { root.seerr-url(t); } }
                        Button { label: "Connect"; clicked => { root.seerr-url(surl.text); } }
                    }
                    if !root.seerr-active && root.seerr-step == "choose" : HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        for l in root.seerr-logins : Button { label: l.title; primary: true; clicked => { root.seerr-login(l.id); } }
                    }
                    if !root.seerr-active && root.seerr-step == "plex" : Text {
                        text: "Finish signing in to Plex in your browser…";
                        color: Palette.muted;
                    }
                    if !root.seerr-active && (root.seerr-step == "jellyfin" || root.seerr-step == "local") : VerticalLayout {
                        spacing: 8px;
                        if root.seerr-code != "" : Text { text: "Quick Connect code: " + root.seerr-code; color: Palette.text; font-size: 20px; }
                        su := LineEdit { placeholder-text: root.seerr-step == "local" ? "Email" : "Username"; }
                        sp := LineEdit { placeholder-text: "Password"; input-type: password; accepted => { root.seerr-password(su.text, sp.text); } }
                        HorizontalLayout { alignment: start; Button { label: "Sign in"; primary: true; clicked => { root.seerr-password(su.text, sp.text); } } }
                    }
                    if root.seerr-message != "" && root.page == Page.settings : Text { text: root.seerr-message; color: Palette.danger; }

                    Text { text: "Playback"; color: Palette.text; font-size: 20px; }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            label: "Audio passthrough (S/PDIF, HDMI receiver): " + (root.spdif ? "on" : "off");
                            clicked => { root.toggle-spdif(); }
                        }
                    }
                    Text { text: "Storage"; color: Palette.text; font-size: 20px; }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Text { text: "Image cache: " + root.cache-size; color: Palette.text; vertical-alignment: center; }
                        Button { label: "Clear"; clicked => { root.clear-cache(); } }
                    }
                    Text { text: root.about; color: Palette.muted; }
                }
            }
        }
    }
}
