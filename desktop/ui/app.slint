    in-out property <string> invite-note;
    in-out property <bool> invite-jellyfin: true;
    in-out property <int> invite-days: 7;
    in-out property <int> invite-uses: 1;
    in property <bool> invite-busy;
    in property <string> invite-sent-to;
    property <bool> invite-emailing: root.invite-mail && root.invite-email != "";
    in property <[InviteRow]> invites;
    in property <bool> invites-loaded;
    in property <string> invites-message;
