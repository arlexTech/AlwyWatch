// SPDX-License-Identifier: AGPL-3.0-or-later
// AlwyWatch desktop UI. Same design language as the Android app: Manrope, near-black with
// translucent surfaces, artwork-led pages, white pill for the main action.
import { ListView, ScrollView, Slider } from "std-widgets.slint";
import "fonts/Manrope.ttf";

export struct PlayerTrack {
    id: string,
    label: string,
    selected: bool,
}

export struct Card {
    id: string,
    title: string,
    subtitle: string,
    image: image,
    progress: float,
    played: bool,
    server: string, // "plex" | "jellyfin" where a screen mixes servers, else empty
}

export struct Rail {
    title: string,
    items: [Card],
    landscape: bool,
    /// What "See all" opens: "continue", "leaving", "lib:<library id>"; empty: no link.
    see-all: string,
}

export struct ServerChoice {
    id: string,
    title: string,
    subtitle: string,
    plex: bool,
}

export struct NamedId {
    id: string,
    title: string,
    selected: bool,
}

export struct Detail {
    id: string,
    title: string,
    meta: string,
    overview: string,
    genres: string,
    backdrop: image,
    poster: image,
    logo: image,
    playable: bool,
    resumable: bool,
    /// Where Resume starts, e.g. "9:12".
    resume-at: string,
    played: bool,
    is-series: bool,
    /// Movies and shows can go on "My list" (Plex watchlist, Jellyfin favorites).
    can-watchlist: bool,
    watchlisted: bool,
    has-trailer: bool,
    /// "Directed by …".
    crew: string,
    /// A movie's saga (TMDB collection, through Seerr): its id, and its button's label.
    saga-id: string,
    saga-label: string,
}

/// Where a title stands in Leaving soon, on its page.
export struct KeepPanel {
    /// The keep server is connected and the list was loaded at least once.
    shown: bool,
    /// Something is planned for it or someone keeps it (else: in no deletion list).
    listed: bool,
    /// Empty until the server was asked for the entry of a title in no list ("Keep it").
    key: string,
    /// Asking the server for that entry.
    looking: bool,
    /// Why it couldn't be found.
    error: string,
    /// "Kept forever", "Leaves in 12 days", "Not scheduled for deletion"…
    title: string,
    /// Muted line: which list, why nothing happens yet, who keeps it.
    detail: string,
    /// "You keep it forever", "You haven't chosen anything"…
    choice: string,
    voted: bool,
}

export struct AccountRow {
    id: string,
    label: string,
    detail: string,
    current: bool,
}

export struct DownloadRow {
    id: int,
    account: string,
    item: string,
    title: string,
    status: string,
    progress: float,
    completed: bool,
    active: bool,
}

export struct SeerrPanel {
    open: bool,
    key: string,
    title: string,
    overview: string,
    status: string,
    is-tv: bool,
    can-request: bool,
}

// A Seerr title page (or a saga's header).
export struct SeerrPage {
    key: string,
    title: string,
    meta: string,
    tagline: string,
    overview: string,
    genres: string,
    status: string,
    available: bool,
    saga-id: string,
    saga-name: string,
    backdrop: image,
    poster: image,
}

export struct LeavingRow {
    key: string,
    title: string,
    when: string,
    vote: string,
    others: string,
    poster: image,
    urgent: bool,
    voted: bool,
}

/// How to draw an AlwyWatch user: a picture (built-in avatar or uploaded), else the initial on a
/// colour.
export struct PersonAvatar {
    initial: string,
    color: color,
    picture: image,
    has-picture: bool,
}

/// A person in a list (room members and invited people, the people to invite).
export struct PersonRow {
    key: string,
    name: string,
    /// Second line ("Host · 2 devices", the server's name when two names are equal).
    detail: string,
    avatar: PersonAvatar,
    /// Shown above this row ("Recent", "Everyone").
    header: string,
    selected: bool,
}

/// A sign-in of my AlwyWatch account (Settings → Linked sign-ins).
export struct LinkRow {
    key: string, // user key
    title: string, // name on that media server
    detail: string, // "Server · Plex"
    server: string, // plex | jellyfin
    main: bool, // the account's data lives under it: no Unlink
    here: bool, // the sign-in this computer uses
}

/// An avatar to choose (Change avatar, welcome step); id "default" is the initial on a colour.
export struct PresetRow {
    id: string,
    avatar: PersonAvatar,
    selected: bool,
}

export struct TogetherRow {
    code: string,
    title: string,
    people: string,
    status: string,
    poster: image,
    mine: bool,
    /// An invitation (Join / Not now) rather than one of my rooms.
    invited: bool,
    host-avatar: PersonAvatar,
}

export struct ForeverRow {
    title: string,
    detail: string,
    // Share of this person's titles that someone else keeps too (0..1); -1 for titles.
    shared: float,
    avatar: PersonAvatar,
}

export struct AdminRow {
    key: string,
    name: string,
    avatar: PersonAvatar,
    detail: string,
    forever: string,
    max-forever: string,
    max-days: string,
    /// "Requests as …" ("" when the AlwyWatch server takes no requests).
    seerr: string,
    seerr-id: string, // "" = automatic
}

/// Settings → Admin → Server status: one line and what to do about it.
/// An invitation in Settings → Admin.
export struct InviteRow {
    id: string,
    /// The email it was sent to, or "Link".
    title: string,
    detail: string,
    /// Still works (can be ended).
    active: bool,
}

export struct StatusRow {
    title: string,
    text: string,
    ok: bool,
}

/// A profile of this computer (Settings → Profiles, and "Who's watching?" at start).
export struct ProfileRow {
    id: string,
    name: string,
    initial: string,
    /// Avatar colours (0 to 3), derived from the name.
    tone: int,
    has-pin: bool,
    current: bool,
    removable: bool,
}

/// An account to copy watch history from or to.
export struct AccountChoice {
    id: string,
    title: string,
    server: string, // plex | jellyfin
    selected: bool,
}

export enum Page { add, home, library, detail, search, mylist, settings, downloads, requests, seerrtitle, seerrsaga, leaving, triage, keepadmin, together, room, profiles, historycopy }

export global Palette {
    out property <color> bg: #09090c;
    out property <color> surface: #ffffff14;
    out property <color> surface-high: #ffffff24;
    out property <color> outline: #ffffff1f;
    out property <color> accent: #ffb224;
    out property <color> text: #f4f4f6;
    out property <color> muted: #f4f4f699;
    out property <color> subtle: #f4f4f666;
    out property <color> danger: #ff5a5f;
    out property <color> success: #3ddc97;
}

component Icon inherits Image {
    in property <color> tint: Palette.text;
    width: 22px;
    height: 22px;
    colorize: root.tint;
    image-fit: contain;
}

// A focusable, clickable surface: Enter/Space activate; focus and hover are always visible.
component Focusable inherits Rectangle {
    in property <bool> primary: false;
    /// Takes the keyboard when it appears (first tile of "Who's watching?").
    in property <bool> autofocus: false;
    out property <bool> active: fs.has-focus || ta.has-hover;
    callback clicked();
    /// Keyboard focus or mouse hover (prefetch, previews).
    callback focused();
    /// Keyboard focus only: rows scroll the card into view (not on hover, which nudged them).
    callback keyboard-focused();
    init => { if root.autofocus { fs.focus(); } }
    border-radius: 14px;
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-changed-event => {
            if (self.has-focus) {
                root.focused();
                root.keyboard-focused();
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            fs.focus();
            root.clicked();
        }
        changed has-hover => { if (self.has-hover) { root.focused(); } }
    }
    @children
}

// Pill button: primary = white with black text; secondary = glass. Focus/hover turn it white.
component Button inherits Focusable {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon: false;
    property <bool> light: root.primary || root.active;
    height: 40px;
    min-width: row.preferred-width + 36px;
    border-radius: 20px;
    background: root.light ? (root.primary && root.active ? #e6e6e6 : #ffffff) : Palette.surface-high;
    animate background { duration: 120ms; }
    row := HorizontalLayout {
        alignment: center;
        spacing: 8px;
        if root.has-icon : Icon { source: root.icon; tint: root.light ? #000 : Palette.text; width: 20px; height: 20px; y: (parent.height - self.height) / 2; }
        Text {
            text: root.label;
            color: root.light ? #000 : Palette.text;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

/** Big clickable card for the sign-in choices. */
component ChoiceCard inherits Focusable {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;
    min-height: 76px;
    border-radius: 20px;
    background: self.active ? Palette.surface-high : Palette.surface;
    border-width: 1px;
    border-color: Palette.outline;
    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        Rectangle {
            width: 44px;
            height: 44px;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: Palette.surface-high;
            Icon { source: root.icon; tint: Palette.accent; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.title; color: Palette.text; font-size: 17px; font-weight: 700; }
            Text { text: root.subtitle; color: Palette.muted; font-size: 13px; wrap: word-wrap; }
        }
        Icon { source: @image-url("icons/chevron_right.svg"); tint: Palette.subtle; y: (parent.height - self.height) / 2; }
    }
}

// The keep choices of a Leaving soon title (its row, and the title page's keep panel).
component KeepChoices inherits HorizontalLayout {
    in property <string> key;
    in property <bool> voted;
    callback vote(string, string); // key, choice
    spacing: 6px;
    alignment: start;
    Button { label: @tr("Until I watch it"); primary: true; has-icon: true; icon: @image-url("icons/schedule.svg"); clicked => { root.vote(root.key, "watched"); } }
    Button { label: @tr("Keep 30 days"); clicked => { root.vote(root.key, "days30"); } }
    Button { label: @tr("Keep 7 days"); clicked => { root.vote(root.key, "days7"); } }
    Button { label: @tr("Keep forever"); has-icon: true; icon: @image-url("icons/favorite.svg"); clicked => { root.vote(root.key, "love"); } }
    Button { label: @tr("Fine to delete"); clicked => { root.vote(root.key, "dontcare"); } }
    if root.voted : Button { label: @tr("Remove my choice"); clicked => { root.vote(root.key, "remove"); } }
}

component IconButton inherits Focusable {
    in property <image> icon;
    /// What the button does, shown under it while hovered or focused (an icon alone is a guess).
    in property <string> tip;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: root.active ? #ffffff : Palette.surface-high;
    Icon { source: root.icon; tint: root.active ? #000 : Palette.text; }
    if root.tip != "" && root.active : Rectangle {
        y: parent.height + 4px;
        x: (parent.width - self.width) / 2;
        width: tip-text.preferred-width + 16px;
        height: 24px;
        border-radius: 8px;
        background: #000000e0;
        tip-text := Text { text: root.tip; color: #fff; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    }
}

// Cast and crew: round photos with name and role, scrolling sideways.
// Round arrow at the end of a row (desktop: rows scroll sideways without a scrollbar).
component RailArrow inherits Rectangle {
    in property <bool> left;
    callback clicked;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: ta.has-hover ? #ffffffee : #000000aa;
    border-width: 1px;
    border-color: #ffffff33;
    Image {
        source: root.left ? @image-url("icons/chevron_left.svg") : @image-url("icons/chevron_right.svg");
        width: 26px;
        height: 26px;
        colorize: ta.has-hover ? #000 : #fff;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The in-window player's controls (the video is drawn under the window by mpv, see video.rs),
// laid out like the Android TV player: what plays top left, play/pause in the middle, the seek
// bar and the actions at the bottom. Shown while the mouse moves or playback is paused.
// Round button: white with a black icon under the mouse (like a focused button on TV).
component PlayerButton inherits Rectangle {
    in property <image> icon;
    in property <length> size: 56px;
    in property <bool> emphasized;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: ta.has-hover ? #ffffff : (root.emphasized ? #ffffff38 : transparent);
    Image { source: root.icon; width: root.size * 0.5; height: root.size * 0.5; colorize: ta.has-hover ? #000000 : #ffffff; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component PlayerPill inherits Rectangle {
    in property <string> label;
    in property <image> icon: @image-url("icons/skip_next.svg");
    in property <bool> has-icon: true;
    // White, like the pill that has the focus on TV (the floating "Skip intro").
    in property <bool> primary;
    callback clicked;
    property <bool> lit: root.primary || ta.has-hover;
    height: 42px;
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: 21px;
    background: root.lit ? #ffffff : #ffffff29;
    row := HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 9px;
        alignment: center;
        if root.has-icon : Image { source: root.icon; width: 20px; height: 20px; y: 11px; colorize: root.lit ? #000000 : #ffffff; }
        Text { text: root.label; color: root.lit ? #000000 : #ffffff; font-size: 15px; font-weight: 600; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// One track in the Audio & subtitles panel.
component TrackRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    height: 46px;
    border-radius: 10px;
    background: ta.has-hover ? #ffffff : (root.selected ? #ffffff1f : transparent);
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        Image {
            source: @image-url("icons/check.svg");
            width: 20px;
            height: 20px;
            y: 13px;
            colorize: ta.has-hover ? #000000 : (root.selected ? #ffffff : transparent);
        }
        Text {
            text: root.label;
            color: ta.has-hover ? #000000 : (root.selected ? #ffffff : #ffffffb8);
            font-size: 15px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component PlayerOverlay inherits Rectangle {
    in property <string> title;
    in property <int> pos;
    in property <int> dur;
    in property <int> cache;
    in property <bool> paused;
    in property <string> skip;
    in property <int> countdown;
    in property <string> note;
    in property <bool> has-next;
    in property <bool> has-previous;
    in property <bool> near-end;
    in property <string> ends-at;
    in property <[PlayerTrack]> audio;
    in property <[PlayerTrack]> subtitles;
    in property <bool> fullscreen;
    // Watching alone with an AlwyWatch server: "Watch together" opens a room for this title.
    in property <bool> can-together;
    // In a room: "3 watching" (invites more people).
    in property <string> room-label;
    /// (command, argument): see App::player_cmd.
    callback cmd(string, string);
    property <int> idle: 0;
    property <bool> tracks-open;
    property <bool> show: root.idle < 5 || root.paused || root.tracks-open || root.seeking || root.dur == 0;
    property <float> drag: 0;
    property <bool> seeking;
    property <length> side: 56px;

    pure function two(n: int) -> string { return (n < 10 ? "0" : "") + n; }
    pure function clock(ms: int) -> string {
        if (ms < 0) { return "0:00"; }
        return floor(ms / 3600000) > 0
            ? floor(ms / 3600000) + ":" + two(mod(floor(ms / 60000), 60)) + ":" + two(mod(floor(ms / 1000), 60))
            : floor(ms / 60000) + ":" + two(mod(floor(ms / 1000), 60));
    }

    init => { keys.focus(); }

    Timer {
        interval: 500ms;
        running: true;
        triggered => { root.idle += 1; }
    }

    keys := FocusScope {
        key-pressed(e) => {
            root.idle = 0;
            if (e.text == " " || e.text == "k") { root.cmd("pause", ""); return accept; }
            if (e.text == Key.LeftArrow) { root.cmd("rel", "-10"); return accept; }
            if (e.text == Key.RightArrow) { root.cmd("rel", "10"); return accept; }
            if (e.text == Key.UpArrow) { root.cmd("volume", "5"); return accept; }
            if (e.text == Key.DownArrow) { root.cmd("volume", "-5"); return accept; }
            if (e.text == "m") { root.cmd("mute", ""); return accept; }
            if (e.text == "f") { root.cmd("fullscreen", ""); return accept; }
            if (e.text == "s" && root.skip != "") { root.cmd("skip", ""); return accept; }
            if (e.text == "n" && root.has-next) { root.cmd("next", ""); return accept; }
            if (e.text == "c" && root.countdown > 0) { root.cmd("cancel", ""); return accept; }
            if (e.text == Key.Escape) {
                if (root.tracks-open) { root.tracks-open = false; return accept; }
                // Like Back on TV: first cancels the next episode countdown.
                if (root.countdown > 0) { root.cmd("cancel", ""); return accept; }
                if (root.fullscreen) { root.cmd("fullscreen", ""); return accept; }
                root.cmd("close", "");
                return accept;
            }
            return reject;
        }
    }

    // The picture itself: a click pauses, a double click toggles full screen.
    TouchArea {
        mouse-cursor: root.show ? MouseCursor.default : MouseCursor.none;
        changed mouse-x => { root.idle = 0; }
        changed mouse-y => { root.idle = 0; }
        clicked => {
            keys.focus();
            if (root.tracks-open) { root.tracks-open = false; } else { root.cmd("pause", ""); }
        }
        double-clicked => { root.cmd("fullscreen", ""); }
    }

    if root.show : Rectangle {
        background: @linear-gradient(180deg, #000000b3 0%, #00000000 25%, #00000000 60%, #000000d9 100%);
    }

    // Top: what plays on the left; full screen and close on the right.
    if root.show : HorizontalLayout {
        x: root.side;
        y: 36px;
        width: root.width - 2 * root.side;
        height: 48px;
        spacing: 12px;
        Text {
            text: root.title;
            color: #ffffff;
            font-size: 20px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        PlayerButton {
            size: 48px;
            icon: root.fullscreen ? @image-url("icons/fullscreen_exit.svg") : @image-url("icons/fullscreen.svg");
            clicked => { root.cmd("fullscreen", ""); }
        }
        PlayerButton { size: 48px; icon: @image-url("icons/close.svg"); clicked => { root.cmd("close", ""); } }
    }

    // Middle: previous, play/pause, next (an empty slot keeps play/pause centred).
    if root.show && root.dur > 0 : HorizontalLayout {
        x: 0;
        width: root.width;
        y: (root.height - 88px) / 2;
        height: 88px;
        spacing: 40px;
        alignment: center;
        if root.has-previous : PlayerButton { y: 14px; size: 60px; icon: @image-url("icons/skip_previous.svg"); clicked => { root.cmd("previous", ""); } }
        if !root.has-previous : Rectangle { width: 60px; }
        PlayerButton {
            size: 88px;
            emphasized: true;
            icon: root.paused ? @image-url("icons/play_arrow_fill1.svg") : @image-url("icons/pause.svg");
            clicked => { root.cmd("pause", ""); }
        }
        if root.has-next : PlayerButton { y: 14px; size: 60px; icon: @image-url("icons/skip_next.svg"); clicked => { root.cmd("next", ""); } }
        if !root.has-next : Rectangle { width: 60px; }
    }

    if root.dur == 0 : Text {
        text: @tr("Loading…");
        color: #ffffffb0;
        font-size: 18px;
    }

    // Bottom: seek bar, then the time on the left and the actions on the right.
    if root.show : bar := Rectangle {
        x: root.side;
        y: root.height - 36px - 42px - 12px - self.height;
        width: root.width - 2 * root.side;
        height: 32px;
        property <bool> hot: seek-ta.has-hover || seek-ta.pressed;
        property <float> frac: root.seeking ? root.drag : (root.dur > 0 ? root.pos / root.dur : 0);
        property <length> th: self.hot ? 8px : 5px;
        Rectangle { y: (parent.height - self.height) / 2; height: parent.th; border-radius: parent.th / 2; background: #ffffff33; }
        Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            height: parent.th;
            width: root.dur > 0 ? parent.width * min(1, root.cache / root.dur) : 0;
            border-radius: parent.th / 2;
            background: #ffffff4d;
        }
        Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            height: parent.th;
            width: max(parent.th, parent.width * parent.frac);
            border-radius: parent.th / 2;
            background: Palette.accent;
        }
        Rectangle {
            property <length> d: bar.hot ? 20px : 14px;
            x: bar.width * bar.frac - self.d / 2;
            y: (parent.height - self.d) / 2;
            width: self.d;
            height: self.d;
            border-radius: self.d / 2;
            background: #ffffff;
            border-width: bar.hot ? 3px : 0;
            border-color: Palette.accent;
        }
        if bar.hot && root.dur > 0 : Rectangle {
            property <float> at: root.seeking ? root.drag : max(0, min(1, seek-ta.mouse-x / bar.width));
            x: max(0, min(bar.width - self.width, bar.width * self.at - self.width / 2));
            y: -40px;
            width: tip.preferred-width + 20px;
            height: 30px;
            border-radius: 8px;
            background: #ffffff;
            tip := Text { text: root.clock(root.dur * parent.at); color: #000000; font-size: 14px; font-weight: 700; }
        }
        seek-ta := TouchArea {
            mouse-cursor: pointer;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.drag = max(0, min(1, self.mouse-x / self.width));
                    root.seeking = true;
                }
                if (e.kind == PointerEventKind.up) {
                    root.seeking = false;
                    root.cmd("seek", root.drag * root.dur / 1000);
                }
            }
            moved => {
                if (self.pressed) {
                    root.drag = max(0, min(1, self.mouse-x / self.width));
                    root.cmd("seek-drag", root.drag * root.dur / 1000);
                }
            }
        }
    }
    if root.show : HorizontalLayout {
        x: root.side;
        y: root.height - 36px - self.height;
        width: root.width - 2 * root.side;
        height: 42px;
        spacing: 10px;
        Text {
            text: root.clock(root.pos) + "  /  " + root.clock(root.dur);
            color: #ffffffb3;
            font-size: 15px;
            vertical-alignment: center;
        }
        if root.ends-at != "" && root.dur > 0 : Text {
            text: @tr("·  ends at {}", root.ends-at);
            color: #ffffff80;
            font-size: 15px;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        if root.room-label != "" : PlayerPill { label: root.room-label; icon: @image-url("icons/group.svg"); clicked => { root.cmd("room", ""); } }
        if root.room-label == "" && root.can-together : PlayerPill { label: @tr("Watch together"); icon: @image-url("icons/group.svg"); clicked => { root.cmd("together", ""); } }
        if root.audio.length > 1 || root.subtitles.length > 1 : PlayerPill {
            label: @tr("Audio & subtitles");
            icon: @image-url("icons/subtitles.svg");
            clicked => { root.tracks-open = true; }
        }
    }

    // "Skip intro" / "Next episode", bottom right: floating (white, as focused on TV) when the
    // controls hide, above the seek bar when they show. Same place on every platform.
    if !root.tracks-open && (root.near-end || root.skip != "") : HorizontalLayout {
        width: self.preferred-width;
        x: root.width - self.width - (root.show ? root.side : 48px);
        y: root.show ? root.height - 36px - 42px - 12px - 32px - 12px - 42px : root.height - 48px - 42px;
        height: 42px;
        spacing: 10px;
        if root.countdown > 0 : PlayerPill { label: @tr("Keep watching"); has-icon: false; clicked => { root.cmd("cancel", ""); } }
        if root.near-end : PlayerPill { primary: !root.show; label: root.countdown > 0 ? @tr("Next episode in {} s", root.countdown) : @tr("Next episode"); clicked => { root.cmd("next", ""); } }
        if !root.near-end : PlayerPill { primary: !root.show; label: root.skip; clicked => { root.cmd("skip", ""); } }
    }

    // Audio & subtitles: a panel on the right, like on TV. A click outside closes it.
    if root.tracks-open : TouchArea { clicked => { root.tracks-open = false; keys.focus(); } }
    if root.tracks-open : panel := Rectangle {
        x: root.width - self.width;
        width: 380px;
        height: root.height;
        background: #111116f2;
        TouchArea { }
        VerticalLayout {
            padding: 24px;
            spacing: 6px;
            HorizontalLayout {
                height: 44px;
                Text { text: @tr("Audio & subtitles"); color: #ffffff; font-size: 18px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                PlayerButton { size: 40px; icon: @image-url("icons/close.svg"); clicked => { root.tracks-open = false; keys.focus(); } }
            }
            Flickable {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    spacing: 4px;
                    Text { text: @tr("AUDIO"); color: #ffffff80; font-size: 12px; font-weight: 700; height: 36px; vertical-alignment: bottom; }
                    for t in root.audio : TrackRow {
                        label: t.label;
                        selected: t.selected;
                        clicked => { root.cmd("aid", t.id); }
                    }
                    Text { text: @tr("SUBTITLES"); color: #ffffff80; font-size: 12px; font-weight: 700; height: 44px; vertical-alignment: bottom; }
                    for t in root.subtitles : TrackRow {
                        label: t.label;
                        selected: t.selected;
                        clicked => { root.cmd("sid", t.id); }
                    }
                }
            }
        }
    }

    // Short messages ("Sam paused"), top centre.
    if root.note != "" : Rectangle {
        x: (root.width - self.width) / 2;
        y: root.show ? 100px : 32px;
        width: min(root.width - 64px, nt.preferred-width + 48px);
        height: 46px;
        border-radius: 23px;
        background: #181818e8;
        nt := Text { text: root.note; color: #ffffff; font-size: 15px; overflow: elide; }
    }
}

// Like the rows: no scrollbar, arrows at the ends when there are more people.
component CastRow inherits Rectangle {
    in property <[Card]> people;
    height: 150px;
    sv := Flickable {
        content-width: root.people.length * 104px;
        animate content-x { duration: 250ms; easing: ease-in-out; }
        for c[i] in root.people : VerticalLayout {
            x: i * 104px;
            width: 92px;
            spacing: 4px;
            Rectangle {
                width: 76px;
                height: 76px;
                border-radius: 38px;
                clip: true;
                background: Palette.surface;
                Image { source: c.image; width: parent.width; height: parent.height; image-fit: cover; }
            }
            Text { text: c.title; color: Palette.text; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; max-height: 32px; overflow: elide; }
            Text { text: c.subtitle; color: Palette.muted; font-size: 11px; horizontal-alignment: center; overflow: elide; }
        }
    }
    if sv.content-x < 0 : RailArrow {
        x: 0;
        y: 16px;
        left: true;
        clicked => { sv.content-x = min(0, sv.content-x + max(104px, sv.width - 104px)); }
    }
    if sv.content-x + sv.content-width > sv.width + 1px : RailArrow {
        x: parent.width - self.width;
        y: 16px;
        clicked => { sv.content-x = max(sv.width - sv.content-width, sv.content-x - max(104px, sv.width - 104px)); }
    }
}

component NavItem inherits Focusable {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    height: 44px;
    border-radius: 22px;
    background: root.active ? #ffffff : (root.selected ? Palette.surface-high : transparent);
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 14px;
        Icon {
            source: root.icon;
            tint: root.active ? #000 : (root.selected ? Palette.text : Palette.muted);
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.label;
            color: root.active ? #000 : (root.selected ? Palette.text : Palette.muted);
            font-size: 15px;
            font-weight: root.selected ? 700 : 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 2px;
    Text { text: root.title; color: Palette.text; font-size: 34px; font-weight: 800; letter-spacing: -0.5px; }
    if root.subtitle != "" : Text { text: root.subtitle; color: Palette.muted; font-size: 15px; }
}

// Rounded text field (bare TextInput: no inner widget box).
component Field inherits Rectangle {
    in-out property <string> text <=> ti.text;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    /// Takes the keyboard when it appears (the search page: type at once).
    in property <bool> autofocus;
    callback accepted(string);
    callback edited(string);
    init => { if root.autofocus { ti.focus(); } }
    height: 48px;
    border-radius: 24px;
    background: Palette.surface;
    border-width: ti.has-focus ? 2px : 1px;
    border-color: ti.has-focus ? #ffffff : Palette.outline;
    TouchArea { mouse-cursor: MouseCursor.text; clicked => { ti.focus(); } }
    if ti.text == "" : Text {
        x: 20px;
        text: root.placeholder;
        color: Palette.subtle;
        font-size: 15px;
        vertical-alignment: center;
    }
    ti := TextInput {
        x: 20px;
        width: parent.width - 40px;
        color: Palette.text;
        font-size: 15px;
        vertical-alignment: center;
        single-line: true;
        input-type: root.input-type;
        selection-background-color: #ffb22466;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
    }
}

component Badge inherits Rectangle {
    in property <string> label;
    in property <color> tone: #000000a0;
    in property <color> fg: #ffffff;
    height: 22px;
    width: t.preferred-width + 14px;
    border-radius: 6px;
    background: root.tone;
    t := Text { text: root.label; color: root.fg; font-size: 11px; font-weight: 800; letter-spacing: 0.6px; }
}

component Progress inherits Rectangle {
    in property <float> value;
    height: 4px;
    border-radius: 2px;
    background: #ffffff40;
    Rectangle { x: 0; width: parent.width * root.value; border-radius: 2px; background: Palette.accent; }
}

// Which server a card is from: a chevron in Plex's yellow, a triangle in Jellyfin's purple to
// blue (simple shapes, not the brands' logo files; same marks as Android).
component ServerMark inherits Rectangle {
    in property <string> server;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: #000000b8;
    if root.server == "plex" : Path {
        x: 5px; y: 5px; width: 12px; height: 12px;
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 22 0 L 52 0 L 86 50 L 52 100 L 22 100 L 56 50 Z";
        fill: #e5a00d;
    }
    if root.server == "jellyfin" : Path {
        x: 5px; y: 5px; width: 12px; height: 12px;
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 50 0 L 100 100 L 0 100 Z M 50 42 L 28 86 L 72 86 Z";
        fill: @linear-gradient(135deg, #aa5cc3 0%, #00a4dc 100%);
    }
}

component PosterCard inherits Focusable {
    in property <Card> card;
    width: 160px;
    height: 292px;
    background: transparent;
    VerticalLayout {
        spacing: 8px;
        Rectangle {
            height: 240px;
            border-radius: 14px;
            clip: true;
            background: Palette.surface;
            border-width: root.active ? 3px : 0px;
            border-color: #ffffff;
            Image { source: root.card.image; width: parent.width; height: parent.height; image-fit: cover; }
            if root.card.progress > 0 : Progress { x: 8px; y: parent.height - 12px; width: parent.width - 16px; value: root.card.progress; }
            if root.card.played : Rectangle {
                x: parent.width - 30px;
                y: 8px;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: #000000a0;
                Icon { source: @image-url("icons/check.svg"); tint: Palette.accent; width: 15px; height: 15px; }
            }
            if root.card.server != "" : ServerMark { x: 8px; y: 8px; server: root.card.server; }
        }
        Text { text: root.card.title; color: Palette.text; overflow: elide; font-size: 14px; font-weight: 700; }
        Text { text: root.card.subtitle; color: Palette.muted; overflow: elide; font-size: 12px; }
    }
}

// 16:9 card for "Continue watching": still, title, time, progress.
component LandscapeCard inherits Focusable {
    in property <Card> card;
    width: 300px;
    height: 169px;
    clip: true;
    background: Palette.surface;
    border-width: root.active ? 3px : 0px;
    border-color: #ffffff;
    Image { source: root.card.image; width: parent.width; height: parent.height; image-fit: cover; }
    Rectangle { background: @linear-gradient(180deg, #00000000 45%, #000000c0 100%); }
    if root.card.server != "" : ServerMark { x: 8px; y: 8px; server: root.card.server; }
    VerticalLayout {
        padding: 12px;
        spacing: 2px;
        alignment: end;
        Text { text: root.card.title; color: Palette.text; overflow: elide; font-size: 15px; font-weight: 700; }
        Text { text: root.card.subtitle; color: Palette.muted; overflow: elide; font-size: 12px; }
        if root.card.progress > 0 : Rectangle { height: 8px; }
        if root.card.progress > 0 : Progress { value: root.card.progress; }
    }
}

component RailView {
    in property <Rail> rail;
    property <length> step: root.rail.landscape ? 316px : 176px;
    property <length> h: root.rail.landscape ? 181px : 304px;
    callback open(string);
    callback hovered(string);
    callback see-all(string);
    VerticalLayout {
        spacing: 10px;
        HorizontalLayout {
            spacing: 14px;
            Text { text: root.rail.title; color: Palette.text; font-size: 20px; font-weight: 700; vertical-alignment: center; }
            if root.rail.see-all != "" : Rectangle {
                width: sa-row.preferred-width;
                height: 30px;
                border-radius: 15px;
                background: sa-ta.has-hover || sa-fs.has-focus ? Palette.surface-high : transparent;
                sa-row := HorizontalLayout {
                    alignment: start;
                    padding-left: 10px;
                    padding-right: 4px;
                    spacing: 2px;
                    Text { text: @tr("See all"); color: sa-ta.has-hover || sa-fs.has-focus ? Palette.text : Palette.muted; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                    Image { source: @image-url("icons/chevron_right.svg"); width: 18px; height: 18px; y: 6px; colorize: sa-ta.has-hover || sa-fs.has-focus ? Palette.text : Palette.muted; }
                }
                sa-fs := FocusScope {
                    key-pressed(e) => {
                        if (e.text == Key.Return || e.text == " ") { root.see-all(root.rail.see-all); return accept; }
                        return reject;
                    }
                }
                sa-ta := TouchArea { mouse-cursor: pointer; clicked => { root.see-all(root.rail.see-all); } }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle {
            height: root.h + 8px;
            // No scrollbar (it covered the second line under the cards): the wheel or trackpad
            // scrolls, and an arrow at each end moves a screen's worth when there is more.
            sv := Flickable {
                content-width: root.rail.items.length * root.step + 12px;
                content-height: root.h + 4px;
                animate content-x { duration: 250ms; easing: ease-in-out; }
                for c[i] in root.rail.items : Rectangle {
                    x: i * root.step + 4px;
                    y: 4px;
                    width: root.step - 16px;
                    height: root.h;
                    if root.rail.landscape : LandscapeCard {
                        card: c;
                        clicked => { root.open(c.id); }
                        focused => { root.hovered(c.id); }
                        keyboard-focused => {
                            if (parent.x + sv.content-x < 0) { sv.content-x = -parent.x + 4px; }
                            if (parent.x + parent.width + sv.content-x > sv.width) { sv.content-x = sv.width - parent.x - parent.width - 4px; }
                        }
                    }
                    if !root.rail.landscape : PosterCard {
                        card: c;
                        clicked => { root.open(c.id); }
                        focused => { root.hovered(c.id); }
                        keyboard-focused => {
                            if (parent.x + sv.content-x < 0) { sv.content-x = -parent.x + 4px; }
                            if (parent.x + parent.width + sv.content-x > sv.width) { sv.content-x = sv.width - parent.x - parent.width - 4px; }
                        }
                    }
                }
            }
            if sv.content-x < 0 : RailArrow {
                x: 0;
                y: (root.h - self.height) / 2;
                left: true;
                clicked => { sv.content-x = min(0, sv.content-x + root.page-step(sv.width)); }
            }
            if sv.content-x + sv.content-width > sv.width + 1px : RailArrow {
                x: parent.width - self.width;
                y: (root.h - self.height) / 2;
                clicked => { sv.content-x = max(sv.width - sv.content-width, sv.content-x - root.page-step(sv.width)); }
            }
        }
    }
    // A screen's worth of whole cards, keeping one card of the previous screen in sight.
    pure function page-step(w: length) -> length {
        return max(1, floor(w / root.step) - 1) * root.step;
    }
}

// Round initial with colours derived from the name (same palette as Android).
component Avatar inherits Rectangle {
    in property <string> initial;
    in property <int> tone;
    in property <length> size: 40px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.tone == 1 ? @linear-gradient(135deg, #5b8cff 0%, #9b5bff 100%)
        : root.tone == 2 ? @linear-gradient(135deg, #3ddc97 0%, #14a3c7 100%)
        : root.tone == 3 ? @linear-gradient(135deg, #ff5a8a 0%, #ff9f5a 100%)
        : @linear-gradient(135deg, #ffb224 0%, #ff6a3d 100%);
    Text { text: root.initial; color: #000; font-size: root.size * 0.42; font-weight: 800; }
}

// An AlwyWatch user (not to be confused with this computer's profiles above): their picture, else
// their initial in white on their colour.
component UserAvatar inherits Rectangle {
    in property <PersonAvatar> avatar;
    in property <length> size: 40px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    clip: true;
    background: root.avatar.has-picture ? transparent : root.avatar.color;
    if !root.avatar.has-picture : Text {
        text: root.avatar.initial;
        color: #ffffff;
        font-size: root.size * 0.44;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.avatar.has-picture : Image { source: root.avatar.picture; width: parent.width; height: parent.height; image-fit: cover; }
}

// Avatar, name and a second line.
component PersonLine inherits HorizontalLayout {
    in property <PersonRow> person;
    in property <length> size: 40px;
    spacing: 12px;
    UserAvatar { avatar: root.person.avatar; size: root.size; y: (parent.height - self.height) / 2; }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text { text: root.person.name; color: Palette.text; font-weight: 700; overflow: elide; }
        if root.person.detail != "" : Text { text: root.person.detail; color: Palette.muted; font-size: 12px; overflow: elide; }
    }
}

// A grid of avatars to choose from (7 per row), the chosen one ringed.
component AvatarGrid inherits Rectangle {
    in property <[PresetRow]> presets;
    property <int> cols: 7;
    property <length> step: 74px;
    callback picked(string);
    width: root.cols * root.step;
    height: ceil(root.presets.length / root.cols) * root.step;
    for p[i] in root.presets : Focusable {
        x: mod(i, root.cols) * root.step;
        y: floor(i / root.cols) * root.step;
        width: root.step - 6px;
        height: root.step - 6px;
        border-radius: (root.step - 6px) / 2;
        background: transparent;
        border-width: self.active ? 3px : (p.selected ? 3px : 0px);
        border-color: self.active ? #ffffff : Palette.accent;
        clicked => { root.picked(p.id); }
        UserAvatar { avatar: p.avatar; size: parent.width - 12px; }
    }
}

// "Who's watching?": the whole tile (avatar and name) is the target.
component ProfileTile inherits Focusable {
    in property <ProfileRow> profile;
    width: 150px;
    height: 190px;
    border-radius: 20px;
    background: root.active ? Palette.surface-high : transparent;
    border-width: root.active ? 2px : 0px;
    border-color: #ffffff;
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        alignment: center;
        HorizontalLayout { alignment: center; Avatar { initial: root.profile.initial; tone: root.profile.tone; size: 96px; } }
        Text { text: root.profile.name; color: Palette.text; font-size: 16px; font-weight: 700; horizontal-alignment: center; overflow: elide; }
        Text { text: root.profile.has-pin ? @tr("PIN") : " "; color: Palette.muted; font-size: 11px; font-weight: 800; horizontal-alignment: center; }
    }
}

// One account in a "From" / "To" list: its server mark, its name, a check when chosen.
component AccountChoiceRow inherits Focusable {
    in property <AccountChoice> choice;
    height: 48px;
    border-radius: 12px;
    background: root.active ? Palette.surface-high : (root.choice.selected ? #ffb2241f : transparent);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        ServerMark { server: root.choice.server; y: (parent.height - self.height) / 2; }
        Text { text: root.choice.title; color: root.choice.selected ? Palette.accent : Palette.text; font-weight: root.choice.selected ? 700 : 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        if root.choice.selected : Icon { source: @image-url("icons/check.svg"); tint: Palette.accent; y: (parent.height - self.height) / 2; }
    }
}

// Grouped settings card.
component Group inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    if root.title != "" : Text { text: root.title; color: Palette.subtle; font-size: 11px; font-weight: 800; letter-spacing: 1px; }
    Rectangle {
        border-radius: 18px;
        background: Palette.surface;
        border-width: 1px;
        border-color: Palette.outline;
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            @children
        }
    }
}

/// A labelled on/off switch row (settings).
component SettingToggle inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> on;
    callback clicked();
    VerticalLayout {
        alignment: center;
        Text { text: root.title; color: Palette.text; font-weight: 700; }
        if root.subtitle != "" : Text { text: root.subtitle; color: Palette.muted; font-size: 12px; }
    }
    Rectangle { horizontal-stretch: 1; }
    Focusable {
        width: 48px;
        height: 28px;
        border-radius: 14px;
        background: root.on ? Palette.accent : Palette.surface-high;
        y: (parent.height - self.height) / 2;
        clicked => { root.clicked(); }
        Rectangle {
            x: root.on ? parent.width - 24px : 4px;
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: #ffffff;
            animate x { duration: 150ms; }
        }
    }
}

/// A setting with a few choices: the current one on a button, a click takes the next.
component SettingChoice inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <string> value;
    callback clicked();
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        Text { text: root.title; color: Palette.text; font-weight: 700; }
        if root.subtitle != "" : Text { text: root.subtitle; color: Palette.muted; font-size: 12px; }
    }
    Rectangle { horizontal-stretch: 1; }
    Button { label: root.value; y: (parent.height - self.height) / 2; clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    title: "AlwyWatch";
    preferred-width: 1280px;
    preferred-height: 800px;
    // Black under the video while playing (mpv draws before Slint).
    background: root.player-on ? #000000 : Palette.bg;
    default-font-size: 15px;
    default-font-family: "Manrope";

    in-out property <Page> page: Page.home;
    in property <string> status;
    in property <string> error;
    in property <bool> can-go-back;
    // Home
    in property <[Rail]> rails;
    in property <[NamedId]> libraries;
    // Library / search grid
    in property <string> grid-title;
    in property <[Card]> grid;
    in property <[NamedId]> sorts;
    in property <string> library-id;
    // Library page tab: recommended | browse | collections | categories; empty on a genre or
    // collection page.
    in property <string> library-tab;
    in property <[Rail]> lib-rails;
    in property <[NamedId]> genres;
    // Detail
    in property <Detail> detail;
    in property <[NamedId]> seasons;
    in property <[Card]> episodes;
    // Add server
    in property <string> add-step: "choose"; // choose | jellyfin-url | jellyfin | plex | plex-servers | receive
    // Device transfer. New device: the code to type elsewhere and the check number.
    in-out property <string> keep-address; // typed at the AlwyWatch server step
    in property <string> transfer-code;
    in property <string> transfer-check;
    in property <string> transfer-status;
    in property <image> transfer-qr;
    // The Quick Connect page the QR code opens (shown without "https://").
    in property <string> transfer-url;
    // Signed in to an AlwyWatch account (no media server yet): said above the server list.
    in property <string> account-note;
    // Signed-in device, "Add a device": "" | code | confirm | sent.
    in property <string> send-step;
    in property <string> send-code;
    in property <string> send-device;
    in property <string> send-check;
    in property <string> send-error;
    in property <string> quick-code;
    in property <string> plex-code;
    in property <[NamedId]> plex-servers;
    // Settings
    in property <[AccountRow]> accounts;
