    in property <PersonRow> link-b;
    in property <bool> link-prompted; // the one-time prompt: "Not now" (else "Cancel")
    in property <bool> link-busy;
    in property <string> link-message;
    in property <string> unlink-question;
    // Cropper of an uploaded picture: the picture's place under the round frame (viewport
    // 360 px, frame 300 px).
    in property <bool> crop-open;
    in property <image> crop-mask;
    in property <image> crop-image;
    in property <length> crop-x;
    in property <length> crop-y;
    in property <length> crop-w;
    in property <length> crop-h;
    in-out property <float> crop-zoom: 1;
    in property <float> crop-zoom-max: 4;
    in property <bool> crop-busy;
    in property <string> crop-message;
    in-out property <string> leaving-open;
