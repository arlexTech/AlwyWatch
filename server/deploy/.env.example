# Copy to .env next to docker-compose.yml, then: chmod 600 .env
# Every line is optional. Leave a value empty to turn that feature off.

# This site's public address (https://, host only, no path). Turns on passkeys and clickable
# invitation links, and is required for Pocket ID.
ALWYWATCH_PUBLIC_URL=

# Who may create an AlwyWatch account without a Jellyfin/Plex login:
# invite (default: with an invitation from an admin), open (anyone), closed (nobody).
ALWYWATCH_REGISTRATION=invite

# "Keep until I have watched it" is released automatically:
# for Jellyfin users with a Jellyfin API key (Dashboard → API Keys),
JELLYFIN_API_KEY=
# for Plex users with Tautulli's (Settings → Web Interface → API key; also needs [tautulli]
# in config.toml).
TAUTULLI_API_KEY=

# Only if you turned on an API key in Maintainerr's settings.
MAINTAINERR_API_KEY=

# Requests in the web app and for users of the media server type your Seerr isn't set up for
# (Seerr → Settings → General → API Key; also needs [seerr] in config.toml).
SEERR_API_KEY=

# Lets Tautulli/Jellyfin tell the server at once that something was watched (docs/deploy.md
# "Webhooks"). Any long random string: openssl rand -hex 32
WEBHOOK_SECRET=

# Single sign-on with Pocket ID (needs ALWYWATCH_PUBLIC_URL). In Pocket ID, create an OIDC
# client with the callback <ALWYWATCH_PUBLIC_URL>/v1/account/oidc/callback.
ALWYWATCH_POCKETID_ISSUER=
ALWYWATCH_POCKETID_CLIENT_ID=
ALWYWATCH_POCKETID_CLIENT_SECRET=

# 1 = read everything, change nothing in Maintainerr or Seerr (first start, see the guide).
ALWYWATCH_DRY_RUN=
